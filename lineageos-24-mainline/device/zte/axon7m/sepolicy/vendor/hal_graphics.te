# minigbm allocator and drm_hwcomposer (dragonboard and cuttlefish rules)
allow hal_graphics_allocator_default gpu_device:dir r_dir_perms;
allow hal_graphics_allocator_default gpu_device:chr_file rw_file_perms;
allow hal_graphics_allocator_default sysfs_gpu:file r_file_perms;
allow hal_graphics_allocator_default graphics_device:chr_file rw_file_perms;
allow hal_graphics_allocator_default dmabuf_system_heap_device:chr_file r_file_perms;

allow hal_graphics_composer_default gpu_device:dir r_dir_perms;
allow hal_graphics_composer_default gpu_device:chr_file rw_file_perms;
allow hal_graphics_composer_default sysfs_gpu:file r_file_perms;
allow hal_graphics_composer_default graphics_device:dir r_dir_perms;
allow hal_graphics_composer_default graphics_device:chr_file rw_file_perms;
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket { bind create read setopt getopt };
allow hal_graphics_composer_default hal_graphics_mapper_service:service_manager find;
allow hal_graphics_composer_default sysfs_leds:dir r_dir_perms;
allow hal_graphics_composer_default sysfs_leds:file rw_file_perms;
# /sys/class/backlight is walked to find the panel's brightness node
allow hal_graphics_composer_default sysfs:dir r_dir_perms;
# minigbm's mapper is a separate HAL service that the composer looks up
allow hal_graphics_composer_default hal_graphics_allocator_service:service_manager find;
binder_call(hal_graphics_composer_default, hal_graphics_allocator_default)
dontaudit hal_graphics_composer_default default_prop:file read;
