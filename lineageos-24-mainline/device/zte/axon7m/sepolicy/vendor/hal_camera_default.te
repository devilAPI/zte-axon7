# camera HAL module camera.axon7m (torch only): the flash LED in sysfs
allow hal_camera_default sysfs_leds:dir r_dir_perms;
allow hal_camera_default sysfs_leds:file rw_file_perms;
allow hal_camera_default sysfs_leds:lnk_file read;
# libcamera: media controller, CAMSS video nodes and sensor sub-devices,
# dma-buf heap for the HAL's internal buffers, its IPA proxy (isolated IPA)
allow hal_camera_default video_device:chr_file rw_file_perms;
allow hal_camera_default video_device:dir r_dir_perms;
allow hal_camera_default dmabuf_system_heap_device:chr_file r_file_perms;
allow hal_camera_default sysfs:dir r_dir_perms;
allow hal_camera_default sysfs:file r_file_perms;
# libcamera's isolated soft ISP creates a user namespace for its IPA and
# passes the statistics/parameter blocks as memfd (labelled tmpfs here)
allow hal_camera_default self:user_namespace create;
allow hal_camera_default self:cap_userns sys_admin;
allow hal_camera_default tmpfs:file { read write map getattr };

# libcamera runs its unsigned soft ISP IPA isolated in a child process
type axon7m_libcamera_ipa, domain;
type axon7m_libcamera_ipa_exec, exec_type, vendor_file_type, file_type;
domain_auto_trans(hal_camera_default, axon7m_libcamera_ipa_exec, axon7m_libcamera_ipa)
allow axon7m_libcamera_ipa hal_camera_default:fd use;
allow axon7m_libcamera_ipa hal_camera_default:unix_stream_socket { read write getattr };
allow axon7m_libcamera_ipa hal_camera_default:unix_dgram_socket { read write getattr };
allow axon7m_libcamera_ipa self:unix_dgram_socket create_socket_perms_no_ioctl;
allow axon7m_libcamera_ipa vendor_file:dir r_dir_perms;
allow axon7m_libcamera_ipa vendor_file:file r_file_perms;
allow axon7m_libcamera_ipa vendor_configs_file:dir r_dir_perms;
allow axon7m_libcamera_ipa vendor_configs_file:file r_file_perms;
allow axon7m_libcamera_ipa dmabuf_system_heap_device:chr_file r_file_perms;
