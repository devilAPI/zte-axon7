# fstab: modem and vendor partitions with context=firmware_file, persist
# with context=axon7m_persist_file, mounted on /mnt/vendor/*
allow init mnt_vendor_file:dir mounton;
allow init { firmware_file axon7m_persist_file }:filesystem { mount unmount relabelfrom relabelto associate };
# init.rc: zram compression algorithm, UFS discard setting and swapon on zram0
allow init { sysfs_axon7m_zram sysfs_axon7m_ufshc }:file w_file_perms;
allow init ram_device:blk_file write;
