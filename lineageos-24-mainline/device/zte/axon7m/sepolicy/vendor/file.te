# Firmware partitions mounted under /vendor (modem's vfat as firmware_mnt).
# Qualcomm's vendor policy (device/qcom/sepolicy_vndr) defines this type, but
# the mainline port does not include that policy.
type firmware_file, file_type, contextmount_type, vendor_file_type;

# The redistributable firmware files in /vendor/firmware (AXON7_FIRMWARE=phone)
# are read by request_firmware(), never by apps.
type axon7m_vendor_fw_file, file_type, vendor_file_type;

# /dev/block/by-name/persist (Qualcomm's type, as for firmware_file)
type persist_block_device, dev_type;

# modem EFS partitions (rmtfs reads them; rmtfs runs with -r) and rmtfs memory
type axon7m_modem_block_device, dev_type;
type axon7m_rmtfs_device, dev_type;
# sysfs: SLPI sensor manager IIO devices, rmtfs memory, modem remoteproc
type sysfs_axon7m_iio, fs_type, sysfs_type;
type sysfs_axon7m_rmtfs, fs_type, sysfs_type;
type sysfs_axon7m_mss, fs_type, sysfs_type;
# init writes these two at boot (zram algorithm, UFS discard setting), and
# axon7m-modules.sh triggers a PCI rescan for Wi-Fi
type sysfs_axon7m_zram, fs_type, sysfs_type;
type sysfs_axon7m_ufshc, fs_type, sysfs_type;
type sysfs_axon7m_pci, fs_type, sysfs_type;
# eMMC statistics read by storaged, UFS partition nodes read by fsck/mkfs,
# and /sys/kernel/mm/ksm read by system_server: the platform has no labels
# for these nodes on a mainline kernel.
type sysfs_axon7m_diskstat, fs_type, sysfs_type;
type sysfs_axon7m_block, fs_type, sysfs_type;
type sysfs_axon7m_ksm, fs_type, sysfs_type;

# persist (read-only, sns.reg for the sensor registry) and the registry the
# SLPI reads from /data/vendor/sensors
type axon7m_persist_file, file_type, contextmount_type, vendor_file_type;
type axon7m_sensors_data_file, file_type, data_file_type;
# /dev/rfkill (Bluetooth HAL net_bluetooth_mgmt)
type axon7m_rfkill_device, dev_type;
type sysfs_axon7m_btuart, fs_type, sysfs_type;
