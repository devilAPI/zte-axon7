/vendor/bin/hw/android\.hardware\.camera\.provider-service\.lineage  u:object_r:hal_camera_default_exec:s0
/vendor/bin/hw/android\.hardware\.radio-service\.axon7m      u:object_r:hal_radio_default_exec:s0
