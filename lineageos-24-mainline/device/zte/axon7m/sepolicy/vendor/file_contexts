# Block devices of LineageOS 22.2's multi-boot slot, used by LineageOS 24
# (PLAN.md section 5): GPT "system" is the super device
/dev/block/platform/soc@0/624000\.ufshc/by-name/system   u:object_r:super_block_device:s0
/dev/block/platform/soc@0/624000\.ufshc/by-name/los_metadata    u:object_r:metadata_block_device:s0
/dev/block/platform/soc@0/624000\.ufshc/by-name/los_data    u:object_r:userdata_block_device:s0
/dev/block/platform/soc@0/624000\.ufshc/by-name/misc        u:object_r:misc_block_device:s0
/dev/block/by-name/system                                u:object_r:super_block_device:s0
/dev/block/by-name/los_metadata                                 u:object_r:metadata_block_device:s0
/dev/block/by-name/los_data                                 u:object_r:userdata_block_device:s0
/vendor/firmware_mnt(/.*)?                                  u:object_r:firmware_file:s0
/dev/block/platform/soc@0/624000\.ufshc/by-name/persist     u:object_r:persist_block_device:s0
/dev/block/by-name/persist                                  u:object_r:persist_block_device:s0
/vendor/bin/axon7m-bdaddr\.sh                               u:object_r:vendor_bdaddr_exec:s0
/vendor/bin/hw/bdaddr                                       u:object_r:vendor_bdaddr_exec:s0
/vendor/bin/axon7m-modules\.sh                              u:object_r:vendor_toolbox_exec:s0
/vendor/bin/axon7m-bootguard\.sh                            u:object_r:vendor_toolbox_exec:s0
/vendor/bin/hw/android\.hardware\.vibrator-service\.axon7m  u:object_r:hal_vibrator_default_exec:s0
/vendor/bin/hw/android\.hardware\.gnss-service\.axon7m      u:object_r:hal_gnss_default_exec:s0
# request_firmware() files copied from the phone's vendor partition: readable
# by the kernel, not by apps
/vendor/firmware(/.*)?                                  u:object_r:axon7m_vendor_fw_file:s0
# shell utilities called by the vendor init scripts (no domain transition)
/vendor/bin/tinymix                                     u:object_r:vendor_toolbox_exec:s0
/vendor/bin/awk                                         u:object_r:vendor_toolbox_exec:s0
# GPU and display (as dragonboard): render node for every GL client, card0
# for the composer
/dev/dri                                                    u:object_r:gpu_device:s0
/dev/dri/renderD128                                         u:object_r:gpu_device:s0
/dev/dri/card0                                              u:object_r:graphics_device:s0
# minigbm (as cuttlefish): mapper and its libraries load into every app
/vendor/bin/hw/android\.hardware\.graphics\.allocator-service\.minigbm  u:object_r:hal_graphics_allocator_default_exec:s0
/vendor/lib(64)?/hw/mapper\.minigbm\.so                     u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libminigbm_gralloc\.so                     u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libminigbm_gralloc4_utils\.so              u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libgallium_dri\.so                         u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libdrm\.so                                 u:object_r:same_process_hal_file:s0
/vendor/bin/hw/android\.hardware\.sensors-service\.axon7m   u:object_r:hal_sensors_default_exec:s0
# modem: rmtfs serves the EFS partitions (read-only, -r), modem-online
/vendor/bin/rmtfs                                           u:object_r:axon7m_rmtfs_exec:s0
/vendor/bin/axon7m-modem-online                             u:object_r:axon7m_modem_online_exec:s0
/dev/qcom_rmtfs_mem1                                        u:object_r:axon7m_rmtfs_device:s0
/dev/block/platform/soc@0/624000\.ufshc/by-name/(modemst1|modemst2|fsg|fsc)  u:object_r:axon7m_modem_block_device:s0
/dev/block/by-name/(modemst1|modemst2|fsg|fsc)              u:object_r:axon7m_modem_block_device:s0
# init services in the vendor_modprobe domain (shell scripts, as axon7m-modules.sh)
/vendor/bin/axon7m-audio-routes\.sh                         u:object_r:vendor_toolbox_exec:s0
/vendor/bin/axon7m-sns-reg\.sh                              u:object_r:axon7m_sns_reg_exec:s0
/vendor/bin/axon7m-slpi-kick\.sh                            u:object_r:vendor_toolbox_exec:s0
/data/vendor/sensors(/.*)?                                  u:object_r:axon7m_sensors_data_file:s0
