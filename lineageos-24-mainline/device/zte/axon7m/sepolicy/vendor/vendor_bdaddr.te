# Sets the Bluetooth public address over the HCI mgmt socket (bdaddr --nv)
type vendor_bdaddr, domain;
type vendor_bdaddr_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_bdaddr)

allow vendor_bdaddr self:capability net_admin;
allow vendor_bdaddr self:bluetooth_socket create_socket_perms_no_ioctl;
allow vendor_bdaddr vendor_toolbox_exec:file rx_file_perms;
allow vendor_bdaddr vendor_shell_exec:file rx_file_perms;
allow vendor_bdaddr proc_cmdline:file r_file_perms;
allow vendor_bdaddr mnt_vendor_file:dir search;
allow vendor_bdaddr mnt_vendor_file:file r_file_perms;
allow vendor_bdaddr vendor_bdaddr_exec:file execute_no_trans;
