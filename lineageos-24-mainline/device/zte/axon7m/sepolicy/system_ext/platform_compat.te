# Denials in platform domains that the mainline kernel/device tree causes.
# Every rule names the exact domain and type seen in los24-m1a-51's AVC log.

# On this kernel memfd inodes carry the generic tmpfs label (there is no
# memfd_file class). Binder passes MessageQueue fds between processes: these
# are the receiving domains that actually needed read/map in the boot log.
allow { audioserver mediaswcodec system_server } tmpfs:file { getattr read write map };
allow audioserver system_server_tmpfs:file { getattr read write map };
allow mediaswcodec system_server_tmpfs:file { getattr read write map };
allow system_server audioserver_tmpfs:file { getattr read write map };

# libc scans every property area, including vendor_default_prop, when looking
# up a property. Platform policy forbids system domains from reading that area
# (neverallow in private/property.te) and already dontaudits the read for apps:
# the failed open/map is benign (the wanted property is in another area), so
# no rule is added here. All properties we own have explicit contexts.

# crash_dump64 reads our RRO apk and its idmap when dumping a crashing app.
allow crash_dump vendor_overlay_file:file r_file_perms;
allow crash_dump resourcecache_data_file:file r_file_perms;

# mainline sysfs paths without a platform label (see genfs_contexts)
allow storaged sysfs_axon7m_diskstat:file r_file_perms;
allow { fsck e2fs } sysfs_axon7m_block:file r_file_perms;
allow { fsck e2fs } sysfs_axon7m_ufshc:file r_file_perms;
allow system_server sysfs_axon7m_ksm:file r_file_perms;

# init.axon7m.rc calls mkswap /dev/block/zram0 through toolbox
allow toolbox ram_device:blk_file { getattr open read write ioctl };

# vendor_init reads init.svc.rmtfs (platform-private property label)
get_prop(vendor_init, init_service_status_private_prop);
