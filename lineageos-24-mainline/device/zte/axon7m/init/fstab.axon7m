# ZTE Axon 7 on mainline Linux (LineageOS 24, slot "l24"): see PLAN.md section 5.
# Never list the microSD card here: on the development phone it holds Nura's
# ext4 rootfs, and Android would offer to "format" an unsupported volume.
#<src>                                         <mnt_point>  <type> <mnt_flags>                                   <fs_mgr_flags>
system                                          /system      erofs  ro                                            wait,logical,first_stage_mount
system_ext                                      /system_ext  erofs  ro                                            wait,logical,first_stage_mount
product                                         /product     erofs  ro                                            wait,logical,first_stage_mount
vendor                                          /vendor      erofs  ro                                            wait,logical,first_stage_mount
/dev/block/by-name/l24_meta                     /metadata    ext4   noatime,nosuid,nodev,discard                  wait,check,formattable,first_stage_mount
/dev/block/by-name/l24_data                     /data        f2fs   noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier latemount,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2,quota,reservedsize=128M
# NON-HLOS firmware (modem, adsp, slpi, venus, wlan board files), read-only
/dev/block/by-name/modem                        /vendor/firmware_mnt vfat ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait
/dev/block/by-name/misc                         /misc        emmc   defaults                                      defaults
/dev/block/zram0                                none         swap   defaults                                      zramsize=50%
