# Firmware search path for the kernel's user-helper requests (remoteprocs,
# ath10k, Adreno zap shader, QCA Bluetooth). No firmware is in this repository:
# /vendor/firmware is filled from the phone at build time, the modem
# partition's image/ directory is mounted read-only.
firmware_directories /vendor/firmware/ /mnt/vendor/firmware_mnt/image/
modalias_handling enabled

/dev/dri/*                0666   system     graphics
/dev/qrtr-tun             0660   system     system
/dev/uinput               0660   uhid       uhid
/dev/rfkill               0660   bluetooth  bluetooth
/dev/ttyMSM1              0660   bluetooth  bluetooth
/dev/snd/*                0660   system     audio

# backlight for drm_hwcomposer (system): brightness slider, screen off
# (it failed with EACCES, LOS 24 run 27p)
/sys/class/backlight/*  brightness  0664  system  system
/sys/class/backlight/*  bl_power    0664  system  system
# notification LED (multicolour LPG LED) and torch for the lights HAL (system)
/sys/class/leds/rgb:status  brightness       0664  system  system
/sys/class/leds/rgb:status  multi_intensity  0664  system  system
# the camera provider (camera.axon7m torch) runs as user cameraserver
/sys/class/leds/white:torch brightness       0664  cameraserver  system
# camera (libcamera: media controller, CAMSS video and sub-devices)
/dev/media*               0660   system     camera
/dev/v4l-subdev*          0660   system     camera
/dev/video*               0660   system     camera
# PN548 raw NCI character device (kernel pn5xx-raw, AXON7_NFC=1): the NXP
# NFC HAL runs as user nfc. All three aliases share one driver.
/dev/nq-nci               0660   nfc        nfc
/dev/pn5xx                0660   nfc        nfc
/dev/pn54x                0660   nfc        nfc
