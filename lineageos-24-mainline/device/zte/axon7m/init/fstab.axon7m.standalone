# ZTE Axon 7 on mainline Linux, STOCK partition layout (LineageOS 24 release
# zip, AXON7_STANDALONE): super on GPT "system", /data on userdata. No los_*
# partitions, no multi-boot. The installer formats the stock `cache`
# partition as ext4 and stages the GPU's a530_zap.* there, in
# /metadata/axon7-fw (this fstab mounts that partition at /metadata).
# Never list the microSD card here: on the development phone it holds Nura's
# ext4 rootfs, and Android would offer to "format" an unsupported volume.
#<src>                                         <mnt_point>  <type> <mnt_flags>                                   <fs_mgr_flags>
system                                          /system      erofs  ro                                            wait,logical,first_stage_mount
system_ext                                      /system_ext  erofs  ro                                            wait,logical,first_stage_mount
product                                         /product     erofs  ro                                            wait,logical,first_stage_mount
vendor                                          /vendor      erofs  ro                                            wait,logical,first_stage_mount
# Android 17 keeps persistent state on /metadata (aconfig flags, apexd,
# vold's shutdown checkpoints, OTA/GSI state). The stock layout has no
# metadata partition, so `cache` (unused by modern Android) is used for it,
# not a tmpfs. Formatted ext4 by update-binary before the firmware is staged.
# FBE stays on /data only: fileencryption=aes-256-xts:aes-256-cts:v2, NO
# metadata_encryption (same as the multi-boot fstab; FBE v2 keys live on
# /data). `formattable` lets first-stage init repair an unformatted cache.
/dev/block/by-name/cache                        /metadata    ext4   noatime,nosuid,nodev,discard                  wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata                     /data        f2fs   noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier latemount,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2,quota,reservedsize=128M
# NON-HLOS firmware (modem, adsp, slpi, venus, wlan board files), read-only
/dev/block/by-name/modem                        /mnt/vendor/firmware_mnt vfat ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait
# Phones coming from LineageOS 16-22.2 have the community GPT `vendor`
# partition (ext4, a530_zap in firmware/). Prefer it when present: mounted
# read-only like the multi-boot flavour; the installer uses it as the
# preferred *source* for the copy on /metadata. `nofail` keeps the stock
# layout (no vendor partition) bootable. The built /vendor/firmware links
# for the GPU point at /metadata/axon7-fw, so they work in both cases.
/dev/block/by-name/vendor                       /mnt/vendor/fw_vendor ext4 ro,nosuid,nodev,noatime,noload,context=u:object_r:firmware_file:s0 wait,nofail
# ZTE calibration data (Bluetooth address, sensors): read only, no journal
# replay, so persist is never written
/dev/block/by-name/persist                      /mnt/vendor/persist ext4 ro,nosuid,nodev,noatime,noload,context=u:object_r:axon7m_persist_file:s0 wait
/dev/block/by-name/misc                         /misc        emmc   defaults                                      defaults
/dev/block/zram0                                none         swap   defaults                                      zramsize=50%
