# ZTE Axon 7 on mainline Linux: vendor init (milestones M0/M1)
import /vendor/etc/init/hw/init.axon7m.usb.rc

on early-init
    # bring-up: reboot to recovery with a state dump if the boot hangs
    start axon7m-bootguard
    # Kernel modules whose drivers need /vendor (firmware, user helper via
    # ueventd): first stage mounted /vendor already.
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/axon7m-modules.sh

on init
    write /sys/block/zram0/comp_algorithm lz4
    # 4 Kryo cores: 0-1 little (1.59 GHz), 2-3 big (2.15 GHz)
    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/background/cpus 0-1
    write /dev/cpuset/system-background/cpus 0-1
    write /dev/cpuset/top-app/cpus 0-3
    write /dev/cpuset/restricted/cpus 0-1

on fs
    mount_all /vendor/etc/fstab.${ro.hardware} --early
    swapon_all /vendor/etc/fstab.${ro.hardware}

on late-fs
    mount_all /vendor/etc/fstab.${ro.hardware} --late

on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on boot
    # suspend is broken on msm8996 mainline: keep one wakelock (PLAN.md, M4)
    write /sys/power/wake_lock axon7m-nosuspend

# Qualcomm remote filesystem for the modem's EFS (modemst1/2, fsg), QRTR name
# service, TFTP for the modem: from linux-msm userspace, added in M4/M7.

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
        -O/data/vendor/wifi/wpa/sockets -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    socket wpa_wlan0 dgram 660 wifi wifi
    user root
    group system wifi inet
    class main
    disabled
    oneshot

service axon7m-bootguard /vendor/bin/axon7m-bootguard.sh
    class core
    user root
    group root
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled
