# ZTE Axon 7 on mainline Linux: vendor init (milestones M0/M1)
import /vendor/etc/init/hw/init.axon7m.usb.rc

on early-init
    # bring-up: reboot to recovery with a state dump if the boot hangs
    start axon7m-bootguard
    # Kernel modules whose drivers need /vendor (firmware, user helper via
    # ueventd): first stage mounted /vendor already.
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/axon7m-modules.sh

on init
    write /sys/block/zram0/comp_algorithm lz4
    # 4 Kryo cores: 0-1 little (1.59 GHz), 2-3 big (2.15 GHz)
    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/background/cpus 0-1
    write /dev/cpuset/system-background/cpus 0-1
    write /dev/cpuset/top-app/cpus 0-3
    write /dev/cpuset/restricted/cpus 0-1

on fs
    mount_all /vendor/etc/fstab.${ro.hardware} --early
    swapon_all /vendor/etc/fstab.${ro.hardware}

on late-fs
    mount_all /vendor/etc/fstab.${ro.hardware} --late

on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    start axon7m-sns-reg
    # no axon7m-slpi-kick: restarting the SLPI froze the phone (run 24)

on boot
    # suspend is broken on msm8996 mainline: keep one wakelock (PLAN.md, M4)
    write /sys/power/wake_lock axon7m-nosuspend
    start axon7m-audio-routes

# Qualcomm remote filesystem for the modem's EFS (modemst1/2, fsg), QRTR name
# service, TFTP for the modem: from linux-msm userspace, added in M4/M7.

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
        -O/data/vendor/wifi/wpa/sockets -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    socket wpa_wlan0 dgram 660 wifi wifi
    user root
    group system wifi inet
    class main
    disabled
    oneshot

service axon7m-bootguard /vendor/bin/axon7m-bootguard.sh
    class core
    user root
    group root
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled

# ALSA mixer routes (speaker, built-in mic) once the sound card is up
service axon7m-audio-routes /vendor/bin/axon7m-audio-routes.sh
    user root
    group root audio
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled

# Sensors: registry server for the SLPI, then a one-time SLPI restart if the
# Sensor Manager did not come up (the SLPI asked before sns-reg ran)
service axon7m-sns-reg /vendor/bin/axon7m-sns-reg.sh
    user root
    group root system
    seclabel u:r:vendor_modprobe:s0
    disabled

service axon7m-slpi-kick /vendor/bin/axon7m-slpi-kick.sh
    user root
    group root
    seclabel u:r:vendor_modprobe:s0
    oneshot
    disabled

# APSS watchdog (qcom_wdt, /dev/watchdog): the kernel driver never arms it by
# itself, so a hang waited for someone to hold the power key. watchdogd pets
# every 10 s with a 30 s timeout (interval + margin); if the system hangs the
# phone resets into the boot menu.
service watchdogd /system/bin/watchdogd 10 20
    class core
    user root
    group root
    seclabel u:r:watchdogd:s0

# Modem (qcom/README.md): rmtfs serves the modem's EFS partitions read-only
# (-r: the modem's writes are discarded, modemst1/2, fsg and fsc are never
# written) and starts the modem remoteproc (-s). Once it runs, the modem is
# switched online over QMI DMS (radios, GPS). Tested by hand on build 31:
# MBA + MPSS up, DMS/LOC/NAS/WMS/UIM/VOICE/WDS on QRTR, online in 3 s.
service rmtfs /vendor/bin/rmtfs -o /dev/block/by-name -P -r -s
    class core
    user root
    group system

service axon7m-modem-online /vendor/bin/axon7m-modem-online
    user root
    group system
    oneshot
    disabled

on property:init.svc.rmtfs=running
    start axon7m-modem-online
