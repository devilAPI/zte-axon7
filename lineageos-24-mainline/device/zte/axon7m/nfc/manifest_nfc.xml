<!-- AIDL NFC HAL for the NXP PN548 (kernel pn5xx-raw character device).
     Same FQName as hardware/nxp/nfc/snxxx/aidl/1.0/nfc-service-nxp.xml
     at android-17.0.0_r1, but implemented in device/zte/axon7m/nfc/ and
     built against the V2 NDK interface (no NXP vendor extension).
     Only installed with AXON7_NFC=1. -->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>android.hardware.nfc</name>
        <version>2</version>
        <fqname>INfc/default</fqname>
    </hal>
</manifest>
