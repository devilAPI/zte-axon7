package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.vibrator-service.axon7m",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["vibrator-axon7m.rc"],
    vintf_fragments: ["vibrator-axon7m.xml"],
    srcs: ["Vibrator.cpp"],
    cflags: ["-Wall", "-Werror"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.vibrator-V4-ndk",
    ],
}
