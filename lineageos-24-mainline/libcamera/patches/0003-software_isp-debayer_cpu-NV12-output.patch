-void DebayerCpuThread::process2(uint32_t frame, const uint8_t *src, uint8_t *dst)
+/*
+ * NV12 output: convert the two debayered lines in rgbLines_ (B, G, R bytes)
+ * to two luma lines and one line of interleaved Cb/Cr (BT.601, limited
+ * range, chroma averaged over 2x2 pixels).
+ */
+void DebayerCpuThread::storeNv12Pair(uint8_t *dst, uint8_t *dstUV)
+{
+	const unsigned int stride = debayer_->outputConfig_.stride;
+	const unsigned int width = debayer_->window_.width;
+	const uint8_t *l0 = rgbLines_[0].data();
+	const uint8_t *l1 = rgbLines_[1].data();
+	uint8_t *y0 = dst;
+	uint8_t *y1 = dst + stride;
+
+	for (unsigned int x = 0; x < width; x += 2) {
+		int bs = 0, gs = 0, rs = 0;
+		const uint8_t *px[4] = { l0, l0 + 3, l1, l1 + 3 };
+		uint8_t *py[4] = { y0, y0 + 1, y1, y1 + 1 };
+
+		for (unsigned int i = 0; i < 4; i++) {
+			int b = px[i][0], g = px[i][1], r = px[i][2];
+
+			*py[i] = static_cast<uint8_t>(((66 * r + 129 * g + 25 * b + 128) >> 8) + 16);
+			bs += b;
+			gs += g;
+			rs += r;
+		}
+		bs /= 4;
+		gs /= 4;
+		rs /= 4;
+		dstUV[0] = static_cast<uint8_t>(((-38 * rs - 74 * gs + 112 * bs + 128) >> 8) + 128);
+		dstUV[1] = static_cast<uint8_t>(((112 * rs - 94 * gs - 18 * bs + 128) >> 8) + 128);
+
+		l0 += 6;
+		l1 += 6;
+		y0 += 2;
+		y1 += 2;
+		dstUV += 2;
+	}
+}
