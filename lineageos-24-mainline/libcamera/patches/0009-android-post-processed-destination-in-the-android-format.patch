From: axon7m bring-up
Subject: [PATCH] android: describe a post-processed destination with the Android stream's format

CameraStream::process() built the destination CameraBuffer with the source
libcamera stream's format and size: NV12 for the internal stream a JPEG is
encoded from. PostProcessorJpeg then asserted "destination->numPlanes() == 1"
on every still capture. Use the Android stream's format (MJPEG for BLOB)
and size.
---
--- a/src/android/camera_stream.cpp
+++ b/src/android/camera_stream.cpp
@@ -182,9 +182,17 @@
 		streamBuffer->fence.reset();
 	}
 
-	const StreamConfiguration &output = configuration();
+	/*
+	 * The destination is the Android stream's buffer: describe it with the
+	 * Android stream's format and size (MJPEG for a BLOB stream), not with
+	 * the source libcamera stream's (NV12), or PostProcessorJpeg asserts
+	 * on its two planes.
+	 */
+	const PixelFormat dstFormat =
+		cameraDevice_->capabilities()->toPixelFormat(camera3Stream_->format);
+	const Size dstSize{ camera3Stream_->width, camera3Stream_->height };
 	streamBuffer->dstBuffer = std::make_unique<CameraBuffer>(
-		*streamBuffer->camera3Buffer, output.pixelFormat, output.size,
+		*streamBuffer->camera3Buffer, dstFormat, dstSize,
 		PROT_READ | PROT_WRITE);
 	if (!streamBuffer->dstBuffer->isValid()) {
 		LOG(HAL, Error) << "Failed to create destination buffer";
