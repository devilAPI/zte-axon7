From: axon7m bring-up
Subject: [PATCH] android: mm: generic: minigbm buffer layout, internal buffers from the dma-buf heap

- CameraBuffer: read strides, plane offsets and sizes from minigbm's
  cros_gralloc_handle (magic 0xabcddcba at data[26], after DRV_MAX_FDS = 5 fd slots; one fd per plane). minigbm pads NV12
  (stride and scanlines for the video codecs), so the packed layout the
  generic backend assumed put the chroma plane at the wrong offset.
- PlatformFrameBufferAllocator: Android 17 with minigbm has no gralloc0
  module, gralloc_open() asserted. The HAL's internal buffers (the NV12
  stream a JPEG is encoded from) only live inside the HAL, so allocate them
  from /dev/dma_heap/system and describe them with the same handle layout.
- CameraBuffer: one plane over the whole buffer for compressed formats
  (BLOB/MJPEG has no plane layout; PostProcessorJpeg asserted on 0 planes).
---
--- a/src/android/mm/generic_camera_buffer.cpp
+++ b/src/android/mm/generic_camera_buffer.cpp
@@ -7,6 +7,7 @@
 
 #include "../camera_buffer.h"
 
+#include <algorithm>
 #include <sys/mman.h>
 #include <unistd.h>
 
@@ -75,7 +76,16 @@
 	 * now that the buffer is backed by a single dmabuf, with planes being
 	 * stored contiguously.
 	 */
-	for (int i = 0; i < camera3Buffer->numFds; i++) {
+	/*
+	 * minigbm hands out one fd per plane, all of the same buffer (dup()ed):
+	 * with its handle layout (magic below) the first fd is the buffer.
+	 */
+	const bool crosHandle = camera3Buffer->numFds + camera3Buffer->numInts > 26 &&
+				static_cast<uint32_t>(camera3Buffer->data[26]) == 0xabcddcba;
+	if (crosHandle)
+		fd_ = camera3Buffer->data[0];
+
+	for (int i = 0; !crosHandle && i < camera3Buffer->numFds; i++) {
 		if (camera3Buffer->data[i] == -1 || camera3Buffer->data[i] == fd_)
 			continue;
 
@@ -102,8 +112,40 @@
 	}
 
 	const unsigned int numPlanes = info.numPlanes();
+
+	/*
+	 * Compressed formats (MJPEG for BLOB streams) have no plane layout:
+	 * one plane that spans the whole buffer, as PostProcessorJpeg expects.
+	 */
+	if (numPlanes == 0) {
+		planeInfo_.resize(1);
+		planeInfo_[0].stride = 0;
+		planeInfo_[0].offset = 0;
+		planeInfo_[0].size = bufferLength_;
+		return;
+	}
+
 	planeInfo_.resize(numPlanes);
 
+	/*
+	 * minigbm (cros_gralloc_handle) and the HAL's own dma-heap buffers
+	 * (generic_frame_buffer_allocator.cpp) carry their real layout: the
+	 * strides, plane offsets and sizes follow DRV_MAX_FDS (5) fd slots,
+	 * the magic is at index 26 of data[]. minigbm pads NV12 for the video
+	 * codecs (stride, scanlines), so the packed layout below is wrong
+	 * for its buffers.
+	 */
+	if (crosHandle && numPlanes <= 4) {
+		for (unsigned int i = 0; i < numPlanes; ++i) {
+			planeInfo_[i].stride = camera3Buffer->data[5 + i];
+			planeInfo_[i].offset = camera3Buffer->data[9 + i];
+			planeInfo_[i].size = std::min<unsigned int>(
+				camera3Buffer->data[13 + i],
+				bufferLength_ - planeInfo_[i].offset);
+		}
+		return;
+	}
+
 	unsigned int offset = 0;
 	for (unsigned int i = 0; i < numPlanes; ++i) {
 		const unsigned int planeSize = info.planeSize(size, i);
