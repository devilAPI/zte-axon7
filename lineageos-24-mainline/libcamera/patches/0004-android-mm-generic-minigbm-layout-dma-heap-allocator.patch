 LOG_DECLARE_CATEGORY(HAL)
 
 namespace {
+constexpr int kHandleInts = 27 - 1;	/* data[1..26] after one fd */
+
+/* native_handle_create() is in libcutils, which the NDK does not have */
+native_handle_t *createHandle(int numFds, int numInts)
+{
+	size_t size = sizeof(native_handle_t) + sizeof(int) * (numFds + numInts);
+	native_handle_t *h = static_cast<native_handle_t *>(calloc(1, size));
+	if (!h)
+		return nullptr;
+	h->version = sizeof(native_handle_t);
+	h->numFds = numFds;
+	h->numInts = numInts;
+	return h;
+}
