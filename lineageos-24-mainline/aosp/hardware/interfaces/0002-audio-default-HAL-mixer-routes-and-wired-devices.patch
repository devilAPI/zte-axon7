+// Analog devices (wired headset, headphones) on the primary card: their
+// streams are routed by the mixer (StreamPrimary), the template's profiles
+// stay as they are (the mix ports have static profiles).
+ndk::ScopedAStatus ModulePrimary::populateConnectedDevicePort(AudioPort* audioPort,
+                                                              int32_t nextPortId) {
+    if (audioPort->ext.getTag() == AudioPortExt::device &&
+        audioPort->ext.get<AudioPortExt::device>().device.type.connection ==
+                ::aidl::android::media::audio::common::AudioDeviceDescription::CONNECTION_ANALOG) {
+        LOG(DEBUG) << __func__ << ": analog device, static routing: "
+                   << audioPort->ext.get<AudioPortExt::device>().device.toString();
+        return ndk::ScopedAStatus::ok();
+    }
+    return Module::populateConnectedDevicePort(audioPort, nextPortId);
+}
