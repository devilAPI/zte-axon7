 namespace aidl::android::hardware::audio::core {
 
+namespace {
+
+// Mixer routes for the primary card, from the file named by
+// ro.vendor.audio.tinyalsa.routes:
+//   [route]                 speaker, earpiece, headphones, mic, headset-mic
+//   control name = value    enum by name; on/off or a number otherwise
+// Each route sets the whole state it needs (no disable sequences).
+using Route = std::vector<std::pair<std::string, std::string>>;
+
+std::string trim(const std::string& s) {
+    const auto b = s.find_first_not_of(" \t\r");
+    if (b == std::string::npos) return "";
+    return s.substr(b, s.find_last_not_of(" \t\r") - b + 1);
+}
+
+const std::map<std::string, Route>& mixerRoutes() {
+    static const std::map<std::string, Route> kRoutes = [] {
+        std::map<std::string, Route> routes;
+        const std::string path = GetProperty("ro.vendor.audio.tinyalsa.routes", "");
+        if (path.empty()) return routes;
+        std::ifstream file(path);
+        std::string line, current;
+        while (std::getline(file, line)) {
+            line = trim(line);
+            if (line.empty() || line[0] == '#') continue;
+            if (line.front() == '[' && line.back() == ']') {
+                current = trim(line.substr(1, line.size() - 2));
+                routes[current];
+                continue;
+            }
+            const auto eq = line.find('=');
+            if (current.empty() || eq == std::string::npos) continue;
+            routes[current].emplace_back(trim(line.substr(0, eq)), trim(line.substr(eq + 1)));
+        }
+        LOG(INFO) << "mixerRoutes: " << routes.size() << " routes from " << path;
+        return routes;
+    }();
+    return kRoutes;
+}
+
+const char* routeName(const AudioDevice& device) {
+    switch (device.type.type) {
+        case AudioDeviceType::OUT_SPEAKER:
+            return "speaker";
+        case AudioDeviceType::OUT_SPEAKER_EARPIECE:
+            return "earpiece";
+        case AudioDeviceType::OUT_HEADSET:
+        case AudioDeviceType::OUT_HEADPHONE:
+            return "headphones";
+        case AudioDeviceType::IN_MICROPHONE:
+            return "mic";
+        case AudioDeviceType::IN_HEADSET:
+            return "headset-mic";
+        default:
+            return nullptr;
+    }
+}
+
+void applyMixerRoute(int card, const AudioDevice& device) {
+    const char* name = routeName(device);
+    if (name == nullptr) return;
+    const auto it = mixerRoutes().find(name);
+    if (it == mixerRoutes().end()) return;
+    struct mixer* mixer = mixer_open(card);
+    if (mixer == nullptr) {
+        LOG(ERROR) << __func__ << ": cannot open the mixer of card " << card;
+        return;
+    }
+    int failed = 0;
+    for (const auto& [control, value] : it->second) {
+        struct mixer_ctl* ctl = mixer_get_ctl_by_name(mixer, control.c_str());
+        if (ctl == nullptr) {
+            LOG(WARNING) << __func__ << ": no control '" << control << "'";
+            failed++;
+            continue;
+        }
+        int ret = 0;
+        if (mixer_ctl_get_type(ctl) == MIXER_CTL_TYPE_ENUM) {
+            ret = mixer_ctl_set_enum_by_string(ctl, value.c_str());
+        } else {
+            const int v = value == "on" ? 1 : value == "off" ? 0 : atoi(value.c_str());
+            for (unsigned i = 0; i < mixer_ctl_get_num_values(ctl); i++) {
+                ret |= mixer_ctl_set_value(ctl, i, v);
+            }
+        }
+        if (ret != 0) {
+            LOG(WARNING) << __func__ << ": '" << control << "' = '" << value << "' failed";
+            failed++;
+        }
+    }
+    mixer_close(mixer);
+    LOG(INFO) << __func__ << ": card " << card << " route " << name << " ("
+              << it->second.size() << " controls, " << failed << " failed)";
+}
