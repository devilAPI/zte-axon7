 namespace aidl::android::hardware::audio::core {
 
+// Hardware call audio: the audio policy connects Telephony Rx -> earpiece/
+// speaker and mic -> Telephony Tx with device-to-device patches during a call.
+// While such a patch exists, the DSP's voice path runs (setVoiceCallAudio).
+ndk::ScopedAStatus ModulePrimary::setAudioPatch(const AudioPatch& in_requested,
+                                                AudioPatch* _aidl_return) {
+    auto status = Module::setAudioPatch(in_requested, _aidl_return);
+    if (status.isOk()) updateVoiceCallAudio();
+    return status;
+}
+
+ndk::ScopedAStatus ModulePrimary::resetAudioPatch(int32_t in_patchId) {
+    auto status = Module::resetAudioPatch(in_patchId);
+    if (status.isOk()) updateVoiceCallAudio();
+    return status;
+}
+
+void ModulePrimary::updateVoiceCallAudio() {
+    using ::aidl::android::media::audio::common::AudioDevice;
+    using ::aidl::android::media::audio::common::AudioDeviceType;
+    std::vector<AudioPatch> patches;
+    std::vector<AudioPortConfig> configs;
+    if (!getAudioPatches(&patches).isOk() || !getAudioPortConfigs(&configs).isOk()) return;
+    auto device = [&](int32_t id) -> const AudioDevice* {
+        for (const auto& c : configs) {
+            if (c.id == id && c.ext.getTag() == AudioPortExt::Tag::device) {
+                return &c.ext.get<AudioPortExt::Tag::device>().device;
+            }
+        }
+        return nullptr;
+    };
+    const AudioDevice* rxSink = nullptr;    // Telephony Rx -> this device
+    const AudioDevice* txSource = nullptr;  // this device -> Telephony Tx
+    bool telephony = false;
+    for (const auto& p : patches) {
+        bool fromRx = false, toTx = false;
+        for (int32_t id : p.sourcePortConfigIds) {
+            const AudioDevice* d = device(id);
+            if (d && d->type.type == AudioDeviceType::IN_TELEPHONY_RX) fromRx = true;
+        }
+        for (int32_t id : p.sinkPortConfigIds) {
+            const AudioDevice* d = device(id);
+            if (d && d->type.type == AudioDeviceType::OUT_TELEPHONY_TX) toTx = true;
+        }
+        if (fromRx && !p.sinkPortConfigIds.empty()) rxSink = device(p.sinkPortConfigIds[0]);
+        if (toTx && !p.sourcePortConfigIds.empty()) txSource = device(p.sourcePortConfigIds[0]);
+        telephony |= fromRx || toTx;
+    }
+    setVoiceCallAudio(telephony, rxSink, txSource);
+}
