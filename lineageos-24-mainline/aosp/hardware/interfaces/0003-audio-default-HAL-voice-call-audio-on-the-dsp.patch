+// Circuit-switched call audio runs inside the DSP (q6voice): the HAL only sets
+// the card's voice mixer routes and holds the CS-Voice PCM open, which starts
+// the voice session (ro.vendor.audio.voice.device: PCM device of the CS-Voice
+// link on the primary card; unset = no voice). ModulePrimary calls this while
+// a hardware audio patch uses the Telephony Rx/Tx device ports.
+void setVoiceCallAudio(bool on, const AudioDevice* rxDevice, const AudioDevice* txDevice) {
+    static std::mutex lock;
+    static struct pcm* rx = nullptr;
+    static struct pcm* tx = nullptr;
+    std::lock_guard l(lock);
+    const int card = ::android::base::GetIntProperty("ro.vendor.audio.voice.card", 0);
+    const int device = ::android::base::GetIntProperty("ro.vendor.audio.voice.device", -1);
+    if (device < 0) return;
+    if (on) {
+        if (rxDevice != nullptr) applyMixerRoute(card, *rxDevice);
+        if (txDevice != nullptr) applyMixerRoute(card, *txDevice);
+        applyMixerRouteByName(card, "voice");
+        if (rx != nullptr) return;
+        // the CS-Voice DAI takes 8 kHz mono, 2-4 periods of 2-4 KiB; no data
+        // flows through these PCMs, opening them starts the voice session
+        struct pcm_config config = {};
+        config.channels = 1;
+        config.rate = 8000;
+        config.period_size = 1024;
+        config.period_count = 2;
+        config.format = PCM_FORMAT_S16_LE;
+        rx = pcm_open(card, device, PCM_OUT, &config);
+        if (rx == nullptr || !pcm_is_ready(rx)) {
+            LOG(ERROR) << __func__ << ": CS-Voice playback " << card << "," << device << ": "
+                       << (rx ? pcm_get_error(rx) : "no memory");
+            if (rx) pcm_close(rx);
+            rx = nullptr;
+            return;
+        }
+        tx = pcm_open(card, device, PCM_IN, &config);
+        if (tx == nullptr || !pcm_is_ready(tx)) {
+            LOG(ERROR) << __func__ << ": CS-Voice capture " << card << "," << device << ": "
+                       << (tx ? pcm_get_error(tx) : "no memory");
+            if (tx) pcm_close(tx);
+            tx = nullptr;
+        }
+        LOG(INFO) << __func__ << ": voice call audio on (card " << card << " device " << device
+                  << (tx ? "" : ", no capture") << ")";
+    } else if (rx != nullptr) {
+        if (tx) pcm_close(tx);
+        pcm_close(rx);
+        rx = tx = nullptr;
+        applyMixerRouteByName(card, "voice-off");
+        LOG(INFO) << __func__ << ": voice call audio off";
+    }
+}
