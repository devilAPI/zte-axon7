bootstrap: soft memory limit (80% of MemTotal) for soong_build

Local patch for the zte-axon7 LineageOS 24 mainline build host (not for
upstream as is). soong_build is started with a cleared environment, so
GOMEMLIMIT cannot be passed in (Android 17's soong_ui has no
SOONG_GOMEMLIMIT any more), and with the default GOGC the Go heap grows to
about twice the live set. On the 31 GB build container the kernel OOM-killed
soong_build during Android.bp analysis (exit 137, cgroup oom_kill 3, peak
30.76 GB, 2026-11-10). debug.SetMemoryLimit keeps the heap under 80% of
MemTotal (lxcfs reports the container's limit) by collecting harder.

Applied by lineageos-24-mainline/scripts/los24-build.sh (aosp/<project path>/*.patch).

--- a/bootstrap/command.go
+++ b/bootstrap/command.go
@@ -24,6 +24,7 @@
 	"runtime/debug"
 	"runtime/pprof"
 	"runtime/trace"
+	"strconv"
 	"strings"
 
 	"github.com/google/blueprint"
@@ -70,6 +71,15 @@
 func RunBlueprint(args Args, stopBefore StopBefore, ctx *blueprint.Context, config interface{}) ([]string, error) {
 	runtime.GOMAXPROCS(runtime.NumCPU())
 
+	// axon7m (zte-axon7 lineageos-24-mainline): soong_build runs with a
+	// cleared environment (env -i), so GOMEMLIMIT cannot be passed in, and
+	// with the default GOGC the heap grows to about twice the live set: on a
+	// 31 GB build container the kernel OOM-killed it during analysis. A soft
+	// limit of 80% of MemTotal makes the GC work harder instead.
+	if limit := memoryLimitFromMeminfo(); limit > 0 {
+		debug.SetMemoryLimit(limit)
+	}
+
 	if args.NoGC {
 		debug.SetGCPercent(-1)
 	}
@@ -254,3 +264,22 @@
 
 	return errors.Join(colorizedErrs...)
 }
+
+// memoryLimitFromMeminfo returns 80% of MemTotal in bytes, or 0.
+func memoryLimitFromMeminfo() int64 {
+	b, err := os.ReadFile("/proc/meminfo")
+	if err != nil {
+		return 0
+	}
+	for _, line := range strings.Split(string(b), "\n") {
+		f := strings.Fields(line)
+		if len(f) >= 2 && f[0] == "MemTotal:" {
+			kb, err := strconv.ParseInt(f[1], 10, 64)
+			if err != nil {
+				return 0
+			}
+			return kb * 1024 / 10 * 8
+		}
+	}
+	return 0
+}
