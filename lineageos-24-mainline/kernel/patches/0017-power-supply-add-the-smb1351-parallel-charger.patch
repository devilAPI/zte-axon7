diff --git a/drivers/power/supply/smb1351-charger.c b/drivers/power/supply/smb1351-charger.c
new file mode 100644
index 000000000..57eae4113
--- /dev/null
+++ b/drivers/power/supply/smb1351-charger.c
@@ -0,0 +1,588 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Summit/Qualcomm SMB1351 as a parallel charger next to a primary charger
+ * (PMI8994/PMI8996 SMBCHG on msm8996 phones such as the ZTE Axon 7).
+ *
+ * Register layout from the downstream smb1351-charger.c
+ * (Copyright (c) 2015-2016 The Linux Foundation).
+ *
+ * The SMB1351 shares VBUS and the battery with the primary charger. It
+ * charges only while all of these hold:
+ *  - the primary charger is online on a dedicated charging port (DCP),
+ *    is in fast charge and its AICL found at least min-input-current;
+ *  - the battery is between 15 and 40 degC and below 4.25 V (hysteresis
+ *    down to 4.15 V), so the SMB1351 never reaches its constant-voltage
+ *    phase: the primary charger alone tapers and terminates.
+ * Then the AICL result of the primary charger (what the adapter can give)
+ * is split: the SMB1351 takes up to 40 % of it, the primary charger's input
+ * limit is lowered by that amount, so the total stays what the adapter
+ * delivered before. Charge current and float voltage of the SMB1351 are
+ * capped by the device tree (never more than the stock values).
+ * Everything else keeps the SMB1351's USB input suspended.
+ *
+ * The enable path is off by default (smb1351_charger.enable=1 on the kernel
+ * command line, as a modprobe option or at runtime in
+ * /sys/module/smb1351_charger/parameters/enable): off, the driver only holds
+ * the SMB1351's input suspended and changes no other setting.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define CHG_CURRENT_CTRL_REG		0x00
+#define  FAST_CHG_CURRENT_MASK		GENMASK(7, 4)
+#define  AC_INPUT_CURRENT_LIMIT_MASK	GENMASK(3, 0)
+#define VARIOUS_FUNC_REG		0x02
+#define  SUSPEND_MODE_CTRL_BY_I2C	BIT(7)
+#define  AICL_EN_BIT			BIT(4)
+#define VFLOAT_REG			0x03
+#define  VFLOAT_MASK			GENMASK(5, 0)
+#define CHG_PIN_EN_CTRL_REG		0x06
+#define VARIOUS_FUNC_2_REG		0x0e
+#define  PRECHG_TO_FASTCHG_BIT		BIT(1)
+#define CMD_I2C_REG			0x30
+#define  CMD_BQ_CFG_ACCESS_BIT		BIT(6)
+#define CMD_INPUT_LIMIT_REG		0x31
+#define  CMD_SUSPEND_MODE_BIT		BIT(6)
+#define  CMD_INPUT_CURRENT_MODE_CMD	BIT(3)
+#define  CMD_USB_3_MODE			BIT(2)
+#define  CMD_USB_AC_MASK		GENMASK(1, 0)
+#define  CMD_USB_HC_MODE		0x1
+#define STATUS_0_REG			0x36
+#define  STATUS_INPUT_SUSPEND		BIT(4)
+#define  STATUS_INPUT_CURRENT_LIMIT_MASK GENMASK(3, 0)
+#define STATUS_4_REG			0x3a
+#define  STATUS_CHG_MASK		GENMASK(2, 1)
+#define  STATUS_CHG_EN_STATUS_BIT	BIT(0)
+#define CHG_REVISION_REG		0x3f
+#define IRQ_A_REG			0x40
+#define  IRQ_HOT_COLD_HARD		(BIT(6) | BIT(4))
+
+#define VFLOAT_MIN_UV			3500000
+#define VFLOAT_STEP_UV			20000
+#define VFLOAT_LIMIT_UV			4400000	/* stock primary float */
+#define FCC_LIMIT_UA			1500000	/* stock parallel share */
+#define BATT_ON_UV			4150000
+#define BATT_OFF_UV			4250000
+#define BATT_TEMP_MIN			150	/* 0.1 degC */
+#define BATT_TEMP_MAX			400
+#define SLAVE_ICL_PERCENT		40
+#define POLL_MS				10000
+
+static bool enable;
+module_param(enable, bool, 0644);
+MODULE_PARM_DESC(enable,
+	"Charge with the SMB1351 (default off: its input stays suspended)");
+
+static const int smb1351_icl_ma[] = {
+	500, 685, 1000, 1100, 1200, 1300, 1500, 1600,
+	1700, 1800, 2000, 2200, 2500, 3000,
+};
+
+static const int smb1351_fcc_ma[] = {
+	1000, 1200, 1400, 1600, 1800, 2000, 2200,
+	2400, 2600, 2800, 3000, 3400, 3600, 3800,
+	4000, 4640,
+};
+
+struct smb1351 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct power_supply *psy;
+	struct power_supply *batt;
+	struct delayed_work work;
+	struct mutex lock;
+	u32 vfloat_uv;
+	u32 fcc_ua;
+	u32 min_input_ua;
+	bool enabled;
+	bool configured;
+	int slave_icl_ma;
+	int primary_icl_ua;	/* primary's input limit before the split */
+};
+
+static int smb1351_suspend_input(struct smb1351 *chip, bool suspend)
+{
+	return regmap_update_bits(chip->regmap, CMD_INPUT_LIMIT_REG,
+				  CMD_SUSPEND_MODE_BIT,
+				  suspend ? CMD_SUSPEND_MODE_BIT : 0);
+}
+
+static int smb1351_hw_init(struct smb1351 *chip)
+{
+	unsigned int rev;
+	int ret;
+
+	ret = regmap_read(chip->regmap, CHG_REVISION_REG, &rev);
+	if (ret)
+		return dev_err_probe(chip->dev, ret, "no SMB1351\n");
+
+	ret = regmap_update_bits(chip->regmap, CMD_I2C_REG,
+				 CMD_BQ_CFG_ACCESS_BIT, CMD_BQ_CFG_ACCESS_BIT);
+	if (ret)
+		return ret;
+
+	/* input off first, then hand the suspend control to I2C */
+	ret = smb1351_suspend_input(chip, true);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(chip->regmap, VARIOUS_FUNC_REG,
+				 SUSPEND_MODE_CTRL_BY_I2C,
+				 SUSPEND_MODE_CTRL_BY_I2C);
+	if (ret)
+		return ret;
+
+	dev_info(chip->dev, "SMB1351 rev 0x%02x, input suspended%s\n", rev,
+		 enable ? "" : " (parallel charging off: smb1351_charger.enable=1)");
+
+	return 0;
+}
+
+static int smb1351_configure(struct smb1351 *chip)
+{
+	unsigned int val;
+	int ret;
+
+	ret = regmap_update_bits(chip->regmap, VFLOAT_REG, VFLOAT_MASK,
+				 (chip->vfloat_uv - VFLOAT_MIN_UV) /
+				 VFLOAT_STEP_UV);
+	if (ret)
+		return ret;
+
+	/* fast charge, not pre-charge, at the lowest current until enabled */
+	ret = regmap_update_bits(chip->regmap, VARIOUS_FUNC_2_REG,
+				 PRECHG_TO_FASTCHG_BIT, 0);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(chip->regmap, CHG_CURRENT_CTRL_REG,
+				 FAST_CHG_CURRENT_MASK, 0);
+	if (ret)
+		return ret;
+
+	/* its own AICL backs off if the adapter sags */
+	ret = regmap_update_bits(chip->regmap, VARIOUS_FUNC_REG,
+				 AICL_EN_BIT, AICL_EN_BIT);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(chip->regmap, VFLOAT_REG, &val);
+	if (ret)
+		return ret;
+	dev_info(chip->dev, "SMB1351 configured: float %u mV\n",
+		 (unsigned int)(VFLOAT_MIN_UV + (val & VFLOAT_MASK) *
+				VFLOAT_STEP_UV) / 1000);
+	chip->configured = true;
+
+	return 0;
+}
+
+static int smb1351_set_fcc(struct smb1351 *chip, int ua)
+{
+	int i;
+
+	for (i = ARRAY_SIZE(smb1351_fcc_ma) - 1; i > 0; i--)
+		if (smb1351_fcc_ma[i] * 1000 <= ua)
+			break;
+
+	return regmap_update_bits(chip->regmap, CHG_CURRENT_CTRL_REG,
+				  FAST_CHG_CURRENT_MASK, i << 4);
+}
+
+/* largest table entry <= ma, or -EINVAL below the table */
+static int smb1351_set_icl(struct smb1351 *chip, int ma)
+{
+	int i, ret;
+
+	for (i = ARRAY_SIZE(smb1351_icl_ma) - 1; i >= 0; i--)
+		if (smb1351_icl_ma[i] <= ma)
+			break;
+	if (i < 0)
+		return -EINVAL;
+
+	ret = regmap_update_bits(chip->regmap, CHG_CURRENT_CTRL_REG,
+				 AC_INPUT_CURRENT_LIMIT_MASK, i);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(chip->regmap, CMD_INPUT_LIMIT_REG,
+				 CMD_INPUT_CURRENT_MODE_CMD | CMD_USB_3_MODE |
+				 CMD_USB_AC_MASK,
+				 CMD_INPUT_CURRENT_MODE_CMD | CMD_USB_HC_MODE);
+	if (ret)
+		return ret;
+
+	return smb1351_icl_ma[i];
+}
+
+static int smb1351_get_prop(struct power_supply *psy,
+			    enum power_supply_property psp, int *val)
+{
+	union power_supply_propval pval;
+	int ret;
+
+	ret = power_supply_get_property(psy, psp, &pval);
+	if (!ret)
+		*val = pval.intval;
+	return ret;
+}
+
+static struct power_supply *smb1351_primary(struct smb1351 *chip)
+{
+	struct power_supply *psy = chip->psy;
+
+	if (!psy->num_supplies)
+		return NULL;
+
+	return power_supply_get_by_name(psy->supplied_from[0]);
+}
+
+static bool smb1351_should_charge(struct smb1351 *chip,
+				  struct power_supply *primary, int *icl_ua)
+{
+	int online, type, chg_type, vbat, temp, health;
+
+	if (!READ_ONCE(enable))
+		return false;
+	if (smb1351_get_prop(primary, POWER_SUPPLY_PROP_ONLINE, &online) ||
+	    !online)
+		return false;
+	if (smb1351_get_prop(primary, POWER_SUPPLY_PROP_USB_TYPE, &type) ||
+	    type != POWER_SUPPLY_USB_TYPE_DCP)
+		return false;
+	if (smb1351_get_prop(primary, POWER_SUPPLY_PROP_CHARGE_TYPE,
+			     &chg_type) ||
+	    chg_type != POWER_SUPPLY_CHARGE_TYPE_FAST)
+		return false;
+	if (smb1351_get_prop(primary, POWER_SUPPLY_PROP_HEALTH, &health) ||
+	    health != POWER_SUPPLY_HEALTH_GOOD)
+		return false;
+
+	if (!chip->batt)
+		return false;
+	if (smb1351_get_prop(chip->batt, POWER_SUPPLY_PROP_VOLTAGE_NOW, &vbat))
+		return false;
+	if (vbat >= (chip->enabled ? BATT_OFF_UV : BATT_ON_UV))
+		return false;
+	if (smb1351_get_prop(chip->batt, POWER_SUPPLY_PROP_TEMP, &temp) ||
+	    temp < BATT_TEMP_MIN || temp > BATT_TEMP_MAX)
+		return false;
+
+	if (chip->enabled) {
+		*icl_ua = chip->primary_icl_ua;
+		return true;
+	}
+
+	if (smb1351_get_prop(primary, POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+			     icl_ua) || *icl_ua < chip->min_input_ua)
+		return false;
+
+	return true;
+}
+
+static void smb1351_disable(struct smb1351 *chip, struct power_supply *primary)
+{
+	union power_supply_propval pval;
+
+	smb1351_suspend_input(chip, true);
+	if (chip->configured)
+		smb1351_set_fcc(chip, 0);
+
+	if (chip->enabled && primary) {
+		/* give the primary its input limit back */
+		pval.intval = chip->primary_icl_ua;
+		power_supply_set_property(primary,
+					  POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+					  &pval);
+	}
+
+	if (chip->enabled)
+		dev_info(chip->dev, "parallel charging off\n");
+	chip->enabled = false;
+	chip->slave_icl_ma = 0;
+}
+
+static void smb1351_enable(struct smb1351 *chip, struct power_supply *primary,
+			   int total_icl_ua)
+{
+	union power_supply_propval pval;
+	int slave_ma, ret;
+
+	if (!chip->configured && smb1351_configure(chip))
+		return;
+
+	slave_ma = smb1351_set_icl(chip, total_icl_ua / 1000 *
+				   SLAVE_ICL_PERCENT / 100);
+	if (slave_ma < 0)
+		return;
+
+	pval.intval = total_icl_ua - slave_ma * 1000;
+	ret = power_supply_set_property(primary,
+					POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+					&pval);
+	if (ret) {
+		dev_warn(chip->dev, "primary input limit: %d\n", ret);
+		return;
+	}
+
+	ret = smb1351_set_fcc(chip, chip->fcc_ua);
+	if (!ret)
+		ret = smb1351_suspend_input(chip, false);
+	if (ret) {
+		smb1351_suspend_input(chip, true);
+		pval.intval = total_icl_ua;
+		power_supply_set_property(primary,
+				POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, &pval);
+		return;
+	}
+
+	chip->enabled = true;
+	chip->slave_icl_ma = slave_ma;
+	chip->primary_icl_ua = total_icl_ua;
+	dev_info(chip->dev,
+		 "parallel charging on: input %d of %d mA, charge %u mA\n",
+		 slave_ma, total_icl_ua / 1000, chip->fcc_ua / 1000);
+}
+
+static void smb1351_update(struct smb1351 *chip)
+{
+	struct power_supply *primary = smb1351_primary(chip);
+	int icl_ua = 0;
+	bool charge;
+
+	mutex_lock(&chip->lock);
+	charge = primary && smb1351_should_charge(chip, primary, &icl_ua);
+	if (charge && !chip->enabled)
+		smb1351_enable(chip, primary, icl_ua);
+	else if (!charge && chip->enabled)
+		smb1351_disable(chip, primary);
+	mutex_unlock(&chip->lock);
+
+	if (primary) {
+		int online = 0;
+
+		smb1351_get_prop(primary, POWER_SUPPLY_PROP_ONLINE, &online);
+		if (online)
+			mod_delayed_work(system_dfl_wq, &chip->work,
+					 msecs_to_jiffies(POLL_MS));
+		power_supply_put(primary);
+	}
+}
+
+static void smb1351_work(struct work_struct *work)
+{
+	struct smb1351 *chip = container_of(work, struct smb1351, work.work);
+
+	smb1351_update(chip);
+	power_supply_changed(chip->psy);
+}
+
+static void smb1351_external_power_changed(struct power_supply *psy)
+{
+	struct smb1351 *chip = power_supply_get_drvdata(psy);
+
+	mod_delayed_work(system_dfl_wq, &chip->work, msecs_to_jiffies(200));
+}
+
+static int smb1351_get_property(struct power_supply *psy,
+				enum power_supply_property psp,
+				union power_supply_propval *val)
+{
+	struct smb1351 *chip = power_supply_get_drvdata(psy);
+	unsigned int reg;
+	int ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		val->intval = chip->enabled;
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+	case POWER_SUPPLY_PROP_CHARGE_TYPE:
+		ret = regmap_read(chip->regmap, STATUS_4_REG, &reg);
+		if (ret)
+			return ret;
+		reg = FIELD_GET(STATUS_CHG_MASK, reg);
+		if (psp == POWER_SUPPLY_PROP_STATUS)
+			val->intval = reg ? POWER_SUPPLY_STATUS_CHARGING :
+					    POWER_SUPPLY_STATUS_NOT_CHARGING;
+		else
+			val->intval = reg == 1 ? POWER_SUPPLY_CHARGE_TYPE_TRICKLE :
+				      reg == 2 ? POWER_SUPPLY_CHARGE_TYPE_FAST :
+				      reg == 3 ? POWER_SUPPLY_CHARGE_TYPE_STANDARD :
+						 POWER_SUPPLY_CHARGE_TYPE_NONE;
+		break;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		ret = regmap_read(chip->regmap, STATUS_0_REG, &reg);
+		if (ret)
+			return ret;
+		if (reg & STATUS_INPUT_SUSPEND)
+			val->intval = 0;
+		else
+			val->intval = smb1351_icl_ma[min_t(unsigned int,
+				reg & STATUS_INPUT_CURRENT_LIMIT_MASK,
+				ARRAY_SIZE(smb1351_icl_ma) - 1)] * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		ret = regmap_read(chip->regmap, CHG_CURRENT_CTRL_REG, &reg);
+		if (ret)
+			return ret;
+		val->intval = chip->enabled ?
+			smb1351_fcc_ma[FIELD_GET(FAST_CHG_CURRENT_MASK, reg)] *
+			1000 : 0;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX:
+		val->intval = chip->fcc_ua;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX:
+		ret = regmap_read(chip->regmap, VFLOAT_REG, &reg);
+		if (ret)
+			return ret;
+		val->intval = VFLOAT_MIN_UV + (reg & VFLOAT_MASK) * VFLOAT_STEP_UV;
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		ret = regmap_read(chip->regmap, IRQ_A_REG, &reg);
+		if (ret)
+			return ret;
+		val->intval = reg & IRQ_HOT_COLD_HARD ?
+			POWER_SUPPLY_HEALTH_OVERHEAT : POWER_SUPPLY_HEALTH_GOOD;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static const enum power_supply_property smb1351_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_CHARGE_TYPE,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX,
+	POWER_SUPPLY_PROP_HEALTH,
+};
+
+static const struct power_supply_desc smb1351_psy_desc = {
+	.name = "smb1351-parallel",
+	.type = POWER_SUPPLY_TYPE_MAINS,
+	.properties = smb1351_props,
+	.num_properties = ARRAY_SIZE(smb1351_props),
+	.get_property = smb1351_get_property,
+	.external_power_changed = smb1351_external_power_changed,
+};
+
+static bool smb1351_writeable(struct device *dev, unsigned int reg)
+{
+	return reg <= 0x15 || (reg >= CMD_I2C_REG && reg <= 0x34);
+}
+
+static const struct regmap_config smb1351_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0x47,
+	.writeable_reg = smb1351_writeable,
+};
+
+static int smb1351_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct power_supply_config cfg = {};
+	struct smb1351 *chip;
+	int ret;
+
+	chip = devm_kzalloc(dev, sizeof(*chip), GFP_KERNEL);
+	if (!chip)
+		return -ENOMEM;
+	chip->dev = dev;
+	mutex_init(&chip->lock);
+	INIT_DELAYED_WORK(&chip->work, smb1351_work);
+
+	chip->regmap = devm_regmap_init_i2c(client, &smb1351_regmap);
+	if (IS_ERR(chip->regmap))
+		return PTR_ERR(chip->regmap);
+
+	chip->vfloat_uv = VFLOAT_LIMIT_UV;
+	device_property_read_u32(dev, "qcom,float-voltage-microvolt",
+				 &chip->vfloat_uv);
+	chip->vfloat_uv = clamp_t(u32, chip->vfloat_uv, VFLOAT_MIN_UV,
+				  VFLOAT_LIMIT_UV);
+	chip->fcc_ua = 1000000;
+	device_property_read_u32(dev, "qcom,max-charge-current-microamp",
+				 &chip->fcc_ua);
+	chip->fcc_ua = clamp_t(u32, chip->fcc_ua, 1000000, FCC_LIMIT_UA);
+	chip->min_input_ua = 1000000;
+	device_property_read_u32(dev, "qcom,min-input-current-microamp",
+				 &chip->min_input_ua);
+
+	chip->batt = devm_power_supply_get_by_reference(dev, "qcom,fuel-gauge");
+	if (IS_ERR(chip->batt))
+		return dev_err_probe(dev, PTR_ERR(chip->batt), "fuel gauge\n");
+	if (!chip->batt)
+		return dev_err_probe(dev, -EPROBE_DEFER, "fuel gauge\n");
+
+	ret = smb1351_hw_init(chip);
+	if (ret)
+		return ret;
+
+	cfg.drv_data = chip;
+	cfg.fwnode = dev_fwnode(dev);
+	chip->psy = devm_power_supply_register(dev, &smb1351_psy_desc, &cfg);
+	if (IS_ERR(chip->psy))
+		return PTR_ERR(chip->psy);
+
+	i2c_set_clientdata(client, chip);
+	mod_delayed_work(system_dfl_wq, &chip->work, msecs_to_jiffies(1000));
+
+	return 0;
+}
+
+static void smb1351_remove(struct i2c_client *client)
+{
+	struct smb1351 *chip = i2c_get_clientdata(client);
+	struct power_supply *primary;
+
+	cancel_delayed_work_sync(&chip->work);
+	primary = smb1351_primary(chip);
+	mutex_lock(&chip->lock);
+	smb1351_disable(chip, primary);
+	mutex_unlock(&chip->lock);
+	if (primary)
+		power_supply_put(primary);
+}
+
+static void smb1351_shutdown(struct i2c_client *client)
+{
+	struct smb1351 *chip = i2c_get_clientdata(client);
+
+	if (chip)
+		smb1351_suspend_input(chip, true);
+}
+
+static const struct of_device_id smb1351_of_match[] = {
+	{ .compatible = "qcom,smb1351-parallel" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, smb1351_of_match);
+
+static struct i2c_driver smb1351_driver = {
+	.driver = {
+		.name = "smb1351-charger",
+		.of_match_table = smb1351_of_match,
+	},
+	.probe = smb1351_probe,
+	.remove = smb1351_remove,
+	.shutdown = smb1351_shutdown,
+};
+module_i2c_driver(smb1351_driver);
+
+MODULE_DESCRIPTION("SMB1351 parallel charger");
+MODULE_LICENSE("GPL");
