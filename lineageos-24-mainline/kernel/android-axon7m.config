# Android (LineageOS 24 / Android 17) config fragment for the ZTE Axon 7 on
# mainline Linux 7.3.x. Merged on top of Nura's config-zte-axon7.aarch64
# (postmarketos/pmaports-local/device/testing/linux-zte-axon7/) by
# ../scripts/kernel-build.sh with scripts/kconfig/merge_config.sh.
#
# Source of the requirements: AOSP kernel/configs at android-17.0.0_r1.
# c/android-6.18/android-base.config is empty at that tag (only
# <kernel minlts="6.18.0"/>), so the list below follows
# b/android-6.12/android-base.config (Android 16) minus the options that only
# exist in the Android Common Kernel (ACK), which mainline does not have:
#   ASHMEM            -> memfd instead (sys.use_memfd=true, kernel has the
#                        SELinux memfd_class policy capability)
#   DM_DEFAULT_KEY    -> no metadata encryption; plain FBE (fscrypt v2)
#   NETFILTER_XT_MATCH_QUOTA2(_LOG) -> netd bandwidth alerts only (ACK patch later if needed)
#   UID_SYS_STATS, CPU_FREQ_TIMES   -> optional stats (eBPF time_in_state replaces the latter)
# Everything Android needs before /vendor is mounted is built in; drivers that
# load firmware from /vendor stay modules (loaded by init after first stage).

# --- Binder (C driver; binderfs mounted by init) ---
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# --- SELinux and audit (Nura has none: Yama/lockdown only) ---
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="landlock,yama,loadpin,safesetid,selinux,bpf"
# lockdown selects MODULE_SIG; Android does not use it
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
CONFIG_AUDIT=y
# CONFIG_SECURITY_DMESG_RESTRICT is not set

# --- Process / memory features used by init, lmkd, task profiles ---
CONFIG_PSI=y
CONFIG_MEMCG=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
# Android mounts cpuset (and memcg where used) as cgroup v1 controllers
# (cgroups.json); 7.3 splits v1 out: "cgroup: Unknown subsys name 'cpuset'"
CONFIG_CPUSETS_V1=y
CONFIG_MEMCG_V1=y
# ueventd handles all uevents; no kernel-spawned helper per event
# CONFIG_UEVENT_HELPER is not set
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# (SCHED_DEBUG no longer exists: always on upstream)
CONFIG_TASKSTATS=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_MEMFD_CREATE=y
CONFIG_SHMEM=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_MEMBARRIER=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_SWAP=y
# no SysV IPC on Android
# CONFIG_SYSVIPC is not set

# --- Power: wakelocks, no autosleep (Android's suspend HAL drives /sys/power) ---
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_WAKELOCKS_LIMIT=0
# CONFIG_PM_WAKELOCKS_GC is not set
# CONFIG_PM_AUTOSLEEP is not set

# --- eBPF (netd, bpfloader, time_in_state, gpu_mem) ---
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_TRACE_GPU_MEM=y

# --- Filesystems: erofs system/vendor, f2fs/ext4 data with FBE, FUSE ---
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_VERITY=y
CONFIG_UNICODE=y
CONFIG_QUOTA=y
CONFIG_QUOTACTL=y
CONFIG_QFMT_V2=y
CONFIG_FUSE_FS=y
CONFIG_FUSE_PASSTHROUGH=y
CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_INOTIFY_USER=y
CONFIG_FILE_LOCKING=y
CONFIG_AIO=y
CONFIG_FHANDLE=y

# --- Block: dynamic partitions (dm-linear), dm-verity, loop for APEX ---
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_BUFIO=y
CONFIG_DM_UEVENT=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y

# --- Crypto for FBE (AES-256-XTS + CTS) and IPsec/keystore ---
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CTS=y
CONFIG_CRYPTO_ADIANTUM=y
CONFIG_CRYPTO_HCTR2=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_XCBC=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_LZ4=y
CONFIG_KEYS=y

# --- Networking (netd, tethering, VPN, IPsec) ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_IPV6_MIP6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_VTI=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_MULTICAST=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_INET6_IPCOMP=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_INET_UDP_DIAG=y
CONFIG_NET_IPVTI=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_KEY=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_INTERFACE=y
CONFIG_XFRM_MIGRATE=y
CONFIG_XFRM_STATISTICS=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NET_NS=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_IFB=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_U32=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_SECMARK=y
CONFIG_NF_CONNTRACK_AMANDA=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_H323=y
CONFIG_NF_CONNTRACK_IRC=y
CONFIG_NF_CONNTRACK_NETBIOS_NS=y
CONFIG_NF_CONNTRACK_PPTP=y
CONFIG_NF_CONNTRACK_SANE=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_CT_PROTO_SCTP=y
# (NF_CT_PROTO_UDPLITE no longer exists upstream)
CONFIG_NF_NAT=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_HELPER=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_U32=y
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_SECMARK=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NF_TPROXY_IPV4=y
CONFIG_NF_TPROXY_IPV6=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_MATCH_ECN=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP_NF_MATCH_TTL=y
CONFIG_IP_NF_ARPTABLES=y
CONFIG_IP_NF_ARPFILTER=y
CONFIG_IP_NF_ARP_MANGLE=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
# CONFIG_IP6_NF_NAT is not set
# CONFIG_ANDROID_PARANOID_NETWORK is not set
CONFIG_L2TP=y
CONFIG_PPP=y
CONFIG_PPP_MPPE=y
CONFIG_PPPOL2TP=y

# --- Input, USB gadget (adb over FunctionFS, MTP, tethering) ---
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_UHID=y
CONFIG_HIDRAW=y
CONFIG_HID_GENERIC=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_MIDI=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
# USB_CONFIGFS_F_ACC / F_AUDIO_SRC (Android accessory, ACK only) do not exist upstream

# --- Graphics / media buffers ---
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
# (DMABUF_SYSFS_STATS was removed upstream)
CONFIG_DMA_CMA=y

# --- Display built in (M0b', 2026-11-10): recovery has no kernel modules,
# and its minui needs a DRM device: on the 24 bpp simple-framebuffer it fails
# ("gr_init: Only 4-byte pixel formats supported") and recovery SIGSEGVs in a
# loop before it enables adb. MDSS/DPU + DSI (14nm PHY) + the panel driver
# (Nura patch 0002) as in Nura, which loads them as modules. The clocks
# (mmcc), IOMMU, interconnect, GDSC and regulators they need are built in
# already. Adreno is part of msm.ko: it loads its firmware only when the GPU
# is first used (absent in recovery: KMS works without it). ---
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3HA3=y

# --- Firmware: Android's ueventd answers user-helper requests from
# /vendor/firmware, /vendor/firmware_mnt/image (modem partition) etc.
# (Nura has no user helper: there nothing answered and ath10k stalled.)
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set
# CONFIG_FW_CACHE is not set

# --- Usermode helpers: none (Android) ---
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""

# --- Debug / introspection that Android reads ---
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PROFILING=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_RTC_CLASS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# /sys/class/watchdog/watchdogN/{state,timeout,bootstatus,...}
CONFIG_WATCHDOG_SYSFS=y

# --- Smaller, faster builds for a boot image (Image must stay < ~48 MiB:
# the shim puts it at 0x80000000 and the splash is reserved from 0x83400000) ---
# CONFIG_RUST is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_MODULE_SIG is not set
# plain .ko for Android (Nura compresses with zstd, which also needs a zstd binary to install)
# CONFIG_MODULE_COMPRESS is not set
CONFIG_LOCALVERSION="-axon7m"
# CONFIG_LOCALVERSION_AUTO is not set
