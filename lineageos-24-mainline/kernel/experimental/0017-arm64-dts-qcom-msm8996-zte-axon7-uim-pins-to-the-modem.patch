From: axon7m bring-up
Subject: [PATCH] arm64: dts: qcom: msm8996-zte-axon7: UIM pins to the modem

Experiment: on mainline the modem reports "card error, no ATR" for both
SIM slots. The UIM data, clock and reset pins (UIM1 gpio109-111, UIM2
gpio105-107) are in GPIO mode, output low; only the card-present pins
(108, 112) and uim_batt (113) have their UIM function. Mux all of them to
uim1/uim2/uim_batt with a TLMM pinctrl hog so the modem's UIM controllers
own them when the modem boots.
---
diff --git a/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts b/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts
index 2a45b9e2d..210b631e5 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts
@@ -1548,6 +1548,38 @@ &tlmm {
 	/* blsp_spi5 (fingerprint) is owned by TZ */
 	gpio-reserved-ranges = <81 4>;
 
+	/*
+	 * SIM slots: data, clock and reset of both UIM controllers were left
+	 * in GPIO mode (output low) while only the card-present pins had the
+	 * UIM function; the modem then reports "no ATR" on both slots. Hand
+	 * all UIM pins to the modem's UIM controllers before it boots.
+	 */
+	pinctrl-names = "default";
+	pinctrl-0 = <&uim_default>;
+
+	uim_default: uim-default-state {
+		uim1-pins {
+			pins = "gpio109", "gpio110", "gpio111", "gpio112";
+			function = "uim1";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		uim2-pins {
+			pins = "gpio105", "gpio106", "gpio107", "gpio108";
+			function = "uim2";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		uim-batt-pins {
+			pins = "gpio113";
+			function = "uim_batt";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
 	nfc_default: nfc-default-state {
 		pins = "gpio12", "gpio96";
 		function = "gpio";
