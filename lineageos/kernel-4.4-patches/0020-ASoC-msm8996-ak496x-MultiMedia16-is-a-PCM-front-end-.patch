From 2d81b2fa92a837dcd84a31e360af640f7ac13cb7 Mon Sep 17 00:00:00 2001
From: axon7-build <axon7-build@localhost>
Date: Sun, 8 Nov 2026 08:48:51 +0000
Subject: [PATCH 20/20] ASoC: msm8996-ak496x: MultiMedia16 is a PCM front end
 on 4.4 (Compress9 oopsed in msm_compr_new)

los21: the card registered, then msm_compr_new() dereferenced the missing
compress runtime of the Compress9 link (MultiMedia16 has no compress_new
in the 4.4 msm-dai-fe). The link uses msm-pcm-dsp-noirq as msm8996.c does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FVN6i29oeF8XZDRKkkCQqG
Change-Id: I99edca8106fc631cbea46a1bff80b044eb096a6f
---
 sound/soc/msm/msm8996-ak496x.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/sound/soc/msm/msm8996-ak496x.c b/sound/soc/msm/msm8996-ak496x.c
index 96ced527219a..56da9e7c30ae 100644
--- a/sound/soc/msm/msm8996-ak496x.c
+++ b/sound/soc/msm/msm8996-ak496x.c
@@ -2669,12 +2669,19 @@ static struct snd_soc_dai_link msm8996_common_dai_links[] = {
 		.be_id = MSM_FRONTEND_DAI_MULTIMEDIA15,
 	},
 	{
+		/*
+		 * 4.4: MultiMedia16 is a PCM front end (ULL NOIRQ_2 in msm8996.c),
+		 * not a compress DAI; with msm-compress-dsp, msm_compr_new() ran
+		 * without a compress runtime and oopsed. Same slot, so the PCM
+		 * device numbers stay as they were.
+		 */
 		.name = "MSM8996 Compress9",
 		.stream_name = "Compress9",
 		.cpu_dai_name = "MultiMedia16",
-		.platform_name = "msm-compress-dsp",
+		.platform_name = "msm-pcm-dsp-noirq",
 		.dynamic = 1,
 		.dpcm_playback = 1,
+		.dpcm_capture = 1,
 		.trigger = {SND_SOC_DPCM_TRIGGER_POST,
 			 SND_SOC_DPCM_TRIGGER_POST},
 		.codec_dai_name = "snd-soc-dummy-dai",
-- 
