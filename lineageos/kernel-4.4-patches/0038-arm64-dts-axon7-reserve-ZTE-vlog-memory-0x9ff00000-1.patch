From a7355466a51ad7852f99d915cec441371b3e2f90 Mon Sep 17 00:00:00 2001
From: axon7-build <axon7-build@localhost>
Date: Mon, 9 Nov 2026 08:38:54 +0000
Subject: [PATCH] arm64: dts: axon7: reserve ZTE vlog memory (0x9ff00000, 1 MB,
 no-map)

ZTE keeps this region out of Linux (msm8996-vendor.dtsi); the bootloader
passes it to another writer through vendor IMEM (vlog_memory_addr/size).
Without the reservation Linux may hand that memory out while it is written.

Change-Id: Ie176fc4348cd96564b917076df02716a4841ac70
---
 arch/arm/boot/dts/qcom/msm8996-zte-axon7-common.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/msm8996-zte-axon7-common.dtsi b/arch/arm/boot/dts/qcom/msm8996-zte-axon7-common.dtsi
index 6924c7133ae6..73764f51f262 100644
--- a/arch/arm/boot/dts/qcom/msm8996-zte-axon7-common.dtsi
+++ b/arch/arm/boot/dts/qcom/msm8996-zte-axon7-common.dtsi
@@ -49,6 +49,16 @@
 			reg = <0x0 0xbfc00000 0x0 0x00400000>;
 			no-map;
 		};
+
+		/*
+		 * ZTE "vlog": 1 MB that the bootloader hands to another
+		 * writer (address and size in vendor IMEM, vlog_memory_*);
+		 * ZTE keeps it out of Linux (msm8996-vendor.dtsi), so do we.
+		 */
+		vlog_mem: vlog_mem_region@9ff00000 {
+			reg = <0x0 0x9ff00000 0x0 0x100000>;
+			no-map;
+		};
 	};
 };
 
