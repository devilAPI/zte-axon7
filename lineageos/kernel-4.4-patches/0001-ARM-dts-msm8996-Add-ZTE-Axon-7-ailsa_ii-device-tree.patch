+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ */
+
+/*
+ * ZTE Axon 7 (ailsa_ii): ZTE's changes to the shared msm8996 SoC and PMIC
+ * dtsi files.
+ *
+ * ZTE's 3.18 kernel edited msm8996.dtsi, msm8996-pinctrl.dtsi,
+ * msm-pmi8994.dtsi, msm-pm8994.dtsi, msm8996-regulator.dtsi,
+ * msm8996-camera.dtsi, msm8996-blsp.dtsi and msm8996-pm.dtsi directly.
+ * Here those changes are applied as overrides, so the shared 4.4 files stay
+ * untouched. Each section names the file it overrides. Nodes for parts that
+ * have no driver in this tree yet (AK4961 codec, AK4490 DAC, AK8157,
+ * ISL98608) are kept so the board description is complete; they do not
+ * probe until the drivers are ported.
+ */
+
+/* ---- msm8996.dtsi ---- */
+
+/ {
+	aliases {
+		i2c3 = &i2c_3;
+	};
+
+	reserved-memory {
+		/*
+		 * No HDMI on this board. ZTE shrank this region to 0 bytes;
+		 * drop it instead and free the 36 MB.
+		 */
+		/delete-node/ cont_splash_mem_hdmi@bdd00000;
+
+		/* Same region ZTE's 3.18 kernel used for ramoops */
+		ramoops_mem: ramoops_mem@92900000 {
+			label = "ramoops_mem";
+			reg = <0x0 0x92900000 0x0 0x00100000>;
+		};
+	};
+};
+
+&mdss_fb2 {
+	/delete-node/ qcom,cont-splash-memory;
+};
+
+&mdss_hdmi_tx {
+	status = "disabled";
+};
+
+&mdss_hdmi_pll {
+	status = "disabled";
+};
+
+&soc {
+	i2c_3: i2c@7577000 { /* BLSP1 QUP3 */
+		compatible = "qcom,i2c-msm-v2";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reg = <0x7577000 0x1000>;
+		reg-names = "qup_phys_addr";
+		interrupt-names = "qup_irq";
+		interrupts = <0 97 0>;
+		dmas = <&dma_blsp1 16 64 0x20000020 0x20>,
+			<&dma_blsp1 17 32 0x20000020 0x20>;
+		dma-names = "tx", "rx";
+		qcom,master-id = <86>;
+		qcom,clk-freq-out = <400000>;
+		qcom,clk-freq-in = <19200000>;
+		clock-names = "iface_clk", "core_clk";
+		clocks = <&clock_gcc clk_gcc_blsp1_ahb_clk>,
+			<&clock_gcc clk_gcc_blsp1_qup3_i2c_apps_clk>;
+		pinctrl-names = "i2c_active", "i2c_sleep";
+		pinctrl-0 = <&i2c_3_active>;
+		pinctrl-1 = <&i2c_3_sleep>;
+
+		/* AKM AK4490 Hi-Fi DAC (no driver in this tree yet) */
+		ak4490@10 {
+			compatible = "ak4490";
+			reg = <0x10>;
+			ak4490,ldoen-gpio = <&tlmm 93 0>;
+			ak4490,pdn-gpio = <&pmi8994_gpios 1 0>;
+			qcom,isl-sw-pwr-gpio = <&pmi8994_gpios 10 0>;
+			ak4490,isl-ldo-pwr-gpio = <&pmi8994_mpps 4 0>;
+			ak4490,hifi_sel_gpio = <&pm8994_mpps 2 0>;
+			ak4490,hifi_mute_gpio = <&pm8994_mpps 4 0>;
+			ak4490,hifi_pop_gpio = <&tlmm 74 0>;
+		};
+
+		/* Intersil ISL98608 DAC power supply (no driver yet) */
+		isl98608@29 {
+			compatible = "isl98608";
+			reg = <0x29>;
+		};
+	};
+
+	/*
+	 * The WCD9335 is not fitted: the slimbus codec is an AKM AK4961.
+	 * Its interrupt line (gpio 54) goes to the AK49xx irq controller.
+	 */
+	ak49xx_intc: ak49xx-irq {
+		compatible = "akm,ak49xx-irq";
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-parent = <&tlmm>;
+		qcom,gpio-connect = <&tlmm 54 0>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&wcd_intr_default>;
+	};
+
+	sound-9335 {
+		status = "disabled";
+	};
+
+	/* AK4961 machine driver (sound/soc/msm/msm8996-ak496x.c, not ported) */
+	sound-ak4961 {
+		compatible = "qcom,msm8996-asoc-snd-ak4961";
+		qcom,model = "msm8996-ak4961-snd-card";
+		qcom,audio-routing =
+			"RX_BIAS", "MCLK",
+			"AK4490_RX_BIAS", "MCLK";
+		qcom,rcv-sw-gpio = <&pm8994_gpios 13 0>;
+		qcom,ak4961-mclk-clk-freq = <9600000>;
+		asoc-platform = <&pcm0>, <&pcm1>, <&pcm2>, <&voip>, <&voice>,
+				<&loopback>, <&compress>, <&hostless>,
+				<&afe>, <&lsm>, <&routing>, <&cpe>, <&compr>,
+				<&pcmnoirq>;
+		asoc-platform-names = "msm-pcm-dsp.0", "msm-pcm-dsp.1",
+				"msm-pcm-dsp.2", "msm-voip-dsp",
+				"msm-pcm-voice", "msm-pcm-loopback",
+				"msm-compress-dsp", "msm-pcm-hostless",
+				"msm-pcm-afe", "msm-lsm-client",
+				"msm-pcm-routing", "msm-cpe-lsm",
+				"msm-compr-dsp", "msm-pcm-dsp-noirq";
+		asoc-cpu = <&dai_pri_auxpcm>, <&dai_sec_auxpcm>, <&dai_hdmi>,
+				<&dai_mi2s>, <&dai_mi2s_quat>,
+				<&sb_0_rx>, <&sb_0_tx>, <&sb_1_rx>, <&sb_1_tx>,
+				<&sb_2_rx>, <&sb_2_tx>, <&sb_3_rx>, <&sb_3_tx>,
+				<&sb_4_rx>, <&sb_4_tx>, <&sb_5_tx>,
+				<&afe_pcm_rx>, <&afe_pcm_tx>,
+				<&afe_proxy_rx>, <&afe_proxy_tx>,
+				<&incall_record_rx>, <&incall_record_tx>,
+				<&incall_music_rx>, <&incall_music2_rx>,
+				<&sb_5_rx>;
+		asoc-cpu-names = "msm-dai-q6-auxpcm.1", "msm-dai-q6-auxpcm.2",
+				"msm-dai-q6-hdmi.8", "msm-dai-q6-mi2s.2",
+				"msm-dai-q6-mi2s.3",
+				"msm-dai-q6-dev.16384", "msm-dai-q6-dev.16385",
+				"msm-dai-q6-dev.16386", "msm-dai-q6-dev.16387",
+				"msm-dai-q6-dev.16388", "msm-dai-q6-dev.16389",
+				"msm-dai-q6-dev.16390", "msm-dai-q6-dev.16391",
