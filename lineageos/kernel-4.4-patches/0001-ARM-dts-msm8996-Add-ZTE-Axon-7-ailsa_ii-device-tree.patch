+ */
+&cam_sensor_rear2_active {
+	mux {
+		pins = "gpio131";
+	};
+
+	config {
+		pins = "gpio131";
+	};
+};
+
+&cam_sensor_rear2_suspend {
+	mux {
+		pins = "gpio131";
+	};
+
+	config {
+		pins = "gpio131";
+	};
+};
+
+&pcie1_clkreq_default {
+	mux {
+		/delete-property/ pins;
+	};
+
+	config {
+		/delete-property/ pins;
+	};
+};
+
+&pcie1_clkreq_sleep {
+	mux {
+		/delete-property/ pins;
+	};
+
+	config {
+		/delete-property/ pins;
+	};
+};
+
+/* ---- msm-pm8994.dtsi ---- */
+
+&pm8994_rtc {
+	/* allow the RTC alarm to power the phone on (power-off alarm) */
+	qcom,qpnp-rtc-alarm-pwrup = <1>;
+};
+
+/* ---- msm-pmi8994.dtsi ---- */
+
+&pmi8994_charger {
+	qcom,iterm-ma = <150>;
+	qcom,fastchg-current-ma = <3000>;
+	qcom,float-voltage-mv = <4400>;
+	qcom,fastchg-current-comp = <900>;
+	qcom,float-voltage-comp = <10>;
+	qcom,resume-delta-mv = <100>;
+	qcom,parallel-usb-min-current-ma = <1000>;
+	qcom,charge-unknown-battery;
+	qcom,bmd-pin-src = "bpd_thm";
+	qcom,charging-timeout-mins = <768>;
+	qcom,precharging-timeout-mins = <24>;
+	/* ZTE smbcharger extensions; ignored by the 4.4 driver */
+	qcom,vchg-adc-channel-id = <3>;
+	qcom,vchg_sns-vadc = <&pmi8994_vadc>;
+	qcom,apsd_rerun_config_enable;
+	qcom,design_capacity = <3200>;
+};
+
+&pmi8994_fg {
+	qcom,resume-soc = <99>;
+	qcom,fg-iterm-ma = <150>;
+	qcom,thermal-coefficients = [EC 85 75 4A FC 35];
+	qcom,fg-chg-iterm-ma = <150>;
+	qcom,fg-cc-cv-threshold-mv = <4390>;
+	qcom,fg-cutoff-voltage-mv = <3400>;
+	qcom,hold-soc-while-full;
+	qcom,fg-delta-soc = <2>;
+	qcom,vbat-estimate-diff-mv = <150>;
+};
+
+/*
+ * LRA haptics. ZTE's 3.18 values, written for the 4.4 qpnp-haptics
+ * (leds-qpnp-haptics) binding.
+ */
+&pmi8994_haptics {
+	qcom,play-mode = "buffer";
+	qcom,wave-play-rate-us = <4255>;
+	qcom,wave-shape = "sine";
+	qcom,vmax-mv = <2668>;
+	qcom,wave-samples = <0x33 0x33 0x33 0x33 0x33 0x33 0x33 0x33>;
+	qcom,lra-high-z = "opt1";
+	qcom,lra-auto-res-mode = "qwd";
+	qcom,lra-res-cal-period = <4>;
+};
+
+&red_led {
+	qcom,start-idx = <0>;
+	qcom,idx-len = <10>;
+	qcom,ramp-step-ms = <10>;
+	qcom,lut-flags = <31>;
+	qcom,pause-lo = <2200>;
+	qcom,pause-hi = <1300>;
+	qcom,duty-pcts = [00 05 0A 0F 14 19 1E 23 28 2D];
+	qcom,max-current = <6>;
+	qcom,use-blink;
+};
+
+&green_led {
+	qcom,start-idx = <0>;
+	qcom,idx-len = <10>;
+	qcom,ramp-step-ms = <10>;
+	qcom,lut-flags = <31>;
+	qcom,pause-lo = <2200>;
+	qcom,pause-hi = <1300>;
+	qcom,duty-pcts = [00 05 0A 0F 14 19 1E 23 28 2D];
+	qcom,max-current = <6>;
+	linux,default-trigger = "none";
+	qcom,use-blink;
+};
+
+&blue_led {
+	qcom,start-idx = <0>;
+	qcom,idx-len = <10>;
+	qcom,ramp-step-ms = <10>;
+	qcom,lut-flags = <31>;
+	qcom,pause-lo = <2200>;
+	qcom,pause-hi = <1300>;
+	qcom,duty-pcts = [00 05 0A 0F 14 19 1E 23 28 2D];
+	qcom,max-current = <6>;
+	linux,default-trigger = "none";
+};
+
+/* AMOLED panel: backlight is set over DCS, the WLED is unused */
+&pmi8994_wled {
+	status = "disabled";
+};
+
+/* ZTE removed the flash "switch" LED (no camera switch on this board) */
+/delete-node/ &pmi8994_switch;
+
+/* ---- msm8996-regulator.dtsi ---- */
+
+&pm8994_l17 { /* rear camera AVDD */
+	regulator-min-microvolt = <2900000>;
+	regulator-max-microvolt = <2900000>;
+	qcom,init-voltage = <2900000>;
+};
+
+/* ---- msm8996-camera.dtsi ---- */
+
+&soc {
+	qcom,csiphy@a34000 {
+		qcom,clock-rates = <0 0 0 266670000 0 0 200000000 0>;
+	};
+
+	qcom,csid@a30000 {
+		qcom,clock-rates = <0 0 0 320000000 0 0 0 0 0 0>;
+	};
+};
+
+&i2c_freq_400Khz {
+	qcom,hw-scl-stretch-en = <1>;
+};
+
+/* ---- LineageOS ---- */
+
+&soc {
+	/* pstore: last kernel log in /sys/fs/pstore after a reboot */
+	ramoops {
+		compatible = "ramoops";
+		status = "ok";
+		memory-region = <&ramoops_mem>;
+
+		console-size = <0x0 0x00080000>;
+		pmsg-size = <0x0 0x00040000>;
+		record-size = <0x0 0x00008000>;
+		ftrace-size = <0x0 0x00020000>;
+	};
+};
+
+&firmware {
+	android {
+		/* system and vendor are mounted from the ramdisk fstab */
+		/delete-node/ fstab;
+		/delete-node/ vbmeta;
+	};
+};
diff --git a/arch/arm/boot/dts/qcom/msm8996-zte-axon7-touch.dtsi b/arch/arm/boot/dts/qcom/msm8996-zte-axon7-touch.dtsi
new file mode 100644
index 000000000000..b7a4a461d481
--- /dev/null
+++ b/arch/arm/boot/dts/qcom/msm8996-zte-axon7-touch.dtsi
@@ -0,0 +1,115 @@
+/* Copyright (c) 2015, The Linux Foundation. All rights reserved.
+ * Copyright (C) 2016 ZTE Corporation.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 and
+ * only version 2 as published by the Free Software Foundation.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ */
+
+/*
+ * ZTE Axon 7 touch screen, capacitive keys and volume keys (from the ZTE
+ * 3.18 kernel, touch-key-backlight-ailsa_ii.dtsi). BLSP2 QUP6 (i2c_12) is
+ * already defined in msm8996.dtsi in 4.4.
+ *
+ * The Synaptics node uses the binding of the in-tree 4.4 synaptics_dsx
+ * driver, which matches ZTE's. The capacitive keys are 0D buttons of the
+ * touch controller (synaptics,cap-button-codes: back, home, app switch).
+ */
+
+&soc {
+	i2c@75ba000 {
+		synaptics@20 {
+			compatible = "synaptics,dsx-i2c";
+			reg = <0x20>;
+			interrupt-parent = <&tlmm>;
+			interrupts = <125 0x2008>;
+			vdd_ana-supply = <&pm8994_l14>;
+			vcc_i2c-supply = <&pm8994_l22>;
+			synaptics,pwr-reg-name = "vdd_ana";
+			synaptics,bus-reg-name = "vcc_i2c";
+			pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
+			pinctrl-0 = <&ts_active>;
+			pinctrl-1 = <&ts_suspend>;
+			synaptics,reset-gpio = <&tlmm 89 0x00>;
+			synaptics,irq-gpio = <&tlmm 125 0x2008>;
+			synaptics,irq-on-state = <0>;
+			synaptics,irq-flags = <0x2008>; /* IRQF_ONESHOT | IRQF_TRIGGER_LOW */
+			synaptics,power-delay-ms = <100>;
+			synaptics,reset-delay-ms = <100>;
+			synaptics,reset-on-state = <0>;
+			synaptics,reset-active-ms = <20>;
+			synaptics,cap-button-codes = <158 102 187>;
+		};
+
+		/* NDT force sensor (ZTE ndt_stress driver, not ported yet) */
+		ndt_stress@50 {
+			compatible = "ndt,stress-i2c";
+			reg = <0x50>;
+			interrupt-parent = <&tlmm>;
+			interrupts = <122 0x2008>;
+			pinctrl-names = "default", "sleep";
+			pinctrl-0 = <&ndt_power_active &ndt_int_active
+				     &ndt_reset_active>;
+			pinctrl-1 = <&ndt_power_suspend &ndt_int_suspend
+				     &ndt_reset_suspend>;
+			ndt,irq-gpio = <&tlmm 122 0x00>;
+			ndt,irq-on-state = <0>;
+			ndt,irq-flags = <0x2008>;
+			ndt,power-gpio = <&tlmm 69 0x00>;
+			ndt,power-on-state = <1>;
+			ndt,power-delay-ms = <20>;
+			ndt,reset-gpio = <&tlmm 121 0x00>;
+			ndt,reset-on-state = <0>;
+			ndt,reset-active-ms = <10>;
+			ndt,reset-delay-ms = <10>;
+		};
+	};
+
+	/*
+	 * ZTE virtual-key map (gen_vkeys_zte.c, not ported). Not needed while
+	 * the keys come in as touch controller 0D buttons.
+	 */
+	gen-vkeys {
+		compatible = "zte,gen-vkeys";
+		label = "synaptics_dsx";
+		zte,disp-maxy_px = <2560>;
+		zte,disp-maxy_mm = <1210>;	/* 0.1 mm */
+		zte,disp-maxx_mm = <680>;	/* 0.1 mm */
+		zte,x1 = <205>;
+		zte,x2 = <345>;
+		zte,x3 = <485>;
+		zte,lcd_offset = <25>;
+		zte,y_max_offset = <150>;
+		zte,dx = <100>;
+		zte,key-codes = <158 102 187>;
+	};
+
+	/* PM8994 GPIO 2 is the lower key (volume down), GPIO 3 the upper one */
+	gpio_keys {
+		compatible = "gpio-keys";
+		input-name = "gpio-keys";
+
+		vol_up {
+			label = "volume_up";
+			gpios = <&pm8994_gpios 2 0x1>;
+			linux,input-type = <1>;
+			linux,code = <114>;	/* KEY_VOLUMEDOWN */
+			gpio-key,wakeup;
+			debounce-interval = <15>;
+		};
+
+		vol_down {
+			label = "volume_down";
+			gpios = <&pm8994_gpios 3 0x1>;
+			linux,input-type = <1>;
+			linux,code = <115>;	/* KEY_VOLUMEUP */
+			gpio-key,wakeup;
+			debounce-interval = <15>;
+		};
+	};
+};
diff --git a/arch/arm/boot/dts/qcom/msm8996-zte-axon7-typec.dtsi b/arch/arm/boot/dts/qcom/msm8996-zte-axon7-typec.dtsi
new file mode 100644
index 000000000000..9e3b81966632
--- /dev/null
+++ b/arch/arm/boot/dts/qcom/msm8996-zte-axon7-typec.dtsi
@@ -0,0 +1,137 @@
+/*
+ * Copyright (c) 2015 The Linux Foundation. All rights reserved.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 and
+ * only version 2 as published by the Free Software Foundation.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ */
+
+/* For Reference
+ * GPIO_ACTIVE_HIGH = (0 << 0)
+ * GPIO_ACTIVE_LOW  = (1 << 0)
+ * GPIO_OPEN_DRAIN  = (1 << 1)
+ * GPIO_OPEN_SOURCE = (1 << 2)
+ */
+
+/*
+ * ZTE Axon 7 USB Type-C (from the ZTE 3.18 kernel, zte-usb-type-c.dtsi).
+ * Boards carry either a TI HD3SS3220 or a Pericom PI5USB302 CC/mux
+ * controller on BLSP2 QUP1; both are described and only the fitted one
+ * answers on the bus.
+ */
+
+/* Segment 1: Type-C Chips main DTS config */
+&i2c_7 {
+
+	/* TI HD3SS3220 chip */
+	hd3ss3220@47 { /* slave id 0x67(ADDR Pin:H) or 0x47(ADDR Pin:L) */
+		compatible = "ti,hd3ss3220";
+		reg = <0x47>;
+
+		/* PM GPIO ( 14 ) Irq Line */
+		hd3ss,irq_gpio = <&pm8994_gpios 14 0x2>;
+
+		/* PM MPP ( 05 ) EN_CC/MUX */
+		hd3ss,en_cc_gpio = <&pm8994_mpps 5 0x0>;
+		/* PM MPP ( 07 ) Re-drive */
+		hd3ss,re_drv_gpio = <&pm8994_mpps 7 0x0>;
+
+		/* PMI GPIO ( 08 ) vreg 5V */
+		hd3ss,vreg_5v_gpio = <&pmi8994_gpios 8 0x0>;
+		/* PMI GPIO ( 09 ) vreg 3V3 */
+		hd3ss,vreg_3v3_gpio = <&pmi8994_gpios 9 0x0>;
+	};
+
+	/* Pericom PI5USB302 chip */
+	pi5usb302@d { /* slave id 0x2d(ADDR Pin:H) or 0x0d(ADDR Pin:L) */
+		compatible = "pericom,pi5usb302";
+		reg = <0x0d>;
+
+		/* PM GPIO ( 14 ) Irq Line */
+		pi5usb,irq_gpio = <&pm8994_gpios 14 0x2>;
+
+		/* PM MPP ( 05 ) EN_CC/MUX */
+		pi5usb,en_cc_gpio = <&pm8994_mpps 5 0x0>;
+		/* PM MPP ( 07 ) Re-drive */
+		pi5usb,re_drv_gpio = <&pm8994_mpps 7 0x0>;
+
+		/* PMI GPIO ( 08 ) vreg 5V */
+		pi5usb,vreg_5v_gpio = <&pmi8994_gpios 8 0x0>;
+		/* PMI GPIO ( 09 ) vreg 3V3 */
+		pi5usb,vreg_3v3_gpio = <&pmi8994_gpios 9 0x0>;
+	};
+
+};
+
+/* Segment 2: Type-C related PM MPP config */
+&pm8994_mpps {
+
+	mpp@a400 { /* MPP 5 */
+		/* type-c cc en and 3.0 mux enable */
+		qcom,mode = <1>;		/* Digital output */
+		qcom,output-type = <0>;	/* CMOS logic */
+		qcom,vin-sel = <2>;		/* QPNP_PIN_VIN0 */
+		qcom,src-sel = <0>;		/* QPNP_PIN_SEL_FUNC_CONSTANT */
+		qcom,invert = <1>;		/* MPP Enable */
+		qcom,master-en = <1>;	/* Enable */
+		status = "okay";
+	};
+
+	mpp@a600 { /* MPP 7 */
+		/* type-c ssusb re-drive enable */
+		qcom,mode = <1>;		/* Digital output */
+		qcom,output-type = <0>;	/* CMOS logic */
+		qcom,vin-sel = <2>;		/* QPNP_PIN_VIN0 */
+		qcom,src-sel = <0>;		/* QPNP_PIN_SEL_FUNC_CONSTANT */
+		qcom,invert = <1>;		/* MPP Enable */
+		qcom,master-en = <1>;	/* Enable */
+		status = "okay";
+	};
+
+};
+
+/* Segment 3: Type-C related PM GPIO config */
+&pm8994_gpios {
+
+	gpio@cd00 { /* GPIO 14 */
+		/* TYPEC_INT_N CC Interrupt*/
+		qcom,mode = <0>;	/* Digital input */
+		qcom,pull = <5>;	/* No Pull */
+		qcom,vin-sel = <2>;
+		qcom,master-en = <1>;	/* Enable */
+		status = "okay";
+	};
+};
+
+/* Segment 4: Type-C related PMI GPIO config */
+&pmi8994_gpios {
+
+	gpio@c700 { /* GPIO 8 */
+		/* CC VCONN VREG 5V */
+		qcom,mode = <1>;		/* Digital output */
+		qcom,output-type = <0>;	/* MOS logic */
+		qcom,invert = <1>;		/* Output high initially */
+		qcom,vin-sel = <0>;		/* VPH_PWR */
+		qcom,src-sel = <0>;
+		qcom,master-en = <1>;	/* Enable */
+		status = "okay";
+		};
+
+	gpio@c800 { /* GPIO 9 */
+		/* CC Chip VREG 3V3 */
+		qcom,mode = <1>;		/* Digital output */
+		qcom,output-type = <0>;	/* MOS logic */
+		qcom,invert = <1>;		/* Output high */
+		qcom,vin-sel = <0>;		/* VPH_PWR */
+		qcom,src-sel = <0>;
+		qcom,master-en = <1>;	/* Enable */
+		status = "okay";
+		};
+
+};
+
diff --git a/arch/arm/boot/dts/qcom/msm8996-zte-axon7.dtsi b/arch/arm/boot/dts/qcom/msm8996-zte-axon7.dtsi
new file mode 100644
index 000000000000..4bd80fe49cc5
--- /dev/null
+++ b/arch/arm/boot/dts/qcom/msm8996-zte-axon7.dtsi
@@ -0,0 +1,809 @@
+/* Copyright (c) 2015-2019, The Linux Foundation. All rights reserved.
+ * Copyright (C) 2016 ZTE Corporation.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 and
+ * only version 2 as published by the Free Software Foundation.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ */
+
+/*
+ * ZTE Axon 7 (A2017G, ailsa_ii) board.
+ *
+ * ZTE built the Axon 7 board file by editing the CAF msm8996-mtp.dtsi of
+ * their 3.18 kernel. This file is the 4.4 CAF msm8996-mtp.dtsi with the same
+ * ZTE edits applied, so it can be compared with both. Left out from the MTP
+ * file: the overrides for CAF reference panels and the TDM audio interfaces
+ * (not used on this board), and the WCD9335 sound card (no WCD9335 here).
+ * ZTE's changes to the shared SoC/PMIC files are in
+ * msm8996-zte-axon7-common.dtsi.
+ */
+
+#include <dt-bindings/clock/msm-clocks-8996.h>
+#include "msm8996-camera-sensor-zte-axon7.dtsi"
+#include "msm8996-zte-axon7-typec.dtsi"
+#include "msm8996-wsa881x.dtsi"
+
+&vendor {
+	bluetooth: bt_qca6174 {
+		compatible = "qca,qca6174";
+		qca,bt-reset-gpio = <&pm8994_gpios 19 0>; /* BT_EN */
+		qca,bt-vdd-core-supply = <&pm8994_s3>;
+		qca,bt-vdd-pa-supply = <&rome_vreg>;
+		qca,bt-vdd-io-supply = <&pm8994_s4>;
+		qca,bt-vdd-xtal-supply = <&pm8994_l30>;
+		qca,bt-chip-pwd-voltage-level = <1300000 1300000>;
+		qca,bt-vdd-io-voltage-level = <1800000 1800000>;
+		qca,bt-vdd-xtal-voltage-level = <1800000 1800000>;
+	};
+};
+
+&ufs_ice {
+        status = "ok";
+};
+
+&sdcc1_ice {
+        status = "ok";
+};
+
+&ufsphy1 {
+	status = "ok";
+};
+
+&ufs1 {
+	status = "ok";
+};
+
+&uartblsp2dm1 {
+	status = "ok";
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart_console_active>;
+
+};
+
+&sdhc_1 {
+	vdd-supply = <&pm8994_l20>;
+	qcom,vdd-voltage-level = <2950000 2950000>;
+	qcom,vdd-current-level = <200 570000>;
+
+	vdd-io-supply = <&pm8994_s4>;
+	qcom,vdd-io-always-on;
+	qcom,vdd-io-voltage-level = <1800000 1800000>;
+	qcom,vdd-io-current-level = <110 325000>;
+
+	pinctrl-names = "active", "sleep";
+	pinctrl-0 = <&sdc1_clk_on &sdc1_cmd_on &sdc1_data_on &sdc1_rclk_on>;
+	pinctrl-1 = <&sdc1_clk_off &sdc1_cmd_off &sdc1_data_off &sdc1_rclk_off>;
+
+	qcom,clk-rates = <400000 20000000 25000000 50000000 96000000 192000000 384000000>;
+	qcom,ice-clk-rates = <300000000 150000000>;
+	qcom,nonremovable;
+	qcom,bus-speed-mode = "HS400_1p8v", "HS200_1p8v", "DDR_1p8v";
+
+	status = "ok";
+};
+
+&sdhc_2 {
+	vdd-supply = <&pm8994_l21>;
+	qcom,vdd-voltage-level = <2950000 2950000>;
+	qcom,vdd-current-level = <200 800000>;
+
+	vdd-io-supply = <&pm8994_l13>;
+	qcom,vdd-io-voltage-level = <1800000 2950000>;
+	qcom,vdd-io-current-level = <200 22000>;
+
+	pinctrl-names = "active", "sleep";
+	pinctrl-0 = <&sdc2_clk_on  &sdc2_cmd_on &sdc2_data_on &sdc2_cd_on>;
+	pinctrl-1 = <&sdc2_clk_off &sdc2_cmd_off &sdc2_data_off &sdc2_cd_off>;
+
+	qcom,clk-rates = <400000 20000000 25000000 50000000 100000000 200000000>;
+	qcom,bus-speed-mode = "SDR12", "SDR25", "SDR50", "DDR50", "SDR104";
+
+	cd-gpios = <&tlmm 95 0x0>;
+
+	status = "ok";
+};
+
+&pm8994_vadc {
+	chan@5 {
+		label = "vcoin";
+		reg = <5>;
+		qcom,decimation = <0>;
+		qcom,pre-div-channel-scaling = <1>;
+		qcom,calibration-type = "absolute";
+		qcom,scale-function = <0>;
+		qcom,hw-settle-time = <0>;
+		qcom,fast-avg-setup = <0>;
+	};
+
+	chan@7 {
+		label = "vph_pwr";
+		reg = <7>;
+		qcom,decimation = <0>;
+		qcom,pre-div-channel-scaling = <1>;
+		qcom,calibration-type = "absolute";
+		qcom,scale-function = <0>;
+		qcom,hw-settle-time = <0>;
+		qcom,fast-avg-setup = <0>;
