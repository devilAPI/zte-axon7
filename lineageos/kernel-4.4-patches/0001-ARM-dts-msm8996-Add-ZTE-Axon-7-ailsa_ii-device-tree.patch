+&soc {
+	/*
+	 * 3 V panel supply, switched by gpio 40 ("lcd 3v vsp"). ZTE's 3.18
+	 * mdss driver toggled the gpio itself (zte,lcd-3v-vsp-enable-gpio);
+	 * here it is a fixed regulator used as the panel "vdd" supply. The
+	 * bootloader leaves it on for the splash screen.
+	 */
+	lcd_vsp_vreg: lcd_vsp_vreg {
+		compatible = "regulator-fixed";
+		regulator-name = "lcd_vsp_3v";
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+		gpio = <&tlmm 40 0>;
+		enable-active-high;
+		regulator-boot-on;
+	};
+
+	dsi_panel_pwr_supply_zte_axon7: dsi_panel_pwr_supply_zte_axon7 {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		qcom,panel-supply-entry@0 {
+			reg = <0>;
+			qcom,supply-name = "vddio";
+			qcom,supply-min-voltage = <1800000>;
+			qcom,supply-max-voltage = <1800000>;
+			qcom,supply-enable-load = <62000>;
+			qcom,supply-disable-load = <80>;
+			qcom,supply-post-on-sleep = <20>;
+		};
+
+		/* ZTE: 5 ms after enable, 2 ms after disable */
+		qcom,panel-supply-entry@1 {
+			reg = <1>;
+			qcom,supply-name = "vdd";
+			qcom,supply-min-voltage = <3000000>;
+			qcom,supply-max-voltage = <3000000>;
+			qcom,supply-enable-load = <857000>;
+			qcom,supply-disable-load = <0>;
+			qcom,supply-post-on-sleep = <5>;
+			qcom,supply-post-off-sleep = <2>;
+		};
+	};
+};
