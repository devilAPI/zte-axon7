From 549a750a68736474125b6da91cd1d8164b5849e3 Mon Sep 17 00:00:00 2001
From: axon7-build <axon7-build@localhost>
Date: Sun, 8 Nov 2026 10:36:19 +0000
Subject: [PATCH 23/24] ARM: dts: axon7: power key debounce as in the ZTE 3.18
 kernel

Change-Id: Ib06a7f438b94f6bb7c8606b2d2a596a932dec438
---
 arch/arm/boot/dts/qcom/msm8996-zte-axon7.dtsi | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/msm8996-zte-axon7.dtsi b/arch/arm/boot/dts/qcom/msm8996-zte-axon7.dtsi
index bd1f0588851e..dbe17909b789 100644
--- a/arch/arm/boot/dts/qcom/msm8996-zte-axon7.dtsi
+++ b/arch/arm/boot/dts/qcom/msm8996-zte-axon7.dtsi
@@ -327,6 +327,21 @@
 #include "msm8996-mdss-panels.dtsi"
 #include "dsi-panel-zte-samsung-s6e3ha3-5p5-wqhd-dualmipi-cmd.dtsi"
 
+/*
+ * Power key debounce as in the ZTE 3.18 kernel. msm-pm8994.dtsi asks for
+ * software debouncing (qcom,pon-sw-debounce), which this qpnp-power-on driver
+ * does not implement, leaving only the 62 us PMIC debounce: the key line then
+ * reported phantom presses (the phone woke up or locked itself on its own).
+ */
+&spmi_bus {
+	qcom,pm8994@0 {
+		qcom,power-on@800 {
+			qcom,pon-dbc-delay = <15625>;
+			qcom,kpdpwr-sw-debounce;
+		};
+	};
+};
+
 &mdss_mdp {
 	qcom,mdss-pref-prim-intf = "dsi";
 };
-- 
