diff --git a/drivers/mfd/ak49xx-slimslave.c b/drivers/mfd/ak49xx-slimslave.c
new file mode 100644
index 000000000000..0a732db567ba
--- /dev/null
+++ b/drivers/mfd/ak49xx-slimslave.c
@@ -0,0 +1,541 @@
