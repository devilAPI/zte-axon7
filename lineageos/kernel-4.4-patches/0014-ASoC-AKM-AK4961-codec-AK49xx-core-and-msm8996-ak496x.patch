+				case 1:
+					ak49xx_power_test(ak49xx,1);
+					break;
+				case 2:
+					ak49xx_power_test(ak49xx,2);
+					break;
+				case 3:
+					ak49xx_power_test(ak49xx,3);
+					break;
+				default: 
