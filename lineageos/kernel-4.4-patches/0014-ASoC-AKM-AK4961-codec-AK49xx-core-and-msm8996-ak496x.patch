+
+	if (ak49xx_intf == AK49XX_INTERFACE_TYPE_SPI ||
+		ak49xx_intf == AK49XX_INTERFACE_TYPE_SLIMBUS_SPI) {
+
+		ret = spi_write_then_read(ak49xx_spi, tx, 3, d, bytes);
+		if (ret != 0) {
+			pr_err("failed to read ak49xx cram\n");
