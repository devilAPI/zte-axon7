+static int msm_snd_enable_codec_ext_clk(struct snd_soc_codec *codec,
+					int enable, bool dapm)
+{
+	struct snd_soc_card *card = codec->component.card;
+	struct msm8996_asoc_mach_data *pdata = snd_soc_card_get_drvdata(card);
+
+	pr_err("%s: enable = %d\n", __func__, enable);
+
+	mutex_lock(&pdata->cdc_mclk_mutex);
+	ak4961_codec_mclk_enable(codec, enable, dapm);
+	mutex_unlock(&pdata->cdc_mclk_mutex);
+	return 0;
+}
+
+static int msm8996_mclk_event(struct snd_soc_dapm_widget *w,
+				 struct snd_kcontrol *kcontrol, int event)
+{
+	pr_debug("%s: chenjun:event = %d\n", __func__, event); /* ZTE_chenjun */
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		return msm_snd_enable_codec_ext_clk(snd_soc_dapm_to_codec(w->dapm), 1, true);
+	case SND_SOC_DAPM_POST_PMD:
+		return msm_snd_enable_codec_ext_clk(snd_soc_dapm_to_codec(w->dapm), 0, true);
+	}
+	return 0;
+}
