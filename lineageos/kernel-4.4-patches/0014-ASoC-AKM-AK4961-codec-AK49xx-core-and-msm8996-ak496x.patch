+static int ak4961_i2s_digital_mute(struct snd_soc_dai *codec_dai, int mute)
+{
+//	struct snd_soc_codec *codec = codec_dai->codec;
+	int mute_reg;
+	int reg;
+
+	switch (codec_dai->id) {
+	case 1:
+		mute_reg = 0x00;
+		break;
+	case 2:
+		mute_reg = 0x01;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (mute)
+		reg = 1;
+	else
+		reg = 0;
+
+//	snd_soc_update_bits(codec, mute_reg, 0x00, reg);
+
+	return 0;
+}
