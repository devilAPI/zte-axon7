+static void msm8996_ext_us_amp_enable(u32 on)
+{
+	if (on)
+		gpio_direction_output(ext_us_amp_gpio, 1);
+	else
+		gpio_direction_output(ext_us_amp_gpio, 0);
+
+	pr_debug("%s: US Emitter GPIO enable:%s\n", __func__,
+			on ? "Enable" : "Disable");
+}
