+		break;
+	case 96000:
+		MDV = 0x04;
+		BDV = 0x13;
+		SDV = 0x3F;
+		CMF = 0x0E;
+		break;
+	case 192000:
+		MDV = 0x04;
+		BDV = 0x09;
+		SDV = 0x3F;
+		CMF = 0xF2;
