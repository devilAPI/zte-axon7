diff --git a/shims/binder_perm.cpp b/shims/binder_perm.cpp
new file mode 100644
index 0000000..a6fe2ac
--- /dev/null
+++ b/shims/binder_perm.cpp
@@ -0,0 +1,14 @@
+/*
+ * libfpservice.so (gx_fpd, fingerprint) calls
+ * android::checkCallingPermission(const String16&), which the vendor
+ * libbinder of Android 15 no longer exports (permission checks need the
+ * system's permission service). Callers of gx_fpd are limited by SELinux
+ * (hal_fingerprint), so the check passes here.
+ */
+#include <utils/String16.h>
+
+namespace android {
+bool checkCallingPermission(const String16& /* permission */) {
+    return true;
+}
+}  // namespace android
