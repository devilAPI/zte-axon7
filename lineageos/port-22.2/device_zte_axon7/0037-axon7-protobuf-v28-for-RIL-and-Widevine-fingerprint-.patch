From 2fc3d7c45b5e177401bc39c1b33817a2e64c57f8 Mon Sep 17 00:00:00 2001
From: axon7-build <axon7-build@localhost>
Date: Sat, 7 Nov 2026 18:39:05 +0000
Subject: [PATCH 37/45] axon7: protobuf v28 for RIL and Widevine, fingerprint
 and camera link fixes, no qti_gnss_service

From the los12 boot log:
- rild: libsettings.so needs libprotobuf-cpp-full-v28.so; Widevine the
  lite one. AOSP prebuilts/vndk/v28 (android12-release) protobuf, soname
  renamed to -v28, copied by device.mk. Widevine is back.
- gx_fpd: android::checkCallingPermission(String16) is not in the vendor
  libbinder: libbinder_perm_shim (returns true; callers are limited by
  SELinux).
- camera: libFNVfbEngineHAL.so needed libandroid.so (no symbols used).
- vendor.qti.gnss@1.0-service only looped (IGnss is served by the
  source-built android.hardware.gnss@2.0-service-qti): off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FVN6i29oeF8XZDRKkkCQqG
Change-Id: I254fddc1aebc768bb3c6ecb09c95b3c145a803cc
---
 device.mk             | 10 ++++++++++
 extract-files.sh      |  8 +++++++-
 proprietary-files.txt | 15 ++++++++-------
 shims/Android.bp      |  7 +++++++
 shims/binder_perm.cpp | 14 ++++++++++++++
 5 files changed, 46 insertions(+), 8 deletions(-)
 create mode 100644 shims/binder_perm.cpp

diff --git a/device.mk b/device.mk
index 47d9cc5..3d76709 100644
--- a/device.mk
+++ b/device.mk
@@ -422,6 +422,7 @@ PRODUCT_PACKAGES += \
     libcutils_shim \
     libcutils_shim.vendor \
     libhidlbase_shim \
+    libbinder_perm_shim \
     libhidlbase_shim_system \
     libstackptr_shim \
     libui_shim.vendor
@@ -431,6 +432,15 @@ PRODUCT_PACKAGES += \
 PRODUCT_PACKAGES += \
     rild_axon7
 
+# protobuf 3.0 (Android 9 ABI) for the Qualcomm RIL (libsettings) and
+# Widevine (libwvhidl): AOSP prebuilts/vndk/v28 (android12-release), soname
+# renamed to *-v28 (vendor/zte/axon7/proprietary/vendor/lib*/)
+PRODUCT_COPY_FILES += \
+    vendor/zte/axon7/proprietary/vendor/lib/libprotobuf-cpp-full-v28.so:$(TARGET_COPY_OUT_VENDOR)/lib/libprotobuf-cpp-full-v28.so \
+    vendor/zte/axon7/proprietary/vendor/lib/libprotobuf-cpp-lite-v28.so:$(TARGET_COPY_OUT_VENDOR)/lib/libprotobuf-cpp-lite-v28.so \
+    vendor/zte/axon7/proprietary/vendor/lib64/libprotobuf-cpp-full-v28.so:$(TARGET_COPY_OUT_VENDOR)/lib64/libprotobuf-cpp-full-v28.so \
+    vendor/zte/axon7/proprietary/vendor/lib64/libprotobuf-cpp-lite-v28.so:$(TARGET_COPY_OUT_VENDOR)/lib64/libprotobuf-cpp-lite-v28.so
+
 # camera.msm8996.so (DNG): libimg_utils for vendor
 PRODUCT_PACKAGES += \
     libimg_utils.vendor
