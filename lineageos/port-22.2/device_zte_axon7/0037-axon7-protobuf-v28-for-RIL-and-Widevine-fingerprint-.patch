         ;;
     # Patch service.bootanim.exit in camera HAL
     vendor/lib/hw/camera.msm8996.so)
@@ -144,13 +145,18 @@ function blob_fixup() {
         "${PATCHELF}" --replace-needed "libstdc++.so" "libstdc++_vendor.so" "${2}"
         ;;
     # libstdc++ is libstdc++_vendor on the vendor partition (camera, fingerprint)
-    vendor/lib/liboptizoom.so|vendor/lib/libchromaflash.so|vendor/lib/libmmcamera_hdr_gb_lib.so|vendor/lib/libseemore.so|vendor/lib/libtsvideoprocess.so|vendor/lib/libtrueportrait.so|vendor/lib/libubifocus.so|vendor/lib64/libfp_client.so|vendor/lib64/libfpnav.so|vendor/lib64/hw/fingerprint.msm8996.so|vendor/lib64/hw/gxfingerprint.default.so|vendor/lib64/libfpservice.so)
+    vendor/lib/liboptizoom.so|vendor/lib/libchromaflash.so|vendor/lib/libmmcamera_hdr_gb_lib.so|vendor/lib/libseemore.so|vendor/lib/libtsvideoprocess.so|vendor/lib/libtrueportrait.so|vendor/lib/libubifocus.so|vendor/lib64/libfp_client.so|vendor/lib64/libfpnav.so|vendor/lib64/hw/fingerprint.msm8996.so|vendor/lib64/hw/gxfingerprint.default.so)
         "${PATCHELF}" --replace-needed "libstdc++.so" "libstdc++_vendor.so" "${2}"
         ;;
     # pm-service: sp<> on a stack object aborts on Android 15 (shims/stackptr.cpp)
     vendor/bin/pm-service)
         grep -q libstackptr_shim.so "${2}" || "${PATCHELF}" --add-needed "libstackptr_shim.so" "${2}"
         ;;
+    # fingerprint: checkCallingPermission(String16) (shims/binder_perm.cpp)
+    vendor/lib64/libfpservice.so)
+        grep -q libbinder_perm_shim.so "${2}" || "${PATCHELF}" --add-needed "libbinder_perm_shim.so" "${2}"
+        grep -q "libstdc++.so" "${2}" && "${PATCHELF}" --replace-needed "libstdc++.so" "libstdc++_vendor.so" "${2}"
+        ;;
     # IMS RTP: libmedia.so is gone; lib-dplmedia uses none of its symbols
     vendor/lib64/lib-dplmedia.so)
         "${PATCHELF}" --remove-needed "libmedia.so" "${2}"
