 extract-files.sh               |  3 +++
 sepolicy/vendor/genfs_contexts |  1 +
 shims/Android.bp               |  7 ++++++
 shims/ril_parcel.cpp           | 42 ++++++++++++++++++++++++++++++++++
 vendor.prop                    |  1 -
 6 files changed, 54 insertions(+), 1 deletion(-)
 create mode 100644 shims/ril_parcel.cpp

