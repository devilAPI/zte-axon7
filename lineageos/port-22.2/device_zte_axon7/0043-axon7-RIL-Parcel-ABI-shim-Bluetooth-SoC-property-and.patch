diff --git a/shims/ril_parcel.cpp b/shims/ril_parcel.cpp
new file mode 100644
index 0000000..192fd62
--- /dev/null
+++ b/shims/ril_parcel.cpp
@@ -0,0 +1,42 @@
+/*
+ * libril-qc-qmi-1.so (Android 8 Qualcomm RIL) keeps android::Parcel objects on
+ * its stack with the Android 8 size (112 bytes); the Android 15 Parcel is
+ * bigger, so its constructor overran the caller's frame ("stack corruption
+ * detected" in vendor_ril_send_hook_response). extract-files.sh renames the
+ * blob's eight Parcel imports to android::PaRcel (same length); this class has
+ * the same methods and keeps the real Parcel on the heap. The blob only uses
+ * Parcel as a byte buffer (no binder calls with it).
+ */
+#include <binder/Parcel.h>
+
+namespace android {
+
+class PaRcel {
+  public:
+    PaRcel();
+    ~PaRcel();
+    status_t writeInt32(int32_t val);
+    status_t writeString16(const char16_t* str, size_t len);
+    status_t write(const void* data, size_t len);
+    void setDataPosition(size_t pos) const;
+    const uint8_t* data() const;
+    size_t dataSize() const;
+
+  private:
+    Parcel* mParcel;
+};
+
+static_assert(sizeof(PaRcel) <= 112, "must fit the Android 8 Parcel slot");
+
+PaRcel::PaRcel() : mParcel(new Parcel()) {}
+PaRcel::~PaRcel() { delete mParcel; }
+status_t PaRcel::writeInt32(int32_t val) { return mParcel->writeInt32(val); }
+status_t PaRcel::writeString16(const char16_t* str, size_t len) {
+    return mParcel->writeString16(str, len);
+}
+status_t PaRcel::write(const void* data, size_t len) { return mParcel->write(data, len); }
+void PaRcel::setDataPosition(size_t pos) const { mParcel->setDataPosition(pos); }
+const uint8_t* PaRcel::data() const { return mParcel->data(); }
+size_t PaRcel::dataSize() const { return mParcel->dataSize(); }
+
+}  // namespace android
