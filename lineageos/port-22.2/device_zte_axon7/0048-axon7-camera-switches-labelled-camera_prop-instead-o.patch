From f2f4edd82c39c73df3c2a4dac6a379dd8d944bb2 Mon Sep 17 00:00:00 2001
From: axon7-build <axon7-build@localhost>
Date: Sun, 8 Nov 2026 09:51:34 +0000
Subject: [PATCH 48/48] axon7: camera switches labelled camera_prop instead of
 reading default_prop (neverallow)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FVN6i29oeF8XZDRKkkCQqG
Change-Id: I0a50f752b54939d689e9b16ad61546b3534ebf9f
---
 sepolicy/vendor/hal_camera_default.te |  1 -
 sepolicy/vendor/mm-qcamerad.te        |  6 +++---
 sepolicy/vendor/property_contexts     | 10 ++++++++++
 3 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/sepolicy/vendor/hal_camera_default.te b/sepolicy/vendor/hal_camera_default.te
index 441aa6e..8aa5492 100644
--- a/sepolicy/vendor/hal_camera_default.te
+++ b/sepolicy/vendor/hal_camera_default.te
@@ -1,3 +1,2 @@
 # camera.msm8996.so (QCamera2 HAL3) reads persist.camera.* and ZTE switches
 get_prop(hal_camera_default, camera_prop)
-get_prop(hal_camera_default, default_prop)
diff --git a/sepolicy/vendor/mm-qcamerad.te b/sepolicy/vendor/mm-qcamerad.te
index a3376a9..e53b2c6 100644
--- a/sepolicy/vendor/mm-qcamerad.te
+++ b/sepolicy/vendor/mm-qcamerad.te
@@ -6,7 +6,7 @@ allow mm-qcamerad camera_socket:dir w_dir_perms;
 binder_use(mm-qcamerad);
 
 # The Android 8 camera daemon reads its tuning and debug switches
-# (persist.camera.*, cameradaemon.*, persist.fv.*, ts.algo.*): without them it
-# runs on defaults and its debug logging cannot be switched on.
+# (persist.camera.* and the ZTE switches labelled camera_prop in
+# property_contexts): without them it runs on defaults and its debug logging
+# cannot be switched on.
 get_prop(mm-qcamerad, camera_prop)
-get_prop(mm-qcamerad, default_prop)
diff --git a/sepolicy/vendor/property_contexts b/sepolicy/vendor/property_contexts
index 3c90c0b..3322c0a 100644
--- a/sepolicy/vendor/property_contexts
+++ b/sepolicy/vendor/property_contexts
@@ -6,3 +6,13 @@ persist.net.doxlat         u:object_r:vendor_xlat_prop:s0
 
 # TFA9890 amplifier glue
 persist.vendor.axon7.amp_hal_   u:object_r:vendor_axon7_amp_prop:s0
+
+# Camera daemon / HAL switches outside persist.camera. (read by mm-qcamerad and
+# hal_camera_default; default_prop is off limits for vendor domains)
+cameradaemon.                u:object_r:camera_prop:s0
+persist.fv.                  u:object_r:camera_prop:s0
+ts.algo.                     u:object_r:camera_prop:s0
+persist.denoise.             u:object_r:camera_prop:s0
+persist.capture.             u:object_r:camera_prop:s0
+persist.debug.fotonation.    u:object_r:camera_prop:s0
+persist.debug.set.fixedfps   u:object_r:camera_prop:s0
-- 
2.47.3

