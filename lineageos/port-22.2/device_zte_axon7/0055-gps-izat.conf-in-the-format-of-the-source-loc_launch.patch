From 94316b5ba84fa48cf07666fe6e1ee417ed0d28ea Mon Sep 17 00:00:00 2001
From: axon7-build <axon7-build@localhost>
Date: Sun, 8 Nov 2026 17:59:00 +0000
Subject: [PATCH 55/56] gps: izat.conf in the format of the source loc_launcher

The source libgps.utils (loc_read_process_conf) reads exactly 12 keys per
process block and requires SOC_IDS. The old blocks had 9-10 keys and no
SOC_IDS: every block was skipped ("One of the parameters not specified"),
so no location daemon ever ran (no XTRA download). Base: the msm8996-common
lineage-22.2 izat.conf (feature names of this HAL), plus SOC_IDS=all and
LOW_RAM_TARGETS=ENABLED per block. Now lowi-server and xtra-daemon start.

Change-Id: I15fec9777b39d82a186012c39240b6c011d46f0a
---
 gps/etc/izat.conf | 137 +++++++++++++++++++++++-----------------------
 1 file changed, 70 insertions(+), 67 deletions(-)

diff --git a/gps/etc/izat.conf b/gps/etc/izat.conf
index fceb95c..436a1f0 100644
--- a/gps/etc/izat.conf
+++ b/gps/etc/izat.conf
@@ -37,9 +37,9 @@ LPPE_SRN_DATA_SCAN_INJECT_TIME=2
 # without EULA consent, but the uncertainty can be high.
 # QNP preferred mode prefers QNP when there is EULA consent,
 # otherwise OSNLP is used.
-NLP_MODE = 1
+NLP_MODE = 4
