-    //     sets the 4 annotated use cases below to MONO_SPEAKER
-    [SND_DEVICE_OUT_VOICE_SPEAKER]                  = STEREO_SPEAKER, //16
-    [SND_DEVICE_OUT_VOICE_SPEAKER_VBAT]             = STEREO_SPEAKER, //17
-    [SND_DEVICE_OUT_VOICE_SPEAKER_2]                = STEREO_SPEAKER, //18
-    [SND_DEVICE_OUT_VOICE_SPEAKER_2_VBAT]           = STEREO_SPEAKER, //19
+    // Speakerphone calls on one amp, as 18.1 set through the
+    // persist.axon7.amp_hal_device_map default. Overrides go in
+    // persist.vendor.axon7.amp_hal_device_map ("<snd_device>,<mode>;...");
+    // snd_device numbers come from hal/msm8974/platform.h and shift between
+    // audio HAL versions, so the defaults are named here.
+    [SND_DEVICE_OUT_VOICE_SPEAKER]                  = MONO_SPEAKER,
+    [SND_DEVICE_OUT_VOICE_SPEAKER_VBAT]             = MONO_SPEAKER,
+    [SND_DEVICE_OUT_VOICE_SPEAKER_2]                = MONO_SPEAKER,
+    [SND_DEVICE_OUT_VOICE_SPEAKER_2_VBAT]           = MONO_SPEAKER,
     [SND_DEVICE_OUT_SPEAKER_AND_HDMI]               = STEREO_SPEAKER,
     [SND_DEVICE_OUT_SPEAKER_AND_DISPLAY_PORT]       = STEREO_SPEAKER,
     [SND_DEVICE_OUT_SPEAKER_AND_BT_A2DP]            = STEREO_SPEAKER,
@@ -358,7 +361,7 @@ static void tfa9890_populate_device_map(tfa9890_device_t *tfa9890) {
     memcpy(dev_map, device_to_amp_device_default, len);
     tfa9890->device_to_amp_device = dev_map;
 
-    if (property_get("persist.axon7.amp_hal_device_map", buffer, "")) {
+    if (property_get("persist.vendor.axon7.amp_hal_device_map", buffer, "")) {
         // Gross hacks, don't judge this.
         char *end, *ptr = buffer;
         while (*ptr != '\0') {
@@ -375,7 +378,10 @@ static void tfa9890_populate_device_map(tfa9890_device_t *tfa9890) {
                     ALOGE("Error parsing mode.  Remaining string was %s", ptr);
                     return;
                 }
-                // Should sanity check here.  #YOLO
+                if (adevice <= SND_DEVICE_NONE || (size_t) adevice >= len / sizeof(int)) {
+                    ALOGE("snd_device %d out of range", adevice);
+                    return;
+                }
                 ALOGD("Overriding device(%d): mode(%d->%d)\n", adevice, dev_map[adevice], mode);
                 dev_map[adevice] = mode;
             } else {
