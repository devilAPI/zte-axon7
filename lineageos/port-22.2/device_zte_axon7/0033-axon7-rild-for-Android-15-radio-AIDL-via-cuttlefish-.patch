diff --git a/rild/Android.bp b/rild/Android.bp
new file mode 100644
index 0000000..d7345e1
--- /dev/null
+++ b/rild/Android.bp
@@ -0,0 +1,28 @@
+// rild for Android 15: cuttlefish's libril-modem-lib (radio AIDL via the HIDL
+// 1.6 compat shim) on top of the Qualcomm RIL. See rild_axon7.c.
+cc_binary {
+    name: "rild_axon7",
+    stem: "rild",
+    vendor: true,
+    relative_install_path: "hw",
+    cflags: [
+        "-DRIL_SHLIB",
+        "-Wall",
+        "-Werror",
+        "-Wextra",
+    ],
+    srcs: ["rild_axon7.c"],
+    include_dirs: [
+        "device/google/cuttlefish",
+        "hardware/ril/include",
+    ],
+    shared_libs: [
+        "libcutils",
+        "libdl",
+        "liblog",
+        "libril-modem-lib",
+    ],
+    init_rc: ["rild_axon7.rc"],
+    vintf_fragments: ["android.hardware.radio-axon7.xml"],
+    overrides: ["rild"],
+}
