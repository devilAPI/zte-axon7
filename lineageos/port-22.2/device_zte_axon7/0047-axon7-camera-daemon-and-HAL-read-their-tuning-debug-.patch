From 1f77f407b872456707a14c48d937c4ad84de7304 Mon Sep 17 00:00:00 2001
From: axon7-build <axon7-build@localhost>
Date: Sun, 8 Nov 2026 09:34:47 +0000
Subject: [PATCH 47/48] axon7: camera daemon and HAL read their tuning/debug
 properties

The rear camera reports an empty stream configuration (0x0); the daemon's
property reads (camera_prop, default_prop) were denied, so it ran on
defaults and its debug output could not be enabled.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FVN6i29oeF8XZDRKkkCQqG
Change-Id: I425de9971f7563c2768fb03de2a9b991fb4a8909
---
 sepolicy/vendor/hal_camera_default.te | 3 +++
 sepolicy/vendor/mm-qcamerad.te        | 6 ++++++
 2 files changed, 9 insertions(+)
 create mode 100644 sepolicy/vendor/hal_camera_default.te

diff --git a/sepolicy/vendor/hal_camera_default.te b/sepolicy/vendor/hal_camera_default.te
new file mode 100644
index 0000000..441aa6e
--- /dev/null
+++ b/sepolicy/vendor/hal_camera_default.te
@@ -0,0 +1,3 @@
+# camera.msm8996.so (QCamera2 HAL3) reads persist.camera.* and ZTE switches
+get_prop(hal_camera_default, camera_prop)
+get_prop(hal_camera_default, default_prop)
diff --git a/sepolicy/vendor/mm-qcamerad.te b/sepolicy/vendor/mm-qcamerad.te
index 487416c..a3376a9 100644
--- a/sepolicy/vendor/mm-qcamerad.te
+++ b/sepolicy/vendor/mm-qcamerad.te
@@ -4,3 +4,9 @@ allow mm-qcamerad vendor_camera_data_file:file { create read write open };
 
 allow mm-qcamerad camera_socket:dir w_dir_perms;
 binder_use(mm-qcamerad);
+
+# The Android 8 camera daemon reads its tuning and debug switches
+# (persist.camera.*, cameradaemon.*, persist.fv.*, ts.algo.*): without them it
+# runs on defaults and its debug logging cannot be switched on.
+get_prop(mm-qcamerad, camera_prop)
+get_prop(mm-qcamerad, default_prop)
-- 
2.47.3

