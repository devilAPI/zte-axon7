From c0761694df2654fc15c38e70c1c589f2cf6724cf Mon Sep 17 00:00:00 2001
From: axon7-build <axon7-build@localhost>
Date: Sun, 8 Nov 2026 23:31:07 +0000
Subject: [PATCH 1/2] SystemUI: flashlight strength slider on long press

Devices that set config_flashlightStrengthSlider get a slider dialog when
long-pressing the QS flashlight tile (the torch is switched on first). The
value (10 steps, percent) goes to persist.sys.axon7.torch_pct; the device
applies it to its flash driver.

Change-Id: Iefd004c8f4d5378226f9da8bf37ea048edaac127
---
 .../res/values/flashlight_strength.xml        |  8 ++
 .../systemui/qs/tiles/FlashlightTile.java     | 92 ++++++++++++++++++-
 2 files changed, 97 insertions(+), 3 deletions(-)
 create mode 100644 packages/SystemUI/res/values/flashlight_strength.xml

diff --git a/packages/SystemUI/res/values/flashlight_strength.xml b/packages/SystemUI/res/values/flashlight_strength.xml
new file mode 100644
index 000000000..c4e7f9665
--- /dev/null
+++ b/packages/SystemUI/res/values/flashlight_strength.xml
@@ -0,0 +1,8 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Flashlight strength slider on the QS flashlight tile (long press). -->
+<resources>
+    <!-- The device can dim the torch (see FlashlightTile). -->
+    <bool name="config_flashlightStrengthSlider">false</bool>
+    <!-- Title of the flashlight strength dialog [CHAR LIMIT=40] -->
+    <string name="quick_settings_flashlight_strength">Flashlight strength</string>
+</resources>
diff --git a/packages/SystemUI/src/com/android/systemui/qs/tiles/FlashlightTile.java b/packages/SystemUI/src/com/android/systemui/qs/tiles/FlashlightTile.java
index 2b127d60b..c568a3aaa 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/tiles/FlashlightTile.java
+++ b/packages/SystemUI/src/com/android/systemui/qs/tiles/FlashlightTile.java
@@ -20,14 +20,20 @@ import android.app.ActivityManager;
 import android.content.Intent;
 import android.os.Handler;
 import android.os.Looper;
+import android.os.SystemProperties;
 import android.provider.MediaStore;
 import android.service.quicksettings.Tile;
+import android.widget.LinearLayout;
+import android.widget.SeekBar;
 import android.widget.Switch;
 
 import androidx.annotation.Nullable;
 
+import com.android.internal.jank.InteractionJankMonitor;
 import com.android.internal.logging.MetricsLogger;
 import com.android.internal.logging.nano.MetricsProto.MetricsEvent;
+import com.android.systemui.animation.DialogCuj;
+import com.android.systemui.animation.DialogTransitionAnimator;
 import com.android.systemui.animation.Expandable;
 import com.android.systemui.dagger.qualifiers.Background;
 import com.android.systemui.dagger.qualifiers.Main;
@@ -40,6 +46,7 @@ import com.android.systemui.qs.QsEventLogger;
 import com.android.systemui.qs.logging.QSLogger;
 import com.android.systemui.qs.tileimpl.QSTileImpl;
 import com.android.systemui.res.R;
+import com.android.systemui.statusbar.phone.SystemUIDialog;
 import com.android.systemui.statusbar.policy.FlashlightController;
 
 import javax.inject.Inject;
@@ -53,6 +60,18 @@ public class FlashlightTile extends QSTileImpl<BooleanState> implements
     public static final String TILE_SPEC = "flashlight";
     private final FlashlightController mFlashlightController;
 
+    /*
+     * Flashlight strength (config_flashlightStrengthSlider): long press opens
+     * a slider. The value goes to STRENGTH_PROP; the device copies it to its
+     * flash driver, which scales the torch current (also while it is on).
+     */
+    private static final String STRENGTH_PROP = "persist.sys.axon7.torch_pct";
+    private static final int STRENGTH_STEPS = 10;
+    private static final String INTERACTION_JANK_TAG = "flashlight_strength";
+    private final DialogTransitionAnimator mDialogTransitionAnimator;
+    private final SystemUIDialog.Factory mSystemUIDialogFactory;
+    private final boolean mHasStrength;
+
     @Inject
     public FlashlightTile(
             QSHost host,
@@ -64,11 +83,17 @@ public class FlashlightTile extends QSTileImpl<BooleanState> implements
             StatusBarStateController statusBarStateController,
             ActivityStarter activityStarter,
             QSLogger qsLogger,
-            FlashlightController flashlightController
+            FlashlightController flashlightController,
+            DialogTransitionAnimator dialogTransitionAnimator,
+            SystemUIDialog.Factory systemUIDialogFactory
     ) {
         super(host, uiEventLogger, backgroundLooper, mainHandler, falsingManager, metricsLogger,
                 statusBarStateController, activityStarter, qsLogger);
         mFlashlightController = flashlightController;
+        mDialogTransitionAnimator = dialogTransitionAnimator;
+        mSystemUIDialogFactory = systemUIDialogFactory;
+        mHasStrength = mContext.getResources().getBoolean(
+                R.bool.config_flashlightStrengthSlider);
         mFlashlightController.observe(getLifecycle(), this);
     }
 
@@ -80,7 +105,7 @@ public class FlashlightTile extends QSTileImpl<BooleanState> implements
     @Override
     public BooleanState newTileState() {
         BooleanState state = new BooleanState();
-        state.handlesLongClick = false;
+        state.handlesLongClick = mHasStrength;
         return state;
     }
 
@@ -115,7 +140,68 @@ public class FlashlightTile extends QSTileImpl<BooleanState> implements
 
     @Override
     protected void handleLongClick(@Nullable Expandable expandable) {
-        handleClick(expandable);
+        if (!mHasStrength || !mFlashlightController.isAvailable()) {
+            handleClick(expandable);
+            return;
+        }
+        if (!mFlashlightController.isEnabled()) {
+            refreshState(true);
+            mFlashlightController.setFlashlight(true);
+        }
+        mUiHandler.post(() -> showStrengthDialog(expandable));
+    }
+
+    private void showStrengthDialog(@Nullable Expandable expandable) {
+        int pct = Math.max(1, Math.min(100, SystemProperties.getInt(STRENGTH_PROP, 100)));
+        SeekBar bar = new SeekBar(mContext);
+        bar.setMax(STRENGTH_STEPS - 1);
+        bar.setProgress(Math.max(0, Math.round(pct * STRENGTH_STEPS / 100f) - 1));
+        bar.setContentDescription(mContext.getString(R.string.quick_settings_flashlight_strength));
+        bar.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar seekBar, int progress, boolean fromUser) {
+                if (!fromUser) {
+                    return;
+                }
+                int value = (progress + 1) * 100 / STRENGTH_STEPS;
+                mHandler.post(() -> SystemProperties.set(STRENGTH_PROP, Integer.toString(value)));
+                if (!mFlashlightController.isEnabled()) {
+                    mFlashlightController.setFlashlight(true);
+                }
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar seekBar) {
+            }
+
+            @Override
+            public void onStopTrackingTouch(SeekBar seekBar) {
+            }
+        });
+        int pad = mContext.getResources().getDimensionPixelSize(
+                R.dimen.dialog_side_padding);
+        LinearLayout layout = new LinearLayout(mContext);
+        layout.setPadding(pad, pad / 2, pad, 0);
+        layout.addView(bar, new LinearLayout.LayoutParams(
+                LinearLayout.LayoutParams.MATCH_PARENT,
+                LinearLayout.LayoutParams.WRAP_CONTENT));
+
+        SystemUIDialog dialog = mSystemUIDialogFactory.create();
+        dialog.setTitle(R.string.quick_settings_flashlight_strength);
+        dialog.setView(layout);
+        dialog.setPositiveButton(R.string.quick_settings_done, null);
+        dialog.setShowForAllUsers(true);
+        if (expandable != null) {
+            DialogTransitionAnimator.Controller controller =
+                    expandable.dialogTransitionController(new DialogCuj(
+                            InteractionJankMonitor.CUJ_SHADE_DIALOG_OPEN,
+                            INTERACTION_JANK_TAG));
+            if (controller != null) {
+                mDialogTransitionAnimator.show(dialog, controller);
+                return;
+            }
+        }
+        dialog.show();
     }
 
     @Override
-- 
