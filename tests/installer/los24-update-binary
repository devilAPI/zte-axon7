#!/sbin/sh
# LineageOS 24 (mainline Linux) for the ZTE Axon 7, TWRP installer.
#
# Two flavours, selected by the "flavour" file in the zip:
#   standalone (CI release zip, default): stock partition layout, no
#     multi-boot, no shim:
#       boot     <- boot.img that ZTE LK boots directly
#       system   <- super.img (system, system_ext, product, vendor)
#       userdata <- formatted; /data with file-based encryption (FBE v2)
#       cache    <- formatted ext4 and mounted as Android's PERSISTENT
#                   /metadata (aconfig flags, apexd, vold checkpoints,
#                   OTA/GSI state). The GPU's a530_zap.* is staged in
#                   /metadata/axon7-fw there before `system` is overwritten.
#                   The built /vendor/firmware links point at those files.
#                   A separate `metadata` partition, if the device has one,
#                   is wiped; the cache-backed /metadata is never wiped after
#                   staging. No metadata_encryption: FBE keys stay on /data.
#     No los_* partitions, no boot menu or shim needed, misc untouched.
#     Preflight (nothing written before all of these pass): Axon 7 device
#     and model, TWRP >= 3.3, TrustZone TZ.BF.4.0.1-00353 (the Oreo
#     universal bootstack, as LineageOS 22.2 requires), the stock boot /
#     system / userdata / cache partitions, the community 512 MiB `vendor`
#     partition (PARTY; the GPU firmware comes from it), the boot image
#     cmdline and the super image's LP metadata. On a re-install the GPU
#     firmware already staged in /metadata/axon7-fw is copied aside before
#     cache is formatted again, so an in-place update keeps the GPU working.
#   multiboot (AXON7_MULTIBOOT=1, developer builds only):
#       system   <- super.img
#       los_boot <- kernel image for the boot menu's LineageOS entry
#       los_metadata, los_data: start zeroed
#       the boot menu (shim) with a LineageOS entry must already be in boot.
# Not touched in either flavour: persist, modem/EFS (modemst1/2, fsg, fsc),
# the bootloader, and the boot menu's misc block.
# Arguments from TWRP: API version, output pipe, zip path.
OUTFD=/proc/self/fd/$2
ZIP=$3
ui() { echo "ui_print $*" > "$OUTFD"; echo "ui_print" > "$OUTFD"; }
die() { ui "ERROR: $*"; ui "Stopped; no further partitions were written."; exit 1; }
SYS_BLOCK=${AXON7_TEST_SYS_BLOCK:-/sys/class/block}
BLOCK_DEV=${AXON7_TEST_BLOCK_DEV:-/dev/block}
TMP_BASE=${AXON7_TEST_TMP:-/tmp}
part() {	# partition name -> /dev/block/sdXN (TWRP sometimes lacks by-name links)
	for b in "$SYS_BLOCK"/*; do
		grep -q "^PARTNAME=$1\$" "$b/uevent" 2>/dev/null && { echo "$BLOCK_DEV/${b##*/}"; return; }
	done
}
bytes() { echo $(( $(cat "$SYS_BLOCK/${1##*/}/size") * 512 )); }

# Every mount made below is recorded, then released on *every* exit path
# (including die() and a signal), so TWRP can unmount/reboot/flash cleanly.
mounted=
unmount_all() {
	[ -n "$mounted" ] || return 0
	# shellcheck disable=SC2086
	for mp in $mounted; do umount "$mp" 2>/dev/null || true; done
	mounted=
}
unmount_one() {
	target=$1
	umount "$target" 2>/dev/null || true
	rest=
	# shellcheck disable=SC2086
	for mp in $mounted; do [ "$mp" = "$target" ] || rest="$mp $rest"; done
	mounted=$rest
}
trap 'unmount_all' EXIT
trap 'exit 1' HUP INT TERM
has_token() {	# space-separated cmdline -> token
	case " $1 " in *" $2 "*) return 0 ;; esac
	return 1
}

ui "LineageOS 24 (mainline Linux) for the ZTE Axon 7 - ALPHA"
dev=$(getprop ro.product.device)
model=$(getprop ro.product.model)
ui "Device: ${dev:-?}${model:+, model $model}"
case "$dev" in ailsa_ii|axon7|A2017*) ;; *) die "this zip is for the ZTE Axon 7 (TWRP says device '$dev')";; esac
# TWRP on some builds leaves ro.product.model empty; when it is set, it must
# be an Axon 7 (A2017G/U/China) and not another msm8996 device.
case "$model" in
	''|*A2017*|*ailsa*|*Axon*7*) ;;
	*) die "this zip is for the ZTE Axon 7 A2017G/A2017U; TWRP reports model '$model'" ;;
esac

twrp=$(getprop ro.twrp.version 2>/dev/null)
case "$twrp" in
	3.3*|3.[4-9]*|3.[1-9][0-9]*|[4-9].*) ;;
	'') die "cannot read the TWRP version; install TWRP 3.3.0-0 or newer" ;;
	*) die "TWRP $twrp is too old (3.2.x is untested); install TWRP 3.3.0-0 first" ;;
esac

# TrustZone: the Oreo "universal" bootstack (TZ.BF.4.0.1-00353), the same
# requirement as LineageOS 15.1-22.2. LK and the firmware hand-off are
# untested on anything else, so refuse before writing. The string is printed
# by the tz image itself; 4 MiB is enough for the header.
tz=$(part tz)
tzver=
[ -z "$tz" ] || tzver=$(dd if="$tz" bs=4096 count=1024 2>/dev/null |
	tr -c '[:print:]' '\n' | sed -n 's/^QC_IMAGE_VERSION_STRING=//p' | head -n1)
case "$tzver" in
	TZ.BF.4.0.1-00353) ui "TrustZone: $tzver (Oreo universal bootstack)" ;;
	'') die "cannot read the TrustZone version from the tz partition; this ROM needs the Oreo universal bootstack (TZ.BF.4.0.1-00353)" ;;
	*) die "TrustZone is '$tzver', not TZ.BF.4.0.1-00353; install the Oreo universal bootstack before flashing" ;;
esac


cd "$TMP_BASE" || die "no $TMP_BASE"
rm -rf "$TMP_BASE/los24" || die "$TMP_BASE"
mkdir "$TMP_BASE/los24" || die "$TMP_BASE"
cd "$TMP_BASE/los24" || die "$TMP_BASE"
flavour=multiboot	# compatibility: zips without the marker are developer zips
[ -f "$ZIP" ] && unzip -p "$ZIP" flavour 2>/dev/null | grep -q '^standalone$' && flavour=standalone
ui "Installer flavour: $flavour"
unzip -o "$ZIP" sizes super.raw.sha1 >/dev/null 2>&1 || die "zip incomplete"
if [ "$flavour" = standalone ]; then
	unzip -o "$ZIP" boot.img boot.img.sha1 >/dev/null 2>&1 || die "zip has no boot.img"
else
	unzip -o "$ZIP" los-boot.img los-boot.img.sha1 >/dev/null 2>&1 || die "zip has no los-boot.img"
fi
read -r super_size boot_size < sizes

# Preflight, BEFORE a single partition is written: a wrong boot image would
# leave a phone that cannot mount logical partitions or find firmware; a
# non-super image in `system` would leave an unbootable system. The header's
# cmdline is at 64..576 in both v0 (LK) and v2 (developer) boot images.
bootfile=boot.img
[ "$flavour" = standalone ] || bootfile=los-boot.img
[ "$(dd if="$bootfile" bs=1 count=8 2>/dev/null)" = "ANDROID!" ] ||
	die "$bootfile in the zip has no Android boot header"
boot_cmd=$(dd if="$bootfile" bs=1 skip=64 count=512 2>/dev/null | tr -c '[:print:]' '\n')
has_token "$boot_cmd" androidboot.super_partition=system ||
	die "$bootfile cmdline has no androidboot.super_partition=system; wrong or damaged zip"
has_token "$boot_cmd" androidboot.boot_devices=soc@0/624000.ufshc ||
	die "$bootfile cmdline has no androidboot.boot_devices=soc@0/624000.ufshc; wrong or damaged zip"
has_token "$boot_cmd" firmware_class.path=/vendor/firmware ||
	die "$bootfile cmdline has no firmware_class.path=/vendor/firmware; wrong or damaged zip"

# Check the super image IN THE ZIP (the phone's `system` still holds the old
# ROM at this point). The LP geometry magic is 0x616c4467 ("gDla", little
# endian) in the first 4 bytes of the second 4096-byte page; the metadata
# holds the four logical partition names. Decompress only the first 1 MiB.
magic=$(unzip -p "$ZIP" super.raw.gz 2>/dev/null | gunzip -c 2>/dev/null |
	dd bs=1 skip=4096 count=4 2>/dev/null)
[ "$magic" = gDla ] ||
	die "super.raw.gz in the zip has no Android logical-partition metadata (magic '$magic'); wrong or damaged zip"
lp_names=$(unzip -p "$ZIP" super.raw.gz 2>/dev/null | gunzip -c 2>/dev/null |
	head -c 1048576 | tr -c '[:print:]' '\n')
for p in system system_ext product vendor; do
	printf '%s\n' "$lp_names" | grep -q "^$p\$" ||
		die "super image in the zip has no logical partition '$p' (expected system, system_ext, product, vendor)"
done
ui "Preflight: boot cmdline and super partitions OK."

sys=$(part system)
[ -n "$sys" ] || die "no system partition"
[ "$(bytes "$sys")" -ge "$super_size" ] || die "partition system is smaller ($(bytes "$sys")) than super ($super_size)"

if [ "$flavour" = standalone ]; then
	boot=$(part boot); ud=$(part userdata); ca=$(part cache)
	for v in "boot:$boot" "userdata:$ud" "cache:$ca"; do
		[ -n "${v#*:}" ] || die "no partition ${v%%:*}: this zip needs the stock partition layout"
	done
	[ "$(bytes "$boot")" -ge "$boot_size" ] || die "partition boot is too small for boot.img ($boot_size)"
	[ "$(sha1sum < boot.img | cut -d' ' -f1)" = "$(cat boot.img.sha1)" ] || die "boot.img damaged (download again)"
	# The release requires the community vendor partition (PARTY): it holds
	# the GPU's a530_zap on phones coming from LineageOS 16-22.2, and PARTY
	# is also what turns the 6 GiB ZTE system into the 5.5 GiB super device
	# this image was built for. The stock layout alone is not supported.
	oldvendor=$(part vendor)
	[ -n "$oldvendor" ] ||
		die "no vendor partition: install the 512 MiB community vendor partition first (Oki's PARTY tool, or tools/axon7-make-vendor.sh); the stock ZTE layout alone is not supported"
	vsize=$(bytes "$oldvendor")
	[ "$vsize" -ge 268435456 ] ||
		die "the vendor partition is only $((vsize / 1048576)) MiB; this release needs the 512 MiB community vendor partition (PARTY)"

	# Find the GPU firmware before writing anything. Sources, in order: the
	# copy a previous install left in /metadata/axon7-fw (on the cache
	# partition, which is formatted below, so it is copied aside first), the
	# physical vendor partition, then the old ROM's system.
	old="$TMP_BASE/los24/old"
	oldv="$TMP_BASE/los24/v"
	prev="$TMP_BASE/los24/prev"
	mkdir -p "$old" "$oldv" "$prev" || die "cannot make firmware directories"
	if mount -o ro "$sys" "$old" 2>/dev/null; then mounted="$old $mounted"; fi
	if mount -o ro,noload "$oldvendor" "$oldv" 2>/dev/null; then
		mounted="$oldv $mounted"
	fi
	# In-place update: the old system is then a super image and cannot be
	# mounted, so keep the firmware from the previous install's /metadata
	# (cache is ext4 from that install; a fresh phone's cache does not mount
	# here and that is fine).
	umount /cache 2>/dev/null || true
	if mount -o ro,noload "$ca" "$prev" 2>/dev/null; then
		mounted="$prev $mounted"
		if [ -s "$prev/axon7-fw/a530_zap.mdt" ]; then
			mkdir -p "$TMP_BASE/los24/fwprev" || die "cannot keep the staged GPU firmware"
			cp "$prev"/axon7-fw/a530_zap.* "$TMP_BASE/los24/fwprev/" 2>/dev/null ||
				die "cannot copy the staged GPU firmware aside"
		fi
		unmount_one "$prev"
	fi
	fw=
	[ ! -s "$TMP_BASE/los24/fwprev/a530_zap.mdt" ] || fw="$TMP_BASE/los24/fwprev"
	[ -n "$fw" ] || [ ! -s "$oldv/firmware/a530_zap.mdt" ] || fw=$oldv/firmware
	if [ -z "$fw" ]; then
		for d in "$old/vendor/firmware" "$old/etc/firmware" \
			 "$old/system/vendor/firmware" "$old/system/etc/firmware"; do
			[ ! -s "$d/a530_zap.mdt" ] || { fw=$d; break; }
		done
	fi
	[ -n "$fw" ] || die "no a530_zap GPU firmware found (not in /metadata/axon7-fw from a previous install, not in the vendor partition, not in the old system); restore your ROM and copy it before flashing again"

	# The stock `cache` partition is unused by modern Android: format it
	# ext4 and use it as the persistent /metadata from fstab. The staged
	# files in /metadata/axon7-fw are the targets of the built firmware
	# symlinks.
	ui "Formatting cache as ext4 (Android's persistent /metadata)..."
	umount /cache 2>/dev/null || true
	mkdir -p /cache || die "cannot make /cache"
	if command -v mkfs.ext4 >/dev/null 2>&1; then
		mkfs.ext4 -F -L metadata "$ca" >/dev/null 2>&1 || die "formatting cache as ext4 failed"
	elif command -v make_ext4fs >/dev/null 2>&1; then
		make_ext4fs -L metadata -a /metadata "$ca" >/dev/null 2>&1 || die "formatting cache as ext4 failed"
	else
		die "no ext4 formatter in TWRP (mkfs.ext4 / make_ext4fs); needed for /metadata"
	fi
	mount -t ext4 -o rw "$ca" /cache 2>/dev/null || die "cannot mount the formatted cache partition"
	mounted="/cache $mounted"
	fwdir=/cache/axon7-fw
	mkdir -p "$fwdir" || die "cannot make $fwdir"
	for f in a530_zap.mdt a530_zap.b00 a530_zap.b01 a530_zap.b02 a530_zap.b03 \
		 a530_zap.b04 a530_zap.b05 a530_zap.b06 a530_zap.b07; do
		[ ! -s "$fw/$f" ] || cp "$fw/$f" "$fwdir/$f" 2>/dev/null || die "cannot copy $f to /metadata/axon7-fw"
	done
	[ -s "$fwdir/a530_zap.mdt" ] || die "GPU firmware copy failed"
	sync
	ui "GPU firmware staged in /metadata/axon7-fw ($(find "$fwdir" -type f | wc -l) files)."
	# Do not hold ro mounts on a block device that is about to be written.
	unmount_one "$old"; unmount_one "$oldv"

	ui "Writing system (super, $((super_size / 1048576)) MiB), takes a few minutes..."
	unzip -p "$ZIP" super.raw.gz | gunzip -c | dd of="$sys" bs=1048576 2>/dev/null || die "writing super failed"
	sync
	ui "Checking system..."
	got=$(dd if="$sys" bs=1048576 count=$((super_size / 1048576)) 2>/dev/null | sha1sum | cut -d' ' -f1)
	[ "$got" = "$(cat super.raw.sha1)" ] || die "system does not read back correctly (do not boot; flash again)"

	ui "Writing boot (the kernel LineageOS boots with, no boot menu)..."
	dd if=boot.img of="$boot" bs=1048576 2>/dev/null || die "writing boot failed"
	sync
	[ "$(dd if="$boot" bs="$boot_size" count=1 2>/dev/null | sha1sum | cut -d' ' -f1)" = "$(cat boot.img.sha1)" ] || die "boot does not read back correctly"

	ui "Erasing userdata (Android sets up file-based encryption at first boot)..."
	# TWRP mounts /data for MTP; close it before writing the block device.
	umount /data 2>/dev/null || true
	if command -v mkfs.f2fs >/dev/null 2>&1; then
		mkfs.f2fs -f "$ud" >/dev/null 2>&1 || die "formatting userdata as f2fs failed"
	else
		# No mkfs.f2fs in this TWRP: fs_mgr's fstab entry has
		# "check,formattable", so it formats/creates FBE metadata on the
		# first boot. Clearing the head also removes any old filesystem.
		dd if=/dev/zero of="$ud" bs=1048576 count=64 2>/dev/null || die "erasing userdata failed"
	fi
	# Some layouts have a real `metadata` partition. Wipe it only if it
	# EXISTS: it holds the old ROM's aconfig/vold state. The stock A2017G
	# has none - its /metadata is the ext4 cache formatted and staged above,
	# which must NOT be wiped here (that would delete the GPU firmware).
	md=$(part metadata)
	if [ -n "$md" ]; then
		ui "Erasing the separate metadata partition..."
		dd if=/dev/zero of="$md" bs=1048576 count=16 2>/dev/null || die "erasing metadata failed"
	fi
	sync
	rm -rf "$TMP_BASE/los24"
	unmount_all
	ui "Done. Reboot normally (no boot menu needed)."
	ui "The first start takes a few minutes; do not interrupt it."
	exit 0
fi

# Developer multi-boot flavour (AXON7_MULTIBOOT=1).
lb=$(part los_boot); lm=$(part los_metadata); ld=$(part los_data); boot=$(part boot)
for v in "los_boot:$lb" "los_metadata:$lm" "los_data:$ld" "boot:$boot"; do
	[ -n "${v#*:}" ] || die "no partition ${v%%:*}: this zip needs the multi-boot layout (DEV-MULTIBOOT.md)"
done
# the boot menu (shim) with a LineageOS entry must be in boot. The shim's
# kernel is stored gzip-compressed (shim/build-axon7.sh), so look for the
# label in the plain image and in the kernel after the header page (2 or
# 4 KiB). TWRP 3.3's busybox (2019) has gunzip but an od without -A/-t.
has_menu() {
	dd if="$boot" bs=1048576 count=16 2>/dev/null | tr -c 'A-Za-z' '\n' | grep -q '^LineageOS$' && return 0
	for pg in 4096 2048; do
		dd if="$boot" bs=$pg skip=1 count=$((16777216 / pg)) 2>/dev/null | gunzip -c 2>/dev/null |
			tr -c 'A-Za-z' '\n' | grep -q '^LineageOS$' && return 0
	done
	return 1
}
has_menu || die "the boot partition has no boot menu with a LineageOS entry (install the multi-boot setup first)"
[ "$(bytes "$lb")" -ge "$boot_size" ] || die "partition los_boot is too small"
[ "$(sha1sum < los-boot.img | cut -d' ' -f1)" = "$(cat los-boot.img.sha1)" ] || die "los-boot.img damaged (download again)"
vendor=$(part vendor)
[ -n "$vendor" ] || die "no vendor partition: LineageOS 24 needs the 512 MiB community vendor partition for the Adreno 530 GPU firmware (a530_zap); create it with tools/axon7-make-vendor.sh or install LineageOS 22.2 first"

ui "Writing system (super, $((super_size / 1048576)) MiB), takes a few minutes..."
unzip -p "$ZIP" super.raw.gz | gunzip -c | dd of="$sys" bs=1048576 2>/dev/null || die "writing super failed"
sync
ui "Checking system..."
got=$(dd if="$sys" bs=1048576 count=$((super_size / 1048576)) 2>/dev/null | sha1sum | cut -d' ' -f1)
[ "$got" = "$(cat super.raw.sha1)" ] || die "system does not read back correctly (do not boot LineageOS 24; flash again)"

ui "Writing los_boot..."
dd if=los-boot.img of="$lb" bs=1048576 2>/dev/null || die "writing los_boot failed"
sync
[ "$(dd if="$lb" bs="$boot_size" count=1 2>/dev/null | sha1sum | cut -d' ' -f1)" = "$(cat los-boot.img.sha1)" ] || die "los_boot does not read back correctly"

ui "Erasing LineageOS data (los_metadata, los_data)..."
dd if=/dev/zero of="$lm" bs=1048576 count=16 2>/dev/null; dd if=/dev/zero of="$ld" bs=1048576 count=64 2>/dev/null; sync
rm -rf "$TMP_BASE/los24"
unmount_all
ui "Done. Reboot, then choose LineageOS in the boot menu."
ui "The first start takes a few minutes."
exit 0
