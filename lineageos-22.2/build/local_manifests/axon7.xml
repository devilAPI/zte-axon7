<?xml version="1.0" encoding="UTF-8"?>
<!--
  LineageOS 22.2 bring-up manifest for ZTE Axon 7 (axon7 / ailsa_ii).
  Copy to <tree>/.repo/local_manifests/axon7.xml after `repo init`.

  No lineage-19.1+ axon7 sources exist yet (checked 2026-11-05). The newest
  sources are Ricky Cheung's (GitHub: blueyfish, "tipzbuilds") lineage-18.1
  branches. Treat these entries as starting points to forward-port. Once you
  start committing, point each one at your own copy (a bare git repo on the
  build box works: <remote name="local" fetch="file:///srv/git/" />).

  Keep reference trees (gemini, LG msm8996, the 3.18 axon7 kernel) OUTSIDE
  this source tree. Soong parses every Android.bp under the tree, and trees
  whose vendor repos are missing can break the build.
-->
<manifest>
  <!-- remote "github" (https://github.com/) comes from LineageOS's default
       manifest; declaring it again here makes `repo sync` fail with "remote
       github already exists with different attributes". -->

  <!-- Device tree to forward-port from 18.1 to 22.2. Model it on
       LineageOS/android_device_xiaomi_msm8996-common lineage-22.2. -->
  <project path="device/zte/axon7"
           name="blueyfish/android_device_zte_axon7"
           remote="github" revision="lineage-18.1" />

  <!-- Kernel: the 3.18 axon7 kernel cannot run LineageOS 19.1+. Start from the
       msm8996 4.4 kernel that gemini/LG use on 22.2, then port in the axon7
       DTS and drivers. Keeping the path kernel/zte/msm8996 leaves the device
       tree's TARGET_KERNEL_SOURCE valid. repo rejects clone-depth="0", so
       with a depth-1 repo init these two come shallow too: unshallow them
       (git fetch, option unshallow) in device/zte/axon7 and
       kernel/zte/msm8996 after the sync for the full history. -->
  <project path="kernel/zte/msm8996"
           name="LineageOS/android_kernel_xiaomi_msm8996"
           remote="github" revision="lineage-22.2" />

  <!-- Proprietary blobs from the 18.1 port (Oreo A2017G based) -->
  <project path="vendor/zte"
           name="blueyfish/proprietary_vendor_zte"
           remote="github" revision="lineage-18.1" />

  <!-- The default LineageOS 22.2 manifest already provides packages/apps/FlipFlap,
       hardware/qcom-caf/msm8996/{audio,display,media},
       device/qcom/sepolicy-legacy-um (lineage-22.2-legacy-um) and hardware/ril. -->
</manifest>
