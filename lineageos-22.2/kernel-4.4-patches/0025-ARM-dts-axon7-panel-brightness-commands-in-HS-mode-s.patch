From 9a846a9038010d27a21e7a072c2b516919367af2 Mon Sep 17 00:00:00 2001
From: axon7-build <axon7-build@localhost>
Date: Sun, 8 Nov 2026 11:50:01 +0000
Subject: [PATCH] ARM: dts: axon7: panel brightness commands in HS mode (slider
 did nothing; halves differed after wake)

Change-Id: I70bbd5991411a392e83190fddd1fa9a6b622f4b6
---
 ...si-panel-zte-samsung-s6e3ha3-5p5-wqhd-dualmipi-cmd.dtsi | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/dsi-panel-zte-samsung-s6e3ha3-5p5-wqhd-dualmipi-cmd.dtsi b/arch/arm/boot/dts/qcom/dsi-panel-zte-samsung-s6e3ha3-5p5-wqhd-dualmipi-cmd.dtsi
index 770e8c15be60..4be905772ceb 100644
--- a/arch/arm/boot/dts/qcom/dsi-panel-zte-samsung-s6e3ha3-5p5-wqhd-dualmipi-cmd.dtsi
+++ b/arch/arm/boot/dts/qcom/dsi-panel-zte-samsung-s6e3ha3-5p5-wqhd-dualmipi-cmd.dtsi
@@ -86,6 +86,13 @@
 		qcom,mdss-mdp-transfer-time-us = <12500>;
 		qcom,mdss-dsi-lp11-init;
 		qcom,mdss-dsi-bl-pmic-control-type ="bl_ctrl_dcs";
+		/*
+		 * Brightness (DCS 0x51) in high-speed mode: the panel ignores LP
+		 * commands (ZTE's 3.18 driver hardcoded CMD_REQ_HS_MODE for it).
+		 * In LP mode the slider did nothing, and after a wake each half
+		 * kept its own reset brightness (the on-commands have no 0x51).
+		 */
+		qcom,mdss-dsi-bl-dcs-command-state = "dsi_hs_mode";
 		qcom,mdss-dsi-bl-min-level = <1>;
 		qcom,mdss-dsi-bl-max-level = <255>;
 		qcom,mdss-dsi-on-command = [
-- 
2.47.3

