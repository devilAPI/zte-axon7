+			//snd_soc_write(ak4490_codec,val[i],val[i+1]);
+			ak4490_i2c_write(ak4490_codec,val[i],val[i+1]);
+			pr_err("[LHS] write reg add=%x , val =%x \n",val[i],val[i+1]);
+		}
+	return count;
+	//return 0;
