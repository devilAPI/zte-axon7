From fc07ede88aac02cd84b851ec4cb1db9c38aa8622 Mon Sep 17 00:00:00 2001
From: axon7-build <axon7-build@localhost>
Date: Sun, 8 Nov 2026 13:40:00 +0000
Subject: [PATCH 30/32] msm: camera: axon7 OIS enable GPIO
 (qcom,platform-ois-en-gpio) switched by the sensor power sequence, as ZTE
 does (OIS never powered: CCI timeouts, rear sensor init failed)

Change-Id: I622c0aacd99aa15dd7bcdd8f1faf139e71ead38f
---
 .../camera_v2/sensor/io/msm_camera_dt_util.c  | 26 +++++++++++++++++++
 .../msm/camera_v2/sensor/msm_sensor_driver.c  |  6 +++++
 include/soc/qcom/camera2.h                    |  2 ++
 3 files changed, 34 insertions(+)

diff --git a/drivers/media/platform/msm/camera_v2/sensor/io/msm_camera_dt_util.c b/drivers/media/platform/msm/camera_v2/sensor/io/msm_camera_dt_util.c
index e0eea938e3ee..deec7aa5cf9d 100644
--- a/drivers/media/platform/msm/camera_v2/sensor/io/msm_camera_dt_util.c
+++ b/drivers/media/platform/msm/camera_v2/sensor/io/msm_camera_dt_util.c
@@ -1478,6 +1478,8 @@ int msm_camera_power_up(struct msm_camera_power_ctrl_t *ctrl,
 			pr_err("%s:%d cannot set pin to active state",
 				__func__, __LINE__);
 	}
+	if (ctrl->ois_en_gpio > 0 && gpio_request(ctrl->ois_en_gpio, "ois_enable"))
+		pr_err("%s: request ois_en gpio %d failed\n", __func__, ctrl->ois_en_gpio);
 	for (index = 0; index < ctrl->power_setting_size; index++) {
 		CDBG("%s index %d\n", __func__, index);
 		power_setting = &ctrl->power_setting[index];
@@ -1552,6 +1554,13 @@ int msm_camera_power_up(struct msm_camera_power_ctrl_t *ctrl,
 				goto power_up_failed;
 			}
 			break;
+		case SENSOR_PMIC:
+			/* ZTE: the sensor's power sequence switches the OIS on */
+			if (ctrl->ois_en_gpio > 0 &&
+			    power_setting->seq_val == SENSOR_PMIC_GPIO_OIS)
+				gpio_direction_output(ctrl->ois_en_gpio,
+					(int) power_setting->config_val);
+			break;
 		case SENSOR_I2C_MUX:
 			if (ctrl->i2c_conf && ctrl->i2c_conf->use_i2c_mux)
 				msm_camera_enable_i2c_mux(ctrl->i2c_conf);
@@ -1612,6 +1621,11 @@ power_up_failed:
 			msm_cam_sensor_handle_reg_gpio(power_setting->seq_val,
 				ctrl->gpio_conf, GPIOF_OUT_INIT_LOW);
 			break;
+		case SENSOR_PMIC:
+			if (ctrl->ois_en_gpio > 0 &&
+			    power_setting->seq_val == SENSOR_PMIC_GPIO_OIS)
+				gpio_direction_output(ctrl->ois_en_gpio, 0);
+			break;
 		case SENSOR_I2C_MUX:
 			if (ctrl->i2c_conf && ctrl->i2c_conf->use_i2c_mux)
 				msm_camera_disable_i2c_mux(ctrl->i2c_conf);
@@ -1640,6 +1654,8 @@ power_up_failed:
 	msm_camera_request_gpio_table(
 		ctrl->gpio_conf->cam_gpio_req_tbl,
 		ctrl->gpio_conf->cam_gpio_req_tbl_size, 0);
+	if (ctrl->ois_en_gpio > 0)
+		gpio_free(ctrl->ois_en_gpio);
 	return rc;
 }
 
@@ -1742,6 +1758,12 @@ int msm_camera_power_down(struct msm_camera_power_ctrl_t *ctrl,
 				pr_err("ERR:%s Error while disabling VREG GPIO\n",
 					__func__);
 			break;
+		case SENSOR_PMIC:
+			if (ctrl->ois_en_gpio > 0 &&
+			    pd->seq_val == SENSOR_PMIC_GPIO_OIS)
+				gpio_direction_output(ctrl->ois_en_gpio,
+					(int) pd->config_val);
+			break;
 		case SENSOR_I2C_MUX:
 			if (ctrl->i2c_conf && ctrl->i2c_conf->use_i2c_mux)
 				msm_camera_disable_i2c_mux(ctrl->i2c_conf);
@@ -1770,6 +1792,10 @@ int msm_camera_power_down(struct msm_camera_power_ctrl_t *ctrl,
 	msm_camera_request_gpio_table(
 		ctrl->gpio_conf->cam_gpio_req_tbl,
 		ctrl->gpio_conf->cam_gpio_req_tbl_size, 0);
+	if (ctrl->ois_en_gpio > 0) {
+		gpio_direction_output(ctrl->ois_en_gpio, 0);
+		gpio_free(ctrl->ois_en_gpio);
+	}
 	CDBG("%s exit\n", __func__);
 	return 0;
 }
diff --git a/drivers/media/platform/msm/camera_v2/sensor/msm_sensor_driver.c b/drivers/media/platform/msm/camera_v2/sensor/msm_sensor_driver.c
index 4a60507436e1..970395525a4b 100644
--- a/drivers/media/platform/msm/camera_v2/sensor/msm_sensor_driver.c
+++ b/drivers/media/platform/msm/camera_v2/sensor/msm_sensor_driver.c
@@ -1332,6 +1332,12 @@ static int32_t msm_sensor_driver_get_dt_data(struct msm_sensor_ctrl_t *s_ctrl)
 		rc = 0;
 	}
 
+	/* axon7 (ZTE): OIS enable line, switched by the power sequence */
+	sensordata->power_info.ois_en_gpio = of_get_named_gpio(of_node,
+		"qcom,platform-ois-en-gpio", 0);
+	if (!gpio_is_valid(sensordata->power_info.ois_en_gpio))
+		sensordata->power_info.ois_en_gpio = -EINVAL;
+
 	/* Get CCI master */
 	rc = of_property_read_u32(of_node, "qcom,cci-master",
 		&s_ctrl->cci_i2c_master);
diff --git a/include/soc/qcom/camera2.h b/include/soc/qcom/camera2.h
index 5a61d2b372c3..1aac99113601 100644
--- a/include/soc/qcom/camera2.h
+++ b/include/soc/qcom/camera2.h
@@ -110,6 +110,8 @@ struct msm_camera_power_ctrl_t {
 	struct msm_pinctrl_info pinctrl_info;
 	uint8_t cam_pinctrl_status;
 	size_t clk_info_size;
+	/* axon7: OIS enable GPIO (qcom,platform-ois-en-gpio), <= 0 = none */
+	int ois_en_gpio;
 };
 
 enum msm_camera_actuator_name {
-- 
2.47.3

