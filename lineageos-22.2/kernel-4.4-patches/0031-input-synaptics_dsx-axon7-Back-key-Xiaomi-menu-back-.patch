From 41056eafb1097a854860a12d09780d0a705bcc98 Mon Sep 17 00:00:00 2001
From: axon7-build <axon7-build@localhost>
Date: Sun, 8 Nov 2026 13:49:18 +0000
Subject: [PATCH 31/32] input: synaptics_dsx: axon7 Back key (Xiaomi menu/back
 swap dropped it); swap = back <-> app switch

Change-Id: I937092ef1618d316627f12285d7d5a81ceae24f8
---
 .../synaptics_dsx/synaptics_dsx_core.c        | 19 +++++++++++--------
 1 file changed, 11 insertions(+), 8 deletions(-)

diff --git a/drivers/input/touchscreen/synaptics_dsx/synaptics_dsx_core.c b/drivers/input/touchscreen/synaptics_dsx/synaptics_dsx_core.c
index 43ad2aeb5958..51646e381e7e 100644
--- a/drivers/input/touchscreen/synaptics_dsx/synaptics_dsx_core.c
+++ b/drivers/input/touchscreen/synaptics_dsx/synaptics_dsx_core.c
@@ -1650,14 +1650,17 @@ static int synaptics_rmi4_f12_abs_report(struct synaptics_rmi4_data *rmi4_data,
 static void synaptics_rmi4_report_key(struct synaptics_rmi4_data *rmi4_data,
 		int key, int status)
 {
-	if (key == KEY_MENU)
-		input_report_key(rmi4_data->input_dev,
-				rmi4_data->enable_reversed_keys ? KEY_MENU : KEY_BACK, status);
-	else if (key == KEY_BACK)
-		input_report_key(rmi4_data->input_dev,
-				rmi4_data->enable_reversed_keys ? KEY_BACK : KEY_MENU, status);
-	else
-		input_report_key(rmi4_data->input_dev, key, status);
+	/*
+	 * Axon 7 keys (cap-button-codes): back, home, app switch (KEY_F17).
+	 * The Xiaomi version turned KEY_BACK into KEY_MENU (Mi 5: menu, home,
+	 * back), which this input device never declares, so Back was dropped.
+	 * "Swap buttons" here swaps back and app switch.
+	 */
+	if (rmi4_data->enable_reversed_keys && key == KEY_BACK)
+		key = KEY_F17;
+	else if (rmi4_data->enable_reversed_keys && key == KEY_F17)
+		key = KEY_BACK;
+	input_report_key(rmi4_data->input_dev, key, status);
 }
 
 static void synaptics_rmi4_f1a_report(struct synaptics_rmi4_data *rmi4_data,
-- 
