From 41653d8a281e2cbb23399c2c751e542b624b3298 Mon Sep 17 00:00:00 2001
From: axon7-build <axon7-build@localhost>
Date: Mon, 9 Nov 2026 13:35:29 +0000
Subject: [PATCH] axon7: standalone build (TWRP zip) with AXON7_STANDALONE

AXON7_STANDALONE=1 builds the release ROM: /data on userdata, the
microSD card for Android, no multi-boot. AXON7_STANDALONE=devtest is the
same, but keeps /data on los_data so the zip can be tested on the
multi-boot phone. Without the variable, the multi-boot fstab is used.

The standalone fstabs name system and vendor by the platform by-name path:
TWRP for ailsa_ii has no /dev/block/by-name, and the OTA updater-script
takes its block devices from the recovery fstab.

Change-Id: I203322ec262b2369ae6732d0c31706ef5b4e93d9
---
 BoardConfig.mk                     |  3 ++-
 axon7-fstab.mk                     | 16 ++++++++++++++++
 device.mk                          |  3 ++-
 init/Android.bp                    | 27 ++++++++++++++++++++++++++-
 init/fstab.standalone-devtest.qcom | 28 ++++++++++++++++++++++++++++
 init/fstab.standalone.qcom         | 28 ++++++++++++++++++++++++++++
 6 files changed, 102 insertions(+), 3 deletions(-)
 create mode 100644 axon7-fstab.mk
 create mode 100644 init/fstab.standalone-devtest.qcom
 create mode 100644 init/fstab.standalone.qcom

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 7344a81..28fc808 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -197,7 +197,8 @@ TARGET_VENDOR_PROP += $(PLATFORM_PATH)/vendor.prop
 ENABLE_VENDOR_RIL_SERVICE := true
 
 # Recovery
-TARGET_RECOVERY_FSTAB := $(PLATFORM_PATH)/init/fstab.qcom
+include device/zte/axon7/axon7-fstab.mk
+TARGET_RECOVERY_FSTAB := $(PLATFORM_PATH)/init/$(AXON7_FSTAB)
 TARGET_RECOVERY_PIXEL_FORMAT := RGBX_8888
 TARGET_RECOVERY_UI_BLANK_UNBLANK_ON_INIT := true
 TARGET_USERIMAGES_USE_EXT4 := true
diff --git a/axon7-fstab.mk b/axon7-fstab.mk
new file mode 100644
index 0000000..ef37987
--- /dev/null
+++ b/axon7-fstab.mk
@@ -0,0 +1,16 @@
+# Which fstab the build uses (included by BoardConfig.mk and device.mk;
+# product makefiles are read before BoardConfig.mk).
+# fstab: multi-boot (default), standalone TWRP zip (AXON7_STANDALONE=1) or the
+# standalone image tested on the multi-boot phone (AXON7_STANDALONE=devtest)
+ifeq ($(AXON7_STANDALONE),1)
+AXON7_FSTAB := fstab.standalone.qcom
+else ifeq ($(AXON7_STANDALONE),devtest)
+AXON7_FSTAB := fstab.standalone-devtest.qcom
+else
+AXON7_FSTAB := fstab.qcom
+endif
+ifeq ($(AXON7_STANDALONE),1)
+$(call soong_config_set,axon7,standalone,release)
+else ifeq ($(AXON7_STANDALONE),devtest)
+$(call soong_config_set,axon7,standalone,devtest)
+endif
diff --git a/device.mk b/device.mk
index dac9a7a..c05ba08 100644
--- a/device.mk
+++ b/device.mk
@@ -160,9 +160,10 @@ PRODUCT_PACKAGES += \
 PRODUCT_PACKAGES += \
     charger_res_images
 
+include device/zte/axon7/axon7-fstab.mk
 # fstab: first stage init (no DT fstab) reads it from the boot ramdisk root
 PRODUCT_COPY_FILES += \
-    $(LOCAL_PATH)/init/fstab.qcom:$(TARGET_COPY_OUT_RAMDISK)/fstab.qcom
+    $(LOCAL_PATH)/init/$(AXON7_FSTAB):$(TARGET_COPY_OUT_RAMDISK)/fstab.qcom
 
 # Common init scripts
 PRODUCT_PACKAGES += \
diff --git a/init/Android.bp b/init/Android.bp
index 692fe5f..86c1d71 100644
--- a/init/Android.bp
+++ b/init/Android.bp
@@ -16,9 +16,34 @@ cc_library_static {
     ],
 }
 
-prebuilt_etc {
+// fstab.qcom: multi-boot (default), standalone TWRP zip (AXON7_STANDALONE=1)
+// or the standalone image on the multi-boot dev phone (AXON7_STANDALONE=devtest)
+soong_config_module_type {
+    name: "axon7_fstab_prebuilt_etc",
+    module_type: "prebuilt_etc",
+    config_namespace: "axon7",
+    variables: ["standalone"],
+    properties: ["src"],
+}
+
+soong_config_string_variable {
+    name: "standalone",
+    values: ["release", "devtest"],
+}
+
+axon7_fstab_prebuilt_etc {
     name: "fstab.qcom",
     src: "fstab.qcom",
+    soong_config_variables: {
+        standalone: {
+            release: {
+                src: "fstab.standalone.qcom",
+            },
+            devtest: {
+                src: "fstab.standalone-devtest.qcom",
+            },
+        },
+    },
     soc_specific: true,
     ramdisk_available: true,
 }
diff --git a/init/fstab.standalone-devtest.qcom b/init/fstab.standalone-devtest.qcom
new file mode 100644
index 0000000..73b1f6e
--- /dev/null
+++ b/init/fstab.standalone-devtest.qcom
@@ -0,0 +1,28 @@
+# Android fstab file.
+# The filesystem that contains the filesystem e2fsck binary (typically /system) cannot
+# specify 'check', and must come before any filesystems that do specify 'check'
+
+# 22.2 (as msm8996-common): system/vendor first-stage mounted from here (no
+# DT fstab), /data ext4 with file-based encryption: moving from 18.1's
+# footer encryption needs a format of userdata.
+# Standalone test build on the multi-boot development phone
+# (AXON7_STANDALONE=devtest): the standalone image, but /data is los_data,
+# because userdata holds the iOS root there. Not for release.
+# system/vendor: the platform by-name path exists both in first stage init and in
+# TWRP (which has no /dev/block/by-name), so the TWRP zip finds the partitions.
+#<src>                                       <mnt_point>        <type>  <mnt_flags and options>                                     <fs_mgr_flags>
+/dev/block/bootdevice/by-name/boot           /boot              emmc    defaults                                                    recoveryonly
+/dev/block/bootdevice/by-name/recovery       /recovery          emmc    defaults                                                    recoveryonly
+/dev/block/bootdevice/by-name/cache          /cache             ext4    nosuid,nodev,noatime,barrier=1                              wait,check,formattable
+/dev/block/bootdevice/by-name/los_data       /data              ext4    nosuid,nodev,noatime,barrier=1,noauto_da_alloc              latemount,wait,check,fileencryption=ice,quota,formattable
+/dev/block/platform/soc/624000.ufshc/by-name/system /system            ext4    ro,barrier=1                                                wait,first_stage_mount
+/dev/block/platform/soc/624000.ufshc/by-name/vendor /vendor            ext4    ro,barrier=1                                                wait,first_stage_mount
+/dev/block/bootdevice/by-name/persist        /mnt/vendor/persist     ext4    nosuid,nodev,noatime,barrier=1                                                                    wait
+/dev/block/bootdevice/by-name/dsp            /vendor/dsp             ext4    ro,nosuid,nodev,barrier=1,context=u:object_r:adsprpcd_file:s0                                     wait,nofail
+/dev/block/bootdevice/by-name/modem          /vendor/firmware_mnt    vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0      wait
+/dev/block/bootdevice/by-name/bluetooth      /vendor/bt_firmware     vfat    ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0   wait
+/dev/block/bootdevice/by-name/misc           /misc              emmc    defaults                                                    defaults
+/dev/block/zram0                             none               swap    defaults                                                    zramsize=536870912,max_comp_streams=4
+
+#/devices/soc/74a4900.sdhci/mmc_host*                                auto               auto    defaults                                                    voldmanaged=sdcard1:auto   (devtest: the card is postmarketOS)
+/devices/soc/6a00000.ssusb/6a00000.dwc3/xhci-hcd.0.auto/usb*        auto               auto    defaults                                                    voldmanaged=usbdisk:auto
diff --git a/init/fstab.standalone.qcom b/init/fstab.standalone.qcom
new file mode 100644
index 0000000..56a6df1
--- /dev/null
+++ b/init/fstab.standalone.qcom
@@ -0,0 +1,28 @@
+# Android fstab file.
+# The filesystem that contains the filesystem e2fsck binary (typically /system) cannot
+# specify 'check', and must come before any filesystems that do specify 'check'
+
+# 22.2 (as msm8996-common): system/vendor first-stage mounted from here (no
+# DT fstab), /data ext4 with file-based encryption: moving from 18.1's
+# footer encryption needs a format of userdata.
+# Standalone (AXON7_STANDALONE=1, the TWRP zip): /data is userdata and the
+# microSD card is adoptable/portable storage. Partition layout: ZTE's plus the
+# community vendor partition (512 MiB after system, Oki's PARTY tool).
+# system/vendor: the platform by-name path exists both in first stage init and in
+# TWRP (which has no /dev/block/by-name), so the TWRP zip finds the partitions.
+#<src>                                       <mnt_point>        <type>  <mnt_flags and options>                                     <fs_mgr_flags>
+/dev/block/bootdevice/by-name/boot           /boot              emmc    defaults                                                    recoveryonly
+/dev/block/bootdevice/by-name/recovery       /recovery          emmc    defaults                                                    recoveryonly
+/dev/block/bootdevice/by-name/cache          /cache             ext4    nosuid,nodev,noatime,barrier=1                              wait,check,formattable
+/dev/block/bootdevice/by-name/userdata       /data              ext4    nosuid,nodev,noatime,barrier=1,noauto_da_alloc              latemount,wait,check,fileencryption=ice,quota,formattable
+/dev/block/platform/soc/624000.ufshc/by-name/system /system            ext4    ro,barrier=1                                                wait,first_stage_mount
+/dev/block/platform/soc/624000.ufshc/by-name/vendor /vendor            ext4    ro,barrier=1                                                wait,first_stage_mount
+/dev/block/bootdevice/by-name/persist        /mnt/vendor/persist     ext4    nosuid,nodev,noatime,barrier=1                                                                    wait
+/dev/block/bootdevice/by-name/dsp            /vendor/dsp             ext4    ro,nosuid,nodev,barrier=1,context=u:object_r:adsprpcd_file:s0                                     wait,nofail
+/dev/block/bootdevice/by-name/modem          /vendor/firmware_mnt    vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0      wait
+/dev/block/bootdevice/by-name/bluetooth      /vendor/bt_firmware     vfat    ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0   wait
+/dev/block/bootdevice/by-name/misc           /misc              emmc    defaults                                                    defaults
+/dev/block/zram0                             none               swap    defaults                                                    zramsize=536870912,max_comp_streams=4
+
+/devices/soc/74a4900.sdhci/mmc_host*                                auto               auto    defaults                                                    voldmanaged=sdcard1:auto
+/devices/soc/6a00000.ssusb/6a00000.dwc3/xhci-hcd.0.auto/usb*        auto               auto    defaults                                                    voldmanaged=usbdisk:auto
