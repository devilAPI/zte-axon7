diff --git a/doze/Android.bp b/doze/Android.bp
new file mode 100644
index 0000000..76c4e60
--- /dev/null
+++ b/doze/Android.bp
@@ -0,0 +1,36 @@
+//
+// Copyright (C) 2017-2026 The LineageOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// Ambient display gestures (pick-up, hand wave, pocket), the doze part of
+// msm8996-common's XiaomiParts (lineage-22.2).
+
+android_app {
+    name: "ZteDoze",
+
+    srcs: ["src/**/*.java"],
+    resource_dirs: ["res"],
+    certificate: "platform",
+    platform_apis: true,
+    privileged: true,
+    required: ["zte_doze_whitelist"],
+    system_ext_specific: true,
+
+    static_libs: [
+        "org.lineageos.platform.internal",
+        "org.lineageos.settings.resources",
+    ],
+
+    optimize: {
+        proguard_flags_files: ["proguard.flags"],
+    },
+}
+
+prebuilt_etc {
+    name: "zte_doze_whitelist",
+    system_ext_specific: true,
+    sub_dir: "sysconfig",
+    src: "zte_doze_whitelist.xml",
+    filename_from_src: true,
+}
