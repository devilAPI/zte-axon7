From 7bebfbde68caf63e438bb47a60d3b1b2261eac8b Mon Sep 17 00:00:00 2001
From: axon7-port <axon7-port@localhost>
Date: Fri, 27 Nov 2026 10:10:02 +0100
Subject: [PATCH] axon7: stock layout, SELinux labels and fs_config for
 /system/vendor

Found by comparing the stock-layout system image with the vendor image
(ci/verify-stock-image.py): with the vendor files inside system,
- 63 entries under /system/vendor/firmware, bt_firmware and firmware_mnt
  were plain vendor_file (the qcom legacy sepolicy labels the /vendor path
  only): sepolicy/novendor/file_contexts;
- the daemons of config.fs (vendor/bin/...) lost their owner and file
  capabilities: without a vendor image the build does not install
  fs_config_{dirs,files}_vendor; install them (libcutils aliases
  system/vendor/<x> to vendor/<x>).
Only for AXON7_STANDALONE=novendor; the vendor-partition build is unchanged.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 Android.mk                      | 17 +++++++++++++++++
 BoardConfig.mk                  |  3 +++
 device.mk                       | 10 ++++++++++
 sepolicy/novendor/file_contexts |  8 ++++++++
 4 files changed, 38 insertions(+)
 create mode 100644 sepolicy/novendor/file_contexts

diff --git a/Android.mk b/Android.mk
index 1916789..d3e5e46 100644
--- a/Android.mk
+++ b/Android.mk
@@ -28,4 +28,21 @@ LOCAL_PATH := $(call my-dir)
 
 ifeq ($(TARGET_DEVICE),axon7)
 include $(call all-makefiles-under,$(LOCAL_PATH))
+
+# Stock partition layout (AXON7_STANDALONE=novendor): the host fs_config tool that
+# writes META/filesystem_config.txt (owners, modes, file capabilities of the system
+# image) reads the vendor entries from $(PRODUCT_OUT)/vendor/etc/fs_config_*, the
+# place of a separate vendor partition. Here they are installed into system/vendor/etc
+# (device.mk), so copy them there before the system's own fs_config files, a
+# prerequisite of the target files, are done.
+ifeq ($(AXON7_STANDALONE),novendor)
+$(PRODUCT_OUT)/vendor/etc/fs_config_dirs: $(TARGET_OUT_VENDOR)/etc/fs_config_dirs
+	@mkdir -p $(dir $@)
+	$(hide) cp -f $< $@
+$(PRODUCT_OUT)/vendor/etc/fs_config_files: $(TARGET_OUT_VENDOR)/etc/fs_config_files
+	@mkdir -p $(dir $@)
+	$(hide) cp -f $< $@
+$(TARGET_OUT)/etc/fs_config_dirs: $(PRODUCT_OUT)/vendor/etc/fs_config_dirs
+$(TARGET_OUT)/etc/fs_config_files: $(PRODUCT_OUT)/vendor/etc/fs_config_files
+endif
 endif
diff --git a/BoardConfig.mk b/BoardConfig.mk
index a2e7cf9..0d6bc33 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -224,6 +224,9 @@ VENDOR_SECURITY_PATCH := 2018-12-01
 include device/qcom/sepolicy-legacy-um/SEPolicy.mk
 
 BOARD_VENDOR_SEPOLICY_DIRS += $(PLATFORM_PATH)/sepolicy/vendor
+ifeq ($(AXON7_STANDALONE),novendor)
+BOARD_VENDOR_SEPOLICY_DIRS += $(PLATFORM_PATH)/sepolicy/novendor
+endif
 SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(PLATFORM_PATH)/sepolicy/private
 
 # Treble
diff --git a/device.mk b/device.mk
index c05ba08..c51ca3d 100644
--- a/device.mk
+++ b/device.mk
@@ -520,3 +520,13 @@ endif
 # Flashlight strength slider (QS flashlight tile, long press)
 PRODUCT_COPY_FILES += \
     $(LOCAL_PATH)/configs/init/init.axon7-torch.rc:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/init/init.axon7-torch.rc
+
+# Stock partition layout (AXON7_STANDALONE=novendor): without a vendor image the build
+# does not install the vendor fs_config files, so config.fs (vendor/bin/... owners and
+# file capabilities) would not apply to /system/vendor. libcutils aliases
+# system/vendor/<x> to vendor/<x> when matching, so installing them is enough.
+ifeq ($(AXON7_STANDALONE),novendor)
+PRODUCT_PACKAGES += \
+    fs_config_dirs_vendor \
+    fs_config_files_vendor
+endif
diff --git a/sepolicy/novendor/file_contexts b/sepolicy/novendor/file_contexts
new file mode 100644
index 0000000..aded424
--- /dev/null
+++ b/sepolicy/novendor/file_contexts
@@ -0,0 +1,8 @@
+# Stock partition layout (AXON7_STANDALONE=novendor): the vendor files live in
+# /system/vendor. device/qcom/sepolicy-legacy-um labels the firmware directories
+# for the /vendor path only, so without these lines every file under
+# /system/vendor/firmware would be plain vendor_file (found by comparing the
+# stock-layout system image with the vendor image, ci/verify-stock-image.py).
+/system/vendor/firmware(/.*)?                      u:object_r:vendor_firmware_file:s0
+/system/vendor/bt_firmware(/.*)?                   u:object_r:bt_firmware_file:s0
+/system/vendor/firmware_mnt(/.*)?                  u:object_r:firmware_file:s0
-- 
