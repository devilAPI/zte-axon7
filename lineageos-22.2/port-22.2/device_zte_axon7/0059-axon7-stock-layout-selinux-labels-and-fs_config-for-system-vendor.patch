From 6a9a0d89daa9cfe479ae913541a5398be21554ab Mon Sep 17 00:00:00 2001
From: axon7-port <axon7-port@localhost>
Date: Fri, 27 Nov 2026 10:10:02 +0100
Subject: [PATCH] axon7: stock layout, SELinux labels and fs_config for
 /system/vendor

Found by comparing the stock-layout system image with the vendor image
(ci/verify-stock-image.py): with the vendor files inside system,
- 63 entries under /system/vendor/firmware, bt_firmware and firmware_mnt
  were plain vendor_file (the qcom legacy sepolicy labels the /vendor path
  only): sepolicy/novendor/file_contexts;
- the daemons of config.fs (vendor/bin/...) lost their owner and file
  capabilities (the entries match the vendor/ prefix only):
  config.novendor.fs with the system/vendor/ prefix.
Only for AXON7_STANDALONE=novendor; the vendor-partition build is unchanged.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 BoardConfig.mk                  |  6 +++
 config.novendor.fs              | 77 +++++++++++++++++++++++++++++++++
 sepolicy/novendor/file_contexts |  8 ++++
 3 files changed, 91 insertions(+)
 create mode 100644 config.novendor.fs
 create mode 100644 sepolicy/novendor/file_contexts

diff --git a/BoardConfig.mk b/BoardConfig.mk
index a2e7cf9..5e7dda7 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -160,6 +160,9 @@ LOC_HIDL_VERSION := 3.0
 
 # Filesystem
 TARGET_FS_CONFIG_GEN := $(PLATFORM_PATH)/config.fs
+ifeq ($(AXON7_STANDALONE),novendor)
+TARGET_FS_CONFIG_GEN += $(PLATFORM_PATH)/config.novendor.fs
+endif
 
 # Keystore
 TARGET_PROVIDES_KEYMASTER := true
@@ -224,6 +227,9 @@ VENDOR_SECURITY_PATCH := 2018-12-01
 include device/qcom/sepolicy-legacy-um/SEPolicy.mk
 
 BOARD_VENDOR_SEPOLICY_DIRS += $(PLATFORM_PATH)/sepolicy/vendor
+ifeq ($(AXON7_STANDALONE),novendor)
+BOARD_VENDOR_SEPOLICY_DIRS += $(PLATFORM_PATH)/sepolicy/novendor
+endif
 SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(PLATFORM_PATH)/sepolicy/private
 
 # Treble
diff --git a/config.novendor.fs b/config.novendor.fs
new file mode 100644
index 0000000..419083f
--- /dev/null
+++ b/config.novendor.fs
@@ -0,0 +1,77 @@
+# Stock layout (AXON7_STANDALONE=novendor): the vendor files are installed under
+# system/vendor, where the entries of config.fs (written for the vendor partition's
+# vendor/ prefix) match nothing, so the daemons lost their owner and file capabilities
+# (found by ci/verify-stock-image.py). Same entries for the system/vendor prefix.
+
+
+[system/vendor/bin/hw/android.hardware.bluetooth@1.0-service-qti]
+mode: 0755
+user: AID_BLUETOOTH
+group: AID_BLUETOOTH
+caps: BLOCK_SUSPEND NET_ADMIN
+
+[system/vendor/bin/pm-service]
+mode: 0755
+user: AID_SYSTEM
+group: AID_SYSTEM
+caps: NET_BIND_SERVICE
+
+[system/vendor/bin/pd-mapper]
+mode: 0755
+user: AID_SYSTEM
+group: AID_SYSTEM
+caps: NET_BIND_SERVICE
+
+[system/vendor/bin/imsdatadaemon]
+mode: 0755
+user: AID_SYSTEM
+group: AID_SYSTEM
+caps: NET_BIND_SERVICE
+
+[system/vendor/bin/ims_rtp_daemon]
+mode: 0755
+user: AID_SYSTEM
+group: AID_RADIO
+caps: NET_BIND_SERVICE
+
+[system/vendor/bin/imsrcsd]
+mode: 0755
+user: AID_SYSTEM
+group: AID_RADIO
+caps: NET_BIND_SERVICE BLOCK_SUSPEND WAKE_ALARM
+
+[system/vendor/bin/cnd]
+mode: 0755
+user: AID_SYSTEM
+group: AID_SYSTEM
+caps: NET_BIND_SERVICE BLOCK_SUSPEND NET_ADMIN
+
+[system/vendor/bin/slim_daemon]
+mode: 0755
+user:  AID_GPS
+group: AID_GPS
+caps: NET_BIND_SERVICE
+
+[system/vendor/bin/loc_launcher]
+mode: 0755
+user:  AID_GPS
+group: AID_GPS
+caps: SETUID SETGID
+
+[system/vendor/bin/xtwifi-client]
+mode: 0755
+user:  AID_GPS
+group: AID_GPS
+caps: NET_BIND_SERVICE BLOCK_SUSPEND
+
+[system/vendor/bin/sensors.qti]
+mode: 0755
+user: AID_SYSTEM
+group: AID_SYSTEM
+caps: NET_BIND_SERVICE
+
+[system/vendor/firmware_mnt/image/*]
+mode: 0771
+user: AID_SYSTEM
+group: AID_SYSTEM
+caps: 0
diff --git a/sepolicy/novendor/file_contexts b/sepolicy/novendor/file_contexts
new file mode 100644
index 0000000..aded424
--- /dev/null
+++ b/sepolicy/novendor/file_contexts
@@ -0,0 +1,8 @@
+# Stock partition layout (AXON7_STANDALONE=novendor): the vendor files live in
+# /system/vendor. device/qcom/sepolicy-legacy-um labels the firmware directories
+# for the /vendor path only, so without these lines every file under
+# /system/vendor/firmware would be plain vendor_file (found by comparing the
+# stock-layout system image with the vendor image, ci/verify-stock-image.py).
+/system/vendor/firmware(/.*)?                      u:object_r:vendor_firmware_file:s0
+/system/vendor/bt_firmware(/.*)?                   u:object_r:bt_firmware_file:s0
+/system/vendor/firmware_mnt(/.*)?                  u:object_r:firmware_file:s0
-- 
2.43.0

