[Unit]
Description=Axon 7 modem: operating mode online (radios and GPS on)
After=rmtfs.service
Wants=rmtfs.service

[Service]
# runs for a few minutes at boot (the modem restarts itself early on), so not
# a oneshot: it must not hold up multi-user.target
Type=exec
ExecStart=/usr/libexec/axon7-modem

[Install]
WantedBy=multi-user.target
