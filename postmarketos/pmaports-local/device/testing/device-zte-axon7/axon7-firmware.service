[Unit]
Description=Axon 7 firmware from the phone's modem and vendor/system partitions (while files are missing)
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/axon7-firmware
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
