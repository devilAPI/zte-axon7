# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-zte-axon7
pkgdesc="ZTE Axon 7"
pkgver=1
pkgrel=15
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="buffyboard 
	bluez
	bluez-btmgmt
	linux-firmware-ath10k
	linux-firmware-qca
	linux-firmware-qcom
	linux-zte-axon7
	mkbootimg
	postmarketos-base
	soc-qcom-msm8996
	python3
	dtc
	rmtfs
	qrtr
	qmi-utils
	"
makedepends="devicepkg-dev"
subpackages="$pkgname-openrc"
install="$pkgname-openrc.post-install"
triggers="$pkgname.trigger=/boot"
source="
	deviceinfo
	modules-initfs
	axon7-dualboot
	axon7-dualboot-update
	axon7-bootmenu
	axon7-tripleboot-gpt
	axon7-dualboot.initd
	axon7-dualboot.service
	80-axon7-dualboot.preset
	buffyboard-zte-axon7.conf
	buffyboard.service
	axon7-console
	axon7-console.service
	getty-axon7-console.conf
	90-axon7-console.rules
	axon7-btaddr
	axon7-btaddr.service
	90-axon7-btaddr.rules
	axon7-firmware
	axon7-firmware.service
	axon7-pil-squasher
	axon7-modem
	axon7-modem.service
	axon7-gps
	ucm-zte-axon7.conf
	ucm-zte-axon7-HiFi.conf
	50-zte-axon7-lid.conf
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	# iOS + postmarketOS dual boot (axon7-dualboot is ios/tools/axon7-dualboot.py)
	install -Dm755 "$srcdir"/axon7-dualboot "$pkgdir"/usr/bin/axon7-dualboot
	install -Dm755 "$srcdir"/axon7-dualboot-update "$pkgdir"/usr/libexec/axon7-dualboot-update
	install -Dm755 "$srcdir"/axon7-bootmenu "$pkgdir"/usr/bin/axon7-bootmenu
	install -Dm755 "$srcdir"/axon7-tripleboot-gpt "$pkgdir"/usr/bin/axon7-tripleboot-gpt
	# systemd images (the OpenRC service is in $pkgname-openrc)
	install -Dm644 "$srcdir"/axon7-dualboot.service "$pkgdir"/usr/lib/systemd/system/axon7-dualboot.service
	install -Dm644 "$srcdir"/80-axon7-dualboot.preset "$pkgdir"/usr/lib/systemd/system-preset/80-axon7-dualboot.preset
	# buffyboard (on-screen keyboard) on the framebuffer console
	install -Dm644 "$srcdir"/buffyboard-zte-axon7.conf "$pkgdir"/usr/share/buffyboard/buffyboard.conf.d/50-zte-axon7.conf
	install -Dm644 "$srcdir"/buffyboard.service "$pkgdir"/usr/lib/systemd/system/buffyboard.service
	# console font and terminal size above the keyboard (axon7-console)
	install -Dm755 "$srcdir"/axon7-console "$pkgdir"/usr/libexec/axon7-console
	install -Dm644 "$srcdir"/axon7-console.service "$pkgdir"/usr/lib/systemd/system/axon7-console.service
	install -Dm644 "$srcdir"/getty-axon7-console.conf "$pkgdir"/usr/lib/systemd/system/getty@.service.d/50-axon7-console.conf
	install -Dm644 "$srcdir"/90-axon7-console.rules "$pkgdir"/usr/lib/udev/rules.d/90-axon7-console.rules
	# Bluetooth: factory address from persist (the QCA6174 has none of its own)
	install -Dm755 "$srcdir"/axon7-btaddr "$pkgdir"/usr/libexec/axon7-btaddr
	install -Dm644 "$srcdir"/axon7-btaddr.service "$pkgdir"/usr/lib/systemd/system/axon7-btaddr.service
	install -Dm644 "$srcdir"/90-axon7-btaddr.rules "$pkgdir"/usr/lib/udev/rules.d/90-axon7-btaddr.rules
	# firmware from the phone's own modem/vendor partitions at first boot, so
	# images need no proprietary files (firmware-zte-axon7 is optional)
	install -Dm755 "$srcdir"/axon7-firmware "$pkgdir"/usr/libexec/axon7-firmware
	install -Dm755 "$srcdir"/axon7-pil-squasher "$pkgdir"/usr/bin/axon7-pil-squasher
	install -Dm644 "$srcdir"/axon7-firmware.service "$pkgdir"/usr/lib/systemd/system/axon7-firmware.service
	# modem: online once rmtfs has started it (radios and GPS on); GPS tool
	install -Dm755 "$srcdir"/axon7-modem "$pkgdir"/usr/libexec/axon7-modem
	install -Dm644 "$srcdir"/axon7-modem.service "$pkgdir"/usr/lib/systemd/system/axon7-modem.service
	install -Dm755 "$srcdir"/axon7-gps "$pkgdir"/usr/bin/axon7-gps
	# audio: UCM, speakers and microphone (AK4961, TFA9890) and the Hi-Fi DAC on the jack (card "ZTE Axon 7")
	install -Dm644 "$srcdir"/ucm-zte-axon7.conf "$pkgdir/usr/share/alsa/ucm2/conf.d/apq8096/ZTE Axon 7.conf"
	install -Dm644 "$srcdir"/ucm-zte-axon7-HiFi.conf "$pkgdir"/usr/share/alsa/ucm2/zte-axon7/HiFi.conf
	# flip cover (hall sensor, SW_LID): no suspend on close, suspend does not work yet
	install -Dm644 "$srcdir"/50-zte-axon7-lid.conf "$pkgdir"/usr/lib/systemd/logind.conf.d/50-zte-axon7-lid.conf
}

openrc() {
	default_openrc

	install -Dm755 "$srcdir"/axon7-dualboot.initd "$subpkgdir"/etc/init.d/axon7-dualboot
}

