#!/bin/sh
# The QCA6174's PCIe link sometimes comes up only after the controller
# driver has given up at boot ("Device found, but not active"): the root
# port then reports the link active, but the Wi-Fi chip was never
# enumerated, so there is no wlan0. A bus rescan picks it up.
dev=/sys/bus/pci/devices/0000:01:00.0
i=0
while [ ! -e "$dev" ] && [ $i -lt 5 ]; do
	echo 1 > /sys/bus/pci/rescan
	sleep 2
	i=$((i + 1))
done
if [ -e "$dev" ]; then
	[ $i -gt 0 ] && echo "axon7-wifi-rescan: Wi-Fi chip found after $i rescan(s)"
	exit 0
fi
echo "axon7-wifi-rescan: no Wi-Fi chip on PCIe" >&2
exit 1
