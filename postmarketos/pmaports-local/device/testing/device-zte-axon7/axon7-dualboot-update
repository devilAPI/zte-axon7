#!/bin/sh
# Rebuild the postmarketOS half of the Axon 7's iOS + postmarketOS boot image
# (the boot menu starts postmarketOS, see axon7-dualboot): a new bundle
# from /boot (vmlinuz, initramfs, DTB) goes into the boot partition's ramdisk
# slot, the iOS loader shim + XNU in the kernel slot stay as they are. Run by
# the /boot apk trigger after kernel or initramfs updates and once per boot
# (axon7-dualboot service). Writes nothing unless the result passes
# `axon7-dualboot check` and differs from what the partition holds; never
# writes anything outside the real phone (apk triggers also run in
# pmbootstrap's chroot on a PC).
# Log: /var/log/axon7-dualboot.log
set -u
log=/var/log/axon7-dualboot.log
say() { echo "axon7-dualboot: $*"; echo "$(date '+%F %T') $*" >> "$log" 2>/dev/null; }

grep -q 'zte,axon7' /proc/device-tree/compatible 2>/dev/null || { echo "axon7-dualboot: not running on the Axon 7, nothing to do"; exit 0; }

. /usr/share/deviceinfo/deviceinfo 2>/dev/null || . /etc/deviceinfo 2>/dev/null || true

# Where the bundle goes: the pmos_boot partition (LUN 0) when it exists. The
# boot partition (LUN 4) is write protected while the phone runs normally, so
# it only serves as the fallback the shim reads when pmos_boot is empty.
pmos=/dev/disk/by-partlabel/pmos_boot
part=/dev/disk/by-partlabel/boot
if [ ! -b "$part" ]; then
	part=
	for u in /sys/class/block/*/uevent; do
		if grep -qx 'PARTNAME=boot' "$u" 2>/dev/null; then
			part=/dev/$(sed -n 's/^DEVNAME=//p' "$u")
			break
		fi
	done
fi
[ -n "$part" ] && [ -b "$part" ] || { say "no boot partition found, not updated"; exit 0; }

dtb=/boot/dtbs/${deviceinfo_dtb:-qcom/msm8996-zte-axon7}.dtb
[ -f "$dtb" ] || dtb=/boot/$(basename "${deviceinfo_dtb:-msm8996-zte-axon7}").dtb
for f in /boot/vmlinuz /boot/initramfs "$dtb"; do
	[ -f "$f" ] || { say "$f missing, not updated"; exit 0; }
done

tmp=$(mktemp -d) || exit 0
trap 'rm -rf "$tmp"' EXIT
dd if="$part" of="$tmp/current.img" bs=1M 2>/dev/null || { say "cannot read $part"; exit 0; }
[ -b "$pmos" ] && dd if="$pmos" of="$tmp/pmos_boot.bin" bs=1M 2>/dev/null

# The kernel command line (root partition UUIDs): from the current bundle
# (pmos_boot, else the boot partition's), else the running one.
cmdline=
[ -f "$tmp/pmos_boot.bin" ] && cmdline=$(axon7-dualboot cmdline "$tmp/pmos_boot.bin" 2>/dev/null)
[ -n "$cmdline" ] || cmdline=$(axon7-dualboot cmdline "$tmp/current.img" 2>/dev/null) || cmdline=
if [ -z "$cmdline" ]; then
	cmdline=$(cat /proc/cmdline)
	case "$cmdline" in
	*pmos_root_uuid=*) ;;
	*) say "no postmarketOS kernel command line (no bundle on $part, /proc/cmdline has no pmos_root_uuid), not updated"; exit 0 ;;
	esac
fi

if ! axon7-dualboot bundle --image /boot/vmlinuz --dtb "$dtb" --initrd /boot/initramfs --cmdline "$cmdline" -o "$tmp/pmos.bundle" >/dev/null 2>"$tmp/err"; then
	say "bundle failed: $(cat "$tmp/err")"; exit 0
fi
if [ -b "$pmos" ]; then
	size=$(stat -c %s "$tmp/pmos.bundle")
	psize=$(blockdev --getsize64 "$pmos" 2>/dev/null || echo 0)
	[ "$size" -le "$psize" ] || { say "bundle ($size bytes) larger than $pmos, not updated"; exit 0; }
	if [ -f "$tmp/pmos_boot.bin" ] && head -c "$size" "$tmp/pmos_boot.bin" | cmp -s - "$tmp/pmos.bundle"; then
		echo "axon7-dualboot: $pmos is up to date"
		exit 0
	fi
	if dd if="$tmp/pmos.bundle" of="$pmos" bs=1M conv=fsync 2>/dev/null; then
		sync
		say "updated $pmos ($size bytes, postmarketOS from /boot)"
		exit 0
	fi
	say "WRITING $pmos FAILED"
	exit 1
fi
if ! axon7-dualboot combine "$tmp/current.img" "$tmp/pmos.bundle" -o "$tmp/new.img" >/dev/null 2>"$tmp/err"; then
	say "not updated: $(cat "$tmp/err")"; exit 0
fi
axon7-dualboot check "$tmp/new.img" >/dev/null 2>&1 || { say "combined image fails its check, not updated"; exit 0; }

size=$(stat -c %s "$tmp/new.img")
if head -c "$size" "$tmp/current.img" | cmp -s - "$tmp/new.img"; then
	echo "axon7-dualboot: $part is up to date"
	exit 0
fi
if dd if="$tmp/new.img" of="$part" bs=1M conv=fsync 2>/dev/null; then
	sync
	say "updated $part ($size bytes: iOS kept, postmarketOS from /boot)"
else
	say "WRITING $part FAILED: the boot partition may be damaged; restore it from TWRP"
	exit 1
fi
