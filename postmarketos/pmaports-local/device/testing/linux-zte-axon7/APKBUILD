# Kernel config based on: linux-postmarketos-qcom-msm8996 (6.19.5) config,
# updated with "make olddefconfig" for 7.3.1 + built-in USB gadget configfs;
# no firmware user-helper fallback (each missing file cost 60 s), S6E3HA3
# panel and SMBCHG OTG boost as modules; fuel gauge, haptics, torch and
# the Hi-Fi audio drivers (AK4490, AK8157, ISL98608), the AK4961 and the
# OV8856 front camera as modules.
_flavor="zte-axon7"
pkgname=linux-$_flavor
pkgver=7.3.1
pkgrel=12
pkgdesc="Mainline kernel for ZTE Axon 7"
arch="aarch64"
_carch="arm64"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"

# Source
_kernver=${pkgver%.0}
source="
	https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$_kernver.tar.xz
	0001-arm64-dts-qcom-add-ZTE-Axon-7.patch
	0002-drm-panel-add-Samsung-S6E3HA3-dual-DSI-command-mode-.patch
	0003-regulator-add-Qualcomm-PMI8994-PMI8996-SMBCHG-OTG-bo.patch
	0004-arm64-dts-qcom-msm8996-zte-axon7-display-and-USB-OTG.patch
	0005-drm-msm-dpu-msm8996-CTL_0-and-CTL_1-support-split-di.patch
	0006-usb-typec-add-Pericom-PI5USB302-CC-logic-driver.patch
	0007-arm64-dts-qcom-msm8996-zte-axon7-PI5USB302-Type-C-va.patch
	0008-wifi-ath10k-only-wait-for-the-firmware-s-answer-to-S.patch
	0009-arm64-dts-qcom-msm8996-zte-axon7-rmtfs-above-the-ker.patch
	0010-arm64-dts-qcom-msm8996-zte-axon7-hall-sensor-on-LVS2.patch
	0011-power-supply-add-Qualcomm-PMIC-fuel-gauge-driver-rea.patch
	0012-Input-add-Qualcomm-PMI8994-PMI8996-haptics-driver-Ax.patch
	0013-leds-add-torch-mode-of-the-Qualcomm-PMI8994-PMI8996-.patch
	0014-ASoC-Axon-7-Hi-Fi-headphone-path-AK4490-AK8157-ISL98.patch
	0015-ASoC-ak4961-stage-1-power-up-SLIMbus-enumeration-and.patch
	0016-ASoC-ak4961-speaker-playback-over-SLIMbus-to-the-TFA.patch
	0017-ASoC-tfa989x-receiver-switch-GPIO-for-revisions-othe.patch
	0018-ASoC-ak4961-port-arrays-per-stream-speakers-were-sil.patch
	0019-arm64-dts-qcom-msm8996-zte-axon7-speakers-by-positio.patch
	0020-media-qcom-camss-vfe-don-t-delete-a-VFE-power-domain.patch
	0021-arm64-dts-qcom-msm8996-zte-axon7-front-camera-OV8856.patch
	config-$_flavor.$arch
"
builddir="$srcdir/linux-$_kernver"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
		"$pkgdir/boot/vmlinuz"

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
}

