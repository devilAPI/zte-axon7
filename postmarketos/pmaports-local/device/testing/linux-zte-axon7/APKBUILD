	0021-arm64-dts-qcom-msm8996-zte-axon7-front-camera-OV8856.patch
	0022-arm64-dts-qcom-msm8996-zte-axon7-per-speaker-widgets.patch
	0023-power-supply-qcom_fg-set-up-SRAM-access-before-regis.patch
	0024-power-supply-add-Qualcomm-SMBCHG-charger-charging-on.patch
	0025-arm64-dts-qcom-msm8996-add-the-APSS-watchdog.patch
	0026-ASoC-ak4961-microphone-2-on-the-right-channel-of-ADC.patch
	0027-media-i2c-add-Samsung-S5K2T8-image-sensor-driver.patch
