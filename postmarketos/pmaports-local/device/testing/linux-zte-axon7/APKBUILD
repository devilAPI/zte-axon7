# Kernel config based on: linux-postmarketos-qcom-msm8996 (6.19.5) config,
# updated with "make olddefconfig" for 7.3.1 + built-in USB gadget configfs;
# no firmware user-helper fallback (each missing file cost 60 s), S6E3HA3
# panel and SMBCHG OTG boost as modules; fuel gauge, haptics, torch and
# the Hi-Fi audio drivers (AK4490, AK8157, ISL98608), the AK4961 and the
# OV8856 front camera and the SMBCHG charger as modules; PSCI cpuidle and
# PM debug (suspend); the SMB1351 parallel charger and the IPA v2.x data driver as modules.
# Patches 0001-0063 are the same series as the kernel tree at
# aae3898efa01da06a3fe6443b63d7bff59c87498 (v7.3.1 + Nura patches), the base
# of LineageOS 24's 7.3.1-axon7m #1. 0052/0053 are LineageOS 24 kernel
# 0013/0014 (DPU QSEED2 scaler, GPU DDR bandwidth per OPP; identical
# patch-ids). 0063 corrects the accelerometer scale (9.84 m/s^2 lying flat on
# LOS 24 build 58); sleep draft patches stay out.
_flavor="zte-axon7"
pkgname=linux-$_flavor
pkgver=7.3.1
pkgrel=32
pkgdesc="Mainline kernel for ZTE Axon 7"
arch="aarch64"
_carch="arm64"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"

