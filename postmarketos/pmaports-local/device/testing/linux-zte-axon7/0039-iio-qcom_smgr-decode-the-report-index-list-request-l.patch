 	},
 	{
 		.data_type = QMI_EOTI,
@@ -634,15 +639,23 @@ const struct qmi_elem_info sns_smgr_buffering_report_ind_ei[] = {
 				   report_id),
 	},
 	{
-		.data_type = QMI_STRUCT,
+		.data_type = QMI_DATA_LEN,
