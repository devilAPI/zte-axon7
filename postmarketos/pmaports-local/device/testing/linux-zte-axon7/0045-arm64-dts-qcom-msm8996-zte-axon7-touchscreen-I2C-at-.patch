From 069e13721f32847c97d6d2b2cdb5b577c5c44592 Mon Sep 17 00:00:00 2001
From: Felix <52862870+devilAPI@users.noreply.github.com>
Date: Sat, 14 Nov 2026 16:38:24 +0100
Subject: [PATCH 45/45] arm64: dts: qcom: msm8996-zte-axon7: touchscreen I2C at
 400 kHz

The Synaptics touch controller's bus ran at the 100 kHz default; ZTE's
kernel uses 400 kHz (qcom,clk-freq-out) on BLSP2 QUP6.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts b/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts
index 2047339e0..2a45b9e2d 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts
@@ -421,6 +421,8 @@ nfc: nfc@28 {
 };
 
 &blsp2_i2c6 {
+	/* touchscreen bus: 400 kHz as downstream (qcom,clk-freq-out) */
+	clock-frequency = <400000>;
 	status = "okay";
 
 	/* Synaptics DSX (S3320-class) */
-- 
2.43.0

