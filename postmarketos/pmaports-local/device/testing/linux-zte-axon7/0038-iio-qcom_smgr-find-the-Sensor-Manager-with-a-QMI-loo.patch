From e6fe9f54524c142139da0464d09302a53f09f0a5 Mon Sep 17 00:00:00 2001
From: Felix <52862870+devilAPI@users.noreply.github.com>
Date: Tue, 10 Nov 2026 11:11:28 +0100
Subject: [PATCH 38/38] iio: qcom_smgr: find the Sensor Manager with a QMI
 lookup

The WIP driver binds to a QRTR bus device, which needs 'net: qrtr: Turn
QRTR into a bus' in the built-in QRTR core. Look the service (256, v1,
instance 50) up with qmi_add_lookup() instead, as other QMI clients do,
and register a 'qcom-smgr' platform device for it when it appears; it
is removed again when the service goes away (SLPI stopped or crashed),
so the driver follows remote processor restarts. Everything stays in
loadable modules.

Tested on the ZTE Axon 7: accelerometer, gyroscope and magnetometer
stream; rmmod/insmod and an SLPI stop/start remove and recreate the
devices, and data flows again afterwards.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FVN6i64chehV1XxwjxyaGp
---
 drivers/iio/common/qcom_smgr/smgr.c | 139 +++++++++++++++++++++++-----
 1 file changed, 114 insertions(+), 25 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/smgr.c b/drivers/iio/common/qcom_smgr/smgr.c
index 6571949c7..0081e0520 100644
--- a/drivers/iio/common/qcom_smgr/smgr.c
+++ b/drivers/iio/common/qcom_smgr/smgr.c
@@ -9,12 +9,13 @@
 #include <linux/iio/common/qcom_smgr.h>
 #include <linux/iio/iio.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/remoteproc/qcom_rproc.h>
 #include <linux/soc/qcom/qmi.h>
-#include <linux/soc/qcom/qrtr.h>
 #include <linux/types.h>
+#include <linux/workqueue.h>
 #include <net/sock.h>
 
 #include "qmi/sns_smgr.h"
@@ -310,23 +311,24 @@ struct iio_buffer_setup_ops smgr_buffer_ops = {
 };
 EXPORT_SYMBOL_GPL(smgr_buffer_ops);
 
-static int smgr_probe(struct qrtr_device *qdev)
+static int smgr_probe(struct platform_device *pdev)
 {
+	const struct sockaddr_qrtr *sq = dev_get_platdata(&pdev->dev);
 	struct smgr *smgr;
 	int i, j;
 	int ret;
 
-	smgr = devm_kzalloc(&qdev->dev, sizeof(*smgr), GFP_KERNEL);
+	if (!sq)
+		return -EINVAL;
+
+	smgr = devm_kzalloc(&pdev->dev, sizeof(*smgr), GFP_KERNEL);
 	if (!smgr)
 		return -ENOMEM;
 
-	smgr->dev = &qdev->dev;
-
-	smgr->sns_smgr_info.sq_family = AF_QIPCRTR;
-	smgr->sns_smgr_info.sq_node = qdev->node;
-	smgr->sns_smgr_info.sq_port = qdev->port;
+	smgr->dev = &pdev->dev;
+	smgr->sns_smgr_info = *sq;
 
-	dev_set_drvdata(&qdev->dev, smgr);
+	dev_set_drvdata(&pdev->dev, smgr);
 
 	ret = qmi_handle_init(&smgr->sns_smgr_hdl,
 			      SNS_SMGR_SINGLE_SENSOR_INFO_RESP_MAX_LEN, NULL,
@@ -373,32 +375,119 @@ static int smgr_probe(struct qrtr_device *qdev)
 	return 0;
 }
 
-static void smgr_remove(struct qrtr_device *qdev)
+static void smgr_remove(struct platform_device *pdev)
 {
-	struct smgr *smgr = dev_get_drvdata(&qdev->dev);
+	struct smgr *smgr = dev_get_drvdata(&pdev->dev);
 
 	qmi_handle_release(&smgr->sns_smgr_hdl);
 }
 
-static const struct qrtr_device_id smgr_qrtr_match[] = {
-	{
-		.service = SNS_SMGR_QMI_SVC_ID,
-		.instance = QRTR_INSTANCE(SNS_SMGR_QMI_SVC_V1,
-					  SNS_SMGR_QMI_INS_ID)
-	},
-	{},
-};
-MODULE_DEVICE_TABLE(qrtr, smgr_qrtr_match);
-
-static struct qrtr_driver smgr_driver = {
+static struct platform_driver smgr_driver = {
 	.probe = smgr_probe,
 	.remove = smgr_remove,
-	.id_table = smgr_qrtr_match,
 	.driver	= {
-		.name = "smgr",
+		.name = "qcom-smgr",
 	},
 };
-module_qrtr_driver(smgr_driver);
+
+/*
+ * The Sensor Manager is a QMI service of the SSC (SLPI), which appears
+ * once the remote processor runs and the sensor registry has been served
+ * to it, and goes away when it stops. Look it up and create the device
+ * for it then, instead of relying on a bus for QRTR services.
+ */
+static struct qmi_handle smgr_lookup;
+static struct platform_device *smgr_pdev;
+static struct sockaddr_qrtr smgr_sq;
+static bool smgr_present;
+static DEFINE_MUTEX(smgr_lock);
+
+static void smgr_update_work_fn(struct work_struct *work)
+{
+	mutex_lock(&smgr_lock);
+	if (smgr_present && !smgr_pdev) {
+		smgr_pdev = platform_device_register_data(NULL, "qcom-smgr",
+							  PLATFORM_DEVID_NONE,
+							  &smgr_sq,
+							  sizeof(smgr_sq));
+		if (IS_ERR(smgr_pdev)) {
+			pr_err("qcom-smgr: failed to register device: %pe\n",
+			       smgr_pdev);
+			smgr_pdev = NULL;
+		}
+	} else if (!smgr_present && smgr_pdev) {
+		platform_device_unregister(smgr_pdev);
+		smgr_pdev = NULL;
+	}
+	mutex_unlock(&smgr_lock);
+}
+static DECLARE_WORK(smgr_update_work, smgr_update_work_fn);
+
+static int smgr_new_server(struct qmi_handle *qmi, struct qmi_service *svc)
+{
+	mutex_lock(&smgr_lock);
+	smgr_sq.sq_family = AF_QIPCRTR;
+	smgr_sq.sq_node = svc->node;
+	smgr_sq.sq_port = svc->port;
+	smgr_present = true;
+	mutex_unlock(&smgr_lock);
+
+	/* probing talks QMI and waits: not from the lookup handle's worker */
+	schedule_work(&smgr_update_work);
+
+	return 0;
+}
+
+static void smgr_del_server(struct qmi_handle *qmi, struct qmi_service *svc)
+{
+	mutex_lock(&smgr_lock);
+	smgr_present = false;
+	mutex_unlock(&smgr_lock);
+
+	schedule_work(&smgr_update_work);
+}
+
+static const struct qmi_ops smgr_lookup_ops = {
+	.new_server = smgr_new_server,
+	.del_server = smgr_del_server,
+};
+
+static int __init smgr_init(void)
+{
+	int ret;
+
+	ret = platform_driver_register(&smgr_driver);
+	if (ret)
+		return ret;
+
+	ret = qmi_handle_init(&smgr_lookup, 0, &smgr_lookup_ops, NULL);
+	if (ret)
+		goto err_driver;
+
+	ret = qmi_add_lookup(&smgr_lookup, SNS_SMGR_QMI_SVC_ID,
+			     SNS_SMGR_QMI_SVC_V1, SNS_SMGR_QMI_INS_ID);
+	if (ret)
+		goto err_handle;
+
+	return 0;
+
+err_handle:
+	qmi_handle_release(&smgr_lookup);
+err_driver:
+	platform_driver_unregister(&smgr_driver);
+	return ret;
+}
+module_init(smgr_init);
+
+static void __exit smgr_exit(void)
+{
+	qmi_handle_release(&smgr_lookup);
+	cancel_work_sync(&smgr_update_work);
+	if (smgr_pdev)
+		platform_device_unregister(smgr_pdev);
+	platform_driver_unregister(&smgr_driver);
+}
+module_exit(smgr_exit);
 
 MODULE_AUTHOR("Yassine Oudjana <y.oudjana@protonmail.com>");
 MODULE_DESCRIPTION("Qualcomm Sensor Manager driver");
