+static u16 s5k2t8_orientation(struct s5k2t8 *s5k2t8)
+{
+	return (s5k2t8->vflip->val ? S5K2T8_VFLIP : 0) |
+	       (s5k2t8->hflip->val ? S5K2T8_HFLIP : 0);
+}
+
+static int s5k2t8_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k2t8 *s5k2t8 = container_of(ctrl->handler, struct s5k2t8,
+					     ctrl_handler);
+	const struct s5k2t8_mode *mode = s5k2t8->mode;
+	s64 exposure_max;
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		exposure_max = mode->height + ctrl->val - S5K2T8_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(s5k2t8->exposure,
+					 s5k2t8->exposure->minimum,
+					 exposure_max,
+					 s5k2t8->exposure->step,
+					 min(s5k2t8->exposure->default_value,
+					     exposure_max));
+	}
+
+	/* Controls are applied when the sensor is powered up for streaming */
+	if (!pm_runtime_get_if_active(s5k2t8->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5k2t8->regmap, S5K2T8_REG_AGAIN, ctrl->val,
+				NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5k2t8->regmap, S5K2T8_REG_EXPOSURE, ctrl->val,
+				NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5k2t8->regmap, S5K2T8_REG_VTS,
+				ctrl->val + mode->height, NULL);
+		break;
+	case V4L2_CID_LINK_FREQ:
+	case V4L2_CID_PIXEL_RATE:
+	case V4L2_CID_HBLANK:
+	case V4L2_CID_VFLIP:
+	case V4L2_CID_HFLIP:
+		/* fixed per mode, or written together with mode_select when streaming starts */
+		ret = 0;
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5k2t8->regmap, S5K2T8_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(s5k2t8->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k2t8_ctrl_ops = {
+	.s_ctrl = s5k2t8_set_ctrl,
+};
+
+static int s5k2t8_init_controls(struct s5k2t8 *s5k2t8)
+{
+	struct v4l2_ctrl_handler *hdl = &s5k2t8->ctrl_handler;
+	const struct s5k2t8_mode *mode = s5k2t8->mode;
+	struct v4l2_fwnode_device_properties props;
+	s64 hblank, vblank;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 11);
+
+	s5k2t8->link_freq = v4l2_ctrl_new_int_menu(hdl, &s5k2t8_ctrl_ops,
+					V4L2_CID_LINK_FREQ,
+					ARRAY_SIZE(s5k2t8_link_freq_menu) - 1,
+					mode->link_freq_index,
+					s5k2t8_link_freq_menu);
+	if (s5k2t8->link_freq)
+		s5k2t8->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k2t8->pixel_rate = v4l2_ctrl_new_std(hdl, &s5k2t8_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       S5K2T8_PIXEL_RATE,
+					       S5K2T8_PIXEL_RATE, 1,
+					       S5K2T8_PIXEL_RATE);
+
+	hblank = mode->hts - mode->width;
+	s5k2t8->hblank = v4l2_ctrl_new_std(hdl, &s5k2t8_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank, hblank, 1,
+					   hblank);
+	if (s5k2t8->hblank)
+		s5k2t8->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	s5k2t8->vblank = v4l2_ctrl_new_std(hdl, &s5k2t8_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   S5K2T8_VTS_MAX - mode->height, 1,
+					   vblank);
+
+	v4l2_ctrl_new_std(hdl, &s5k2t8_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5K2T8_AGAIN_MIN, S5K2T8_AGAIN_MAX, 1,
+			  S5K2T8_AGAIN_DEFAULT);
+
+	s5k2t8->exposure = v4l2_ctrl_new_std(hdl, &s5k2t8_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5K2T8_EXPOSURE_MIN,
+					     mode->vts - S5K2T8_EXPOSURE_MARGIN,
+					     1, mode->exposure);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &s5k2t8_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k2t8_test_pattern_menu) - 1,
+				     0, 0, s5k2t8_test_pattern_menu);
+
+	s5k2t8->hflip = v4l2_ctrl_new_std(hdl, &s5k2t8_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (s5k2t8->hflip)
+		s5k2t8->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	s5k2t8->vflip = v4l2_ctrl_new_std(hdl, &s5k2t8_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (s5k2t8->vflip)
+		s5k2t8->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err_free;
+	}
+
+	ret = v4l2_fwnode_device_parse(s5k2t8->dev, &props);
+	if (ret)
+		goto err_free;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &s5k2t8_ctrl_ops, &props);
+	if (ret)
+		goto err_free;
+
+	s5k2t8->sd.ctrl_handler = hdl;
+
+	return 0;
+
+err_free:
+	v4l2_ctrl_handler_free(hdl);
+	return ret;
+}
+
+static int s5k2t8_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5k2t8 *s5k2t8 = to_s5k2t8(sd);
+	const struct s5k2t8_mode *mode = s5k2t8->mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5k2t8->dev);
+	if (ret)
+		return ret;
+
+	/* Init blocks with the delays of the vendor library */
+	ret = cci_multi_reg_write(s5k2t8->regmap, s5k2t8_init0,
+				  ARRAY_SIZE(s5k2t8_init0), NULL);
+	if (ret)
+		goto error;
+	usleep_range(1000, 1500);
+
+	ret = cci_multi_reg_write(s5k2t8->regmap, s5k2t8_init1,
+				  ARRAY_SIZE(s5k2t8_init1), NULL);
+	if (ret)
+		goto error;
+	usleep_range(1000, 1500);
+
+	ret = cci_multi_reg_write(s5k2t8->regmap, s5k2t8_init2,
+				  ARRAY_SIZE(s5k2t8_init2), NULL);
+	if (ret)
+		goto error;
+	usleep_range(15000, 16000);
+
+	cci_multi_reg_write(s5k2t8->regmap, s5k2t8_init3,
+			    ARRAY_SIZE(s5k2t8_init3), &ret);
+	cci_multi_reg_write(s5k2t8->regmap, mode->regs, mode->num_regs, &ret);
+	if (ret)
+		goto error;
+	usleep_range(10000, 11000);
+
+	ret = __v4l2_ctrl_handler_setup(s5k2t8->sd.ctrl_handler);
+	if (ret)
+		goto error;
+
+	ret = cci_write(s5k2t8->regmap, S5K2T8_REG_MODE_ORIENT,
+			S5K2T8_STREAMING | s5k2t8_orientation(s5k2t8), NULL);
+	if (ret)
+		goto error;
+
+	__v4l2_ctrl_grab(s5k2t8->vflip, true);
+	__v4l2_ctrl_grab(s5k2t8->hflip, true);
+
+	return 0;
+
+error:
+	dev_err(s5k2t8->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5k2t8->dev);
+
+	return ret;
+}
+
+static int s5k2t8_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5k2t8 *s5k2t8 = to_s5k2t8(sd);
+	int ret;
+
+	ret = cci_write(s5k2t8->regmap, S5K2T8_REG_MODE_ORIENT,
+			s5k2t8_orientation(s5k2t8), NULL);
+	if (ret)
+		dev_err(s5k2t8->dev, "failed to stop streaming: %d\n", ret);
+
+	__v4l2_ctrl_grab(s5k2t8->vflip, false);
+	__v4l2_ctrl_grab(s5k2t8->hflip, false);
+
+	pm_runtime_put_autosuspend(s5k2t8->dev);
+
+	return ret;
+}
+
+static u32 s5k2t8_get_format_code(struct s5k2t8 *s5k2t8)
+{
+	return s5k2t8_mbus_formats[(s5k2t8->vflip->val ? 2 : 0) |
+				   (s5k2t8->hflip->val ? 1 : 0)];
+}
+
+static void s5k2t8_update_pad_format(struct s5k2t8 *s5k2t8,
+				     const struct s5k2t8_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = s5k2t8_get_format_code(s5k2t8);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k2t8_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k2t8 *s5k2t8 = to_s5k2t8(sd);
+	const struct s5k2t8_mode *mode;
+	s64 hblank, vblank;
+
+	mode = v4l2_find_nearest_size(s5k2t8_modes, ARRAY_SIZE(s5k2t8_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	s5k2t8_update_pad_format(s5k2t8, mode, &fmt->format);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || s5k2t8->mode == mode)
+		goto set_format;
+
+	s5k2t8->mode = mode;
+
+	__v4l2_ctrl_s_ctrl(s5k2t8->link_freq, mode->link_freq_index);
+
+	hblank = mode->hts - mode->width;
+	__v4l2_ctrl_modify_range(s5k2t8->hblank, hblank, hblank, 1, hblank);
+
+	vblank = mode->vts - mode->height;
+	__v4l2_ctrl_modify_range(s5k2t8->vblank, vblank,
+				 S5K2T8_VTS_MAX - mode->height, 1, vblank);
+	__v4l2_ctrl_s_ctrl(s5k2t8->vblank, vblank);
+
+	__v4l2_ctrl_modify_range(s5k2t8->exposure, S5K2T8_EXPOSURE_MIN,
+				 mode->vts - S5K2T8_EXPOSURE_MARGIN, 1,
+				 mode->exposure);
+	__v4l2_ctrl_s_ctrl(s5k2t8->exposure, mode->exposure);
+
+	if (s5k2t8->sd.ctrl_handler->error)
+		return s5k2t8->sd.ctrl_handler->error;
+
+set_format:
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int s5k2t8_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5k2t8_get_format_code(to_s5k2t8(sd));
+
+	return 0;
+}
+
+static int s5k2t8_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5k2t8 *s5k2t8 = to_s5k2t8(sd);
+
+	if (fse->index >= ARRAY_SIZE(s5k2t8_modes))
+		return -EINVAL;
+
+	if (fse->code != s5k2t8_get_format_code(s5k2t8))
+		return -EINVAL;
+
+	fse->min_width = s5k2t8_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5k2t8_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int s5k2t8_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = 5952;
+		sel->r.height = 3348;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int s5k2t8_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct s5k2t8 *s5k2t8 = to_s5k2t8(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = s5k2t8->mode->width,
+			.height = s5k2t8->mode->height,
+		},
+	};
+
+	return s5k2t8_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops s5k2t8_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5k2t8_pad_ops = {
+	.set_fmt = s5k2t8_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = s5k2t8_get_selection,
+	.enum_mbus_code = s5k2t8_enum_mbus_code,
+	.enum_frame_size = s5k2t8_enum_frame_size,
+	.enable_streams = s5k2t8_enable_streams,
+	.disable_streams = s5k2t8_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5k2t8_subdev_ops = {
+	.video = &s5k2t8_video_ops,
+	.pad = &s5k2t8_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k2t8_internal_ops = {
+	.init_state = s5k2t8_init_state,
+};
+
+static const struct media_entity_operations s5k2t8_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int s5k2t8_check_hwcfg(struct s5k2t8 *s5k2t8)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5k2t8->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long freq_bitmap;
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5K2T8_DATA_LANES) {
+		dev_err(s5k2t8->dev, "need %u data lanes, DT has %u\n",
+			S5K2T8_DATA_LANES,
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k2t8->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5k2t8_link_freq_menu,
+				       ARRAY_SIZE(s5k2t8_link_freq_menu),
+				       &freq_bitmap);
+	if (!ret && freq_bitmap != GENMASK(ARRAY_SIZE(s5k2t8_link_freq_menu) - 1, 0)) {
+		dev_err(s5k2t8->dev, "all of 834, 498 and 300 MHz must be listed in link-frequencies\n");
+		ret = -EINVAL;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int s5k2t8_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k2t8 *s5k2t8 = to_s5k2t8(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(s5k2t8->supplies),
+				    s5k2t8->supplies);
+	if (ret)
+		return ret;
+
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(s5k2t8->mclk);
+	if (ret)
+		goto err_regulators;
+
+	usleep_range(1000, 2000);
+
+	gpiod_set_value_cansleep(s5k2t8->standby_gpio, 0);
+	gpiod_set_value_cansleep(s5k2t8->reset_gpio, 0);
+	usleep_range(10000, 12000);
+
+	return 0;
+
+err_regulators:
+	regulator_bulk_disable(ARRAY_SIZE(s5k2t8->supplies), s5k2t8->supplies);
+	return ret;
+}
+
+static int s5k2t8_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k2t8 *s5k2t8 = to_s5k2t8(sd);
+
+	gpiod_set_value_cansleep(s5k2t8->reset_gpio, 1);
+	gpiod_set_value_cansleep(s5k2t8->standby_gpio, 1);
+	usleep_range(1000, 2000);
+
+	clk_disable_unprepare(s5k2t8->mclk);
+
+	regulator_bulk_disable(ARRAY_SIZE(s5k2t8->supplies), s5k2t8->supplies);
+
+	return 0;
+}
+
+static int s5k2t8_identify(struct s5k2t8 *s5k2t8)
+{
+	u64 id = 0, rev = 0;
+	int ret;
+
+	ret = cci_read(s5k2t8->regmap, S5K2T8_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(s5k2t8->dev, ret,
+				     "failed to read chip id\n");
+
+	cci_read(s5k2t8->regmap, CCI_REG16(0x0002), &rev, NULL);
+	dev_info(s5k2t8->dev, "chip id 0x%04llx, revision 0x%04llx\n", id,
+		 rev);
+
+	/* The expected id is not known yet: accept anything but bus noise */
+	if (id == 0 || id == 0xffff)
+		return dev_err_probe(s5k2t8->dev, -ENODEV,
+				     "no sensor answering\n");
+
+	return 0;
+}
+
+static int s5k2t8_probe(struct i2c_client *client)
+{
+	struct s5k2t8 *s5k2t8;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	s5k2t8 = devm_kzalloc(&client->dev, sizeof(*s5k2t8), GFP_KERNEL);
+	if (!s5k2t8)
+		return -ENOMEM;
+
+	s5k2t8->dev = &client->dev;
+	v4l2_i2c_subdev_init(&s5k2t8->sd, client, &s5k2t8_subdev_ops);
+
+	s5k2t8->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k2t8->regmap))
+		return dev_err_probe(s5k2t8->dev, PTR_ERR(s5k2t8->regmap),
+				     "failed to init CCI\n");
+
+	s5k2t8->mclk = devm_v4l2_sensor_clk_get(s5k2t8->dev, NULL);
+	if (IS_ERR(s5k2t8->mclk))
+		return dev_err_probe(s5k2t8->dev, PTR_ERR(s5k2t8->mclk),
+				     "failed to get MCLK\n");
+
+	freq = clk_get_rate(s5k2t8->mclk);
+	if (freq != S5K2T8_MCLK_FREQ)
+		return dev_err_probe(s5k2t8->dev, -EINVAL,
+				     "MCLK %lu Hz not supported\n", freq);
+
+	ret = s5k2t8_check_hwcfg(s5k2t8);
+	if (ret)
+		return dev_err_probe(s5k2t8->dev, ret,
+				     "failed to check HW configuration\n");
+
+	s5k2t8->reset_gpio = devm_gpiod_get_optional(s5k2t8->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k2t8->reset_gpio))
+		return dev_err_probe(s5k2t8->dev, PTR_ERR(s5k2t8->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	s5k2t8->standby_gpio = devm_gpiod_get_optional(s5k2t8->dev, "standby",
+						       GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k2t8->standby_gpio))
+		return dev_err_probe(s5k2t8->dev,
+				     PTR_ERR(s5k2t8->standby_gpio),
+				     "cannot get standby GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(s5k2t8_supply_names); i++)
+		s5k2t8->supplies[i].supply = s5k2t8_supply_names[i];
+
+	ret = devm_regulator_bulk_get(s5k2t8->dev,
+				      ARRAY_SIZE(s5k2t8->supplies),
+				      s5k2t8->supplies);
+	if (ret)
+		return dev_err_probe(s5k2t8->dev, ret,
+				     "failed to get regulators\n");
+
+	ret = s5k2t8_power_on(s5k2t8->dev);
+	if (ret)
+		return ret;
+
+	ret = s5k2t8_identify(s5k2t8);
+	if (ret)
+		goto power_off;
+
+	s5k2t8->mode = &s5k2t8_modes[1];
+	ret = s5k2t8_init_controls(s5k2t8);
+	if (ret) {
+		dev_err_probe(s5k2t8->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	s5k2t8->sd.state_lock = s5k2t8->ctrl_handler.lock;
+	s5k2t8->sd.internal_ops = &s5k2t8_internal_ops;
+	s5k2t8->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k2t8->sd.entity.ops = &s5k2t8_entity_ops;
+	s5k2t8->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k2t8->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k2t8->sd.entity, 1, &s5k2t8->pad);
+	if (ret)
+		goto free_ctrls;
+
+	ret = v4l2_subdev_init_finalize(&s5k2t8->sd);
+	if (ret < 0)
+		goto entity_cleanup;
+
+	pm_runtime_set_active(s5k2t8->dev);
+	pm_runtime_enable(s5k2t8->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k2t8->sd);
+	if (ret < 0) {
+		dev_err_probe(s5k2t8->dev, ret, "failed to register subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(s5k2t8->dev, 1000);
+	pm_runtime_use_autosuspend(s5k2t8->dev);
+	pm_runtime_idle(s5k2t8->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5k2t8->sd);
+	pm_runtime_disable(s5k2t8->dev);
+	pm_runtime_set_suspended(s5k2t8->dev);
+entity_cleanup:
+	media_entity_cleanup(&s5k2t8->sd.entity);
+free_ctrls:
+	v4l2_ctrl_handler_free(s5k2t8->sd.ctrl_handler);
+power_off:
+	s5k2t8_power_off(s5k2t8->dev);
+
+	return ret;
+}
+
+static void s5k2t8_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k2t8 *s5k2t8 = to_s5k2t8(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5k2t8->dev);
+
+	if (!pm_runtime_status_suspended(s5k2t8->dev)) {
+		s5k2t8_power_off(s5k2t8->dev);
+		pm_runtime_set_suspended(s5k2t8->dev);
+	}
+}
+
+static const struct dev_pm_ops s5k2t8_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5k2t8_power_off, s5k2t8_power_on, NULL)
+};
+
+static const struct of_device_id s5k2t8_of_match[] = {
+	{ .compatible = "samsung,s5k2t8" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s5k2t8_of_match);
+
+static struct i2c_driver s5k2t8_i2c_driver = {
+	.driver = {
+		.name = "s5k2t8",
+		.pm = &s5k2t8_pm_ops,
+		.of_match_table = s5k2t8_of_match,
+	},
+	.probe = s5k2t8_probe,
+	.remove = s5k2t8_remove,
+};
+module_i2c_driver(s5k2t8_i2c_driver);
+
+MODULE_DESCRIPTION("Samsung S5K2T8 image sensor driver");
+MODULE_LICENSE("GPL");
