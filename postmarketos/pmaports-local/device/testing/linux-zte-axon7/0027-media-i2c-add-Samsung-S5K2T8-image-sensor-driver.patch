+#include <media/v4l2-fwnode.h>
+
+#define S5K2T8_MCLK_FREQ		(24 * HZ_PER_MHZ)
+#define S5K2T8_DATA_LANES		4
+/* VT pixel clock: 24 MHz / 4 * 303 / 5 * 2 pixel pipes, all modes */
+#define S5K2T8_PIXEL_RATE		727200000ULL
+
+#define S5K2T8_REG_CHIP_ID		CCI_REG16(0x0000)
+
+/* 0x0100 mode_select and 0x0101 orientation, written as one word */
+#define S5K2T8_REG_MODE_ORIENT		CCI_REG16(0x0100)
+#define S5K2T8_STREAMING		BIT(8)
+#define S5K2T8_VFLIP			BIT(1)
+#define S5K2T8_HFLIP			BIT(0)
+
+#define S5K2T8_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5K2T8_EXPOSURE_MIN		4
+#define S5K2T8_EXPOSURE_MARGIN		8
+
+/* Analogue gain, 0x20 = 1x, up to 16x */
+#define S5K2T8_REG_AGAIN		CCI_REG16(0x0204)
+#define S5K2T8_AGAIN_MIN		0x20
+#define S5K2T8_AGAIN_MAX		0x200
+#define S5K2T8_AGAIN_DEFAULT		0x40
+
+#define S5K2T8_REG_VTS			CCI_REG16(0x0340)
+#define S5K2T8_VTS_MAX			0xffff
+
+#define S5K2T8_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define to_s5k2t8(_sd)			container_of(_sd, struct s5k2t8, sd)
+
+enum {
+	S5K2T8_LINK_FREQ_834MHZ,
+	S5K2T8_LINK_FREQ_498MHZ,
+	S5K2T8_LINK_FREQ_300MHZ,
+};
+
+static const s64 s5k2t8_link_freq_menu[] = {
+	[S5K2T8_LINK_FREQ_834MHZ] = 834000000,
+	[S5K2T8_LINK_FREQ_498MHZ] = 498000000,
+	[S5K2T8_LINK_FREQ_300MHZ] = 300000000,
+};
+
+/* Indexed by (vflip << 1) | hflip */
+static const u32 s5k2t8_mbus_formats[] = {
+	MEDIA_BUS_FMT_SGRBG10_1X10,	MEDIA_BUS_FMT_SRGGB10_1X10,
+	MEDIA_BUS_FMT_SBGGR10_1X10,	MEDIA_BUS_FMT_SGBRG10_1X10,
+};
+
+struct s5k2t8_mode {
+	u32 width;
+	u32 height;
+	u32 hts;
+	u32 vts;
+	u32 exposure;
+	unsigned int link_freq_index;
+	const struct cci_reg_sequence *regs;
+	unsigned int num_regs;
+};
+
+static const char * const s5k2t8_test_pattern_menu[] = {
+	"Disabled",
+	"Solid color",
+	"Color bars",
+	"Fade to grey color bars",
+	"PN9",
+};
+
+struct s5k2t8 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *standby_gpio;
+	struct regulator_bulk_data supplies[4];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vflip;
+	struct v4l2_ctrl *hflip;
+
+	const struct s5k2t8_mode *mode;
+};
