@@ -892,6 +933,15 @@ isl98608_en_default: isl98608-en-state {
 };
 
 &pmi8994_gpios {
+	/* TFA9890 speaker amplifier resets (GPIO 2 and 3, ZTE SPKR_SD_N), low = running */
