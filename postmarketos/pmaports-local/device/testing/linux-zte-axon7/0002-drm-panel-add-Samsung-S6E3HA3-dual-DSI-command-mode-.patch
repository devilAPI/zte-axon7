From 789412402da292abb83961860d13eb82e50271f9 Mon Sep 17 00:00:00 2001
From: postmarketOS port <local>
Date: Fri, 6 Nov 2026 09:02:11 +0100
Subject: [PATCH 2/4] drm/panel: add Samsung S6E3HA3 dual DSI command mode
 panel

1440x2560 AMOLED of the ZTE Axon 7, one 720x2560 half per DSI link
(bonded DSI). Init sequence, reset timing and DCS brightness (0x51,
8 bit) as in the downstream panel description; based on the driver by
David Wronek, ported to the mipi_dsi multi-context API.
---
 drivers/gpu/drm/panel/Kconfig                 |  12 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 drivers/gpu/drm/panel/panel-samsung-s6e3ha3.c | 306 ++++++++++++++++++
 3 files changed, 319 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-samsung-s6e3ha3.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index cbdf7b8f7..712ef776a 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1015,6 +1015,18 @@ config DRM_PANEL_SAMSUNG_S6E3HA2
 	depends on BACKLIGHT_CLASS_DEVICE
 	select VIDEOMODE_HELPERS
 
+config DRM_PANEL_SAMSUNG_S6E3HA3
+	tristate "Samsung S6E3HA3 dual DSI command mode panel"
+	depends on GPIOLIB
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select VIDEOMODE_HELPERS
+	help
+	  Say Y or M here if you want to enable support for the Samsung
+	  S6E3HA3 1440x2560 AMOLED panel driven over two DSI links in
+	  command mode, as found in the ZTE Axon 7.
+
 config DRM_PANEL_SAMSUNG_S6E3HA8
 	tristate "Samsung S6E3HA8 DSI video mode panel"
 	depends on GPIOLIB
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 3b523cf37..f13d646d2 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -98,6 +98,7 @@ obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6D7AA0) += panel-samsung-s6d7aa0.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3FA7) += panel-samsung-s6e3fa7.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3FC2X01) += panel-samsung-s6e3fc2x01.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3HA2) += panel-samsung-s6e3ha2.o
+obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3HA3) += panel-samsung-s6e3ha3.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3HA8) += panel-samsung-s6e3ha8.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E63J0X03) += panel-samsung-s6e63j0x03.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E63M0) += panel-samsung-s6e63m0.o
diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3ha3.c b/drivers/gpu/drm/panel/panel-samsung-s6e3ha3.c
new file mode 100644
index 000000000..2353ac130
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3ha3.c
@@ -0,0 +1,306 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S6E3HA3 1440x2560 AMOLED, dual DSI command mode, as used in the
+ * ZTE Axon 7 (downstream "zteSAM_S6E3HA3_SAM_25601440_5P5Inch"). Each DSI
+ * link drives one 720x2560 half. The init sequence, reset timing and DCS
+ * brightness control follow the downstream panel description.
+ *
+ * Based on the driver by David Wronek <davidwronek@gmail.com>.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_of.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct s6e3ha3 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi[2];
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data *supplies;
+	enum drm_panel_orientation orientation;
+};
+
+static const struct regulator_bulk_data s6e3ha3_supplies[] = {
+	{ .supply = "vddio" },	/* 1.8 V, GPIO 40 switched */
+	{ .supply = "vdda" },	/* 3.0 V */
+};
+
+static inline struct s6e3ha3 *to_s6e3ha3(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e3ha3, panel);
+}
+
+/* Send the same DCS sequence on both links (each controls one half). */
+#define dual_dcs_seq(ctx, dsi, cmd, seq...)				\
+	do {								\
+		static const u8 d[] = { cmd, seq };			\
+		mipi_dsi_dual_dcs_write_buffer_multi(ctx, dsi[0], dsi[1], \
+						     d, ARRAY_SIZE(d));	\
+	} while (0)
+
+static void s6e3ha3_reset(struct s6e3ha3 *ctx)
+{
+	/* downstream qcom,mdss-dsi-reset-sequence = <1 2>, <0 1>, <1 5> */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(5000, 6000);
+}
+
+static int s6e3ha3_on(struct s6e3ha3 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi[0] };
+
+	/* downstream qcom,mdss-dsi-on-command, sent in HS mode */
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, MIPI_DCS_EXIT_SLEEP_MODE);
+	mipi_dsi_usleep_range(&dsi_ctx, 5000, 6000);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, 0xf0, 0x5a, 0x5a);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, 0xc4, 0x03);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, 0xf9, 0x03);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, 0xc2,
+		     0x00, 0x08, 0xd8, 0xd8, 0x00, 0x80, 0x2b, 0x05,
+		     0x08, 0x0e, 0x07, 0x0b, 0x05, 0x0d, 0x0a, 0x15,
+		     0x13, 0x20, 0x1e);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, 0xed, 0x45);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, 0xf6,
+		     0x42, 0x57, 0x37, 0x00, 0xaa, 0xcc, 0xd0, 0x00, 0x00);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, MIPI_DCS_ENTER_NORMAL_MODE);
+	mipi_dsi_usleep_range(&dsi_ctx, 1000, 2000);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, MIPI_DCS_SET_TEAR_ON, 0x00);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x20);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, MIPI_DCS_SET_DISPLAY_ON);
+	mipi_dsi_usleep_range(&dsi_ctx, 16000, 17000);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3ha3_off(struct s6e3ha3 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi[0] };
+
+	/* downstream qcom,mdss-dsi-off-command */
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, MIPI_DCS_SET_DISPLAY_BRIGHTNESS, 0x00);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, MIPI_DCS_SET_DISPLAY_OFF);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+	dual_dcs_seq(&dsi_ctx, ctx->dsi, MIPI_DCS_ENTER_SLEEP_MODE);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3ha3_prepare(struct drm_panel *panel)
+{
+	struct s6e3ha3 *ctx = to_s6e3ha3(panel);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(s6e3ha3_supplies), ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	s6e3ha3_reset(ctx);
+
+	ret = s6e3ha3_on(ctx);
+	if (ret < 0) {
+		dev_err(panel->dev, "failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(s6e3ha3_supplies), ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int s6e3ha3_unprepare(struct drm_panel *panel)
+{
+	struct s6e3ha3 *ctx = to_s6e3ha3(panel);
+	int ret;
+
+	ret = s6e3ha3_off(ctx);
+	if (ret < 0)
+		dev_err(panel->dev, "failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(s6e3ha3_supplies), ctx->supplies);
+
+	return 0;
+}
+
+static const struct drm_display_mode s6e3ha3_mode = {
+	/* both halves together; downstream per-link timings are 720 wide */
+	.clock = (1440 + 2 * 140 + 2 * 16 + 2 * 66) * (2560 + 16 + 16 + 8) * 60 / 1000,
+	.hdisplay = 1440,
+	.hsync_start = 1440 + 2 * 140,
+	.hsync_end = 1440 + 2 * 140 + 2 * 16,
+	.htotal = 1440 + 2 * 140 + 2 * 16 + 2 * 66,
+	.vdisplay = 2560,
+	.vsync_start = 2560 + 16,
+	.vsync_end = 2560 + 16 + 16,
+	.vtotal = 2560 + 16 + 16 + 8,
+	.width_mm = 68,
+	.height_mm = 121,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int s6e3ha3_get_modes(struct drm_panel *panel,
+			     struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &s6e3ha3_mode);
+}
+
+static enum drm_panel_orientation s6e3ha3_get_orientation(struct drm_panel *panel)
+{
+	return to_s6e3ha3(panel)->orientation;
+}
+
+static const struct drm_panel_funcs s6e3ha3_panel_funcs = {
+	.prepare = s6e3ha3_prepare,
+	.unprepare = s6e3ha3_unprepare,
+	.get_modes = s6e3ha3_get_modes,
+	.get_orientation = s6e3ha3_get_orientation,
+};
+
+static int s6e3ha3_bl_update_status(struct backlight_device *bl)
+{
+	struct s6e3ha3 *ctx = bl_get_data(bl);
+	u8 brightness = backlight_get_brightness(bl);
+	int ret = 0;
+
+	for (int i = 0; i < 2; i++) {
+		ret = mipi_dsi_dcs_write(ctx->dsi[i], MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+					 &brightness, sizeof(brightness));
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+static const struct backlight_ops s6e3ha3_bl_ops = {
+	.update_status = s6e3ha3_bl_update_status,
+};
+
+static int s6e3ha3_probe(struct mipi_dsi_device *dsi)
+{
+	const struct mipi_dsi_device_info info = {
+		.type = "s6e3ha3-dsi1",
+		.channel = 0,
+		.node = NULL,
+	};
+	const struct backlight_properties bl_props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 160,
+		.max_brightness = 255,
+	};
+	struct device *dev = &dsi->dev;
+	struct mipi_dsi_host *dsi1_host;
+	struct device_node *dsi1;
+	struct s6e3ha3 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct s6e3ha3, panel,
+				   &s6e3ha3_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(s6e3ha3_supplies),
+					    s6e3ha3_supplies, &ctx->supplies);
+	if (ret < 0)
+		return ret;
+
+	/* the panel runs from the bootloader: keep it out of reset until prepare */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get reset-gpios\n");
+
+	ret = drm_of_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to get orientation\n");
+
+	dsi1 = of_graph_get_remote_node(dsi->dev.of_node, 1, -1);
+	if (!dsi1)
+		return dev_err_probe(dev, -ENODEV, "cannot get secondary DSI node\n");
+
+	dsi1_host = of_find_mipi_dsi_host_by_node(dsi1);
+	of_node_put(dsi1);
+	if (!dsi1_host)
+		return dev_err_probe(dev, -EPROBE_DEFER, "cannot get secondary DSI host\n");
+
+	ctx->dsi[1] = devm_mipi_dsi_device_register_full(dev, dsi1_host, &info);
+	if (IS_ERR(ctx->dsi[1]))
+		return dev_err_probe(dev, PTR_ERR(ctx->dsi[1]),
+				     "cannot register secondary DSI device\n");
+
+	ctx->dsi[0] = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev), dev, ctx,
+							      &s6e3ha3_bl_ops, &bl_props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "failed to register backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	for (int i = 0; i < 2; i++) {
+		ctx->dsi[i]->lanes = 4;
+		ctx->dsi[i]->format = MIPI_DSI_FMT_RGB888;
+		ctx->dsi[i]->mode_flags = MIPI_DSI_MODE_NO_EOT_PACKET |
+					  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+		ret = devm_mipi_dsi_attach(dev, ctx->dsi[i]);
+		if (ret < 0) {
+			drm_panel_remove(&ctx->panel);
+			return dev_err_probe(dev, ret, "cannot attach to DSI%d host\n", i);
+		}
+	}
+
+	return 0;
+}
+
+static void s6e3ha3_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e3ha3 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e3ha3_of_match[] = {
+	{ .compatible = "samsung,s6e3ha3" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s6e3ha3_of_match);
+
+static struct mipi_dsi_driver s6e3ha3_driver = {
+	.probe = s6e3ha3_probe,
+	.remove = s6e3ha3_remove,
+	.driver = {
+		.name = "panel-samsung-s6e3ha3",
+		.of_match_table = s6e3ha3_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e3ha3_driver);
+
+MODULE_AUTHOR("David Wronek <davidwronek@gmail.com>");
+MODULE_DESCRIPTION("DRM driver for the Samsung S6E3HA3 dual DSI command mode panel");
+MODULE_LICENSE("GPL");
-- 
