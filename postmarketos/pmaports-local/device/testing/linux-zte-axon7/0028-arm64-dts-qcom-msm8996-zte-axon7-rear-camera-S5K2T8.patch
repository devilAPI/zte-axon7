From 6e005e4a59d101d944930086d131e628955026ff Mon Sep 17 00:00:00 2001
From: Felix <52862870+devilAPI@users.noreply.github.com>
Date: Tue, 10 Nov 2026 09:35:15 +0100
Subject: [PATCH 28/28] arm64: dts: qcom: msm8996-zte-axon7: rear camera S5K2T8

The rear camera sits on CCI master 0 at 0x2d (ZTE 8-bit 0x5a) and
CSIPHY0 with four lanes, clocked by MCLK0 at 24 MHz. Reset is TLMM 30,
standby TLMM 29, and TLMM 38 enables the external DVDD regulator fed
from S3. I/O, analog and AF supplies are LVS1, L17 (2.9 V) and L23
(2.8 V), as in ZTE's camera@0 node.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FVN6i64chehV1XxwjxyaGp
---
 .../arm64/boot/dts/qcom/msm8996-zte-axon7.dts | 73 +++++++++++++++++++
 1 file changed, 73 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts b/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts
index 0953ae29f..aff31403b 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts
@@ -149,6 +149,15 @@ front_cam_dovdd: front-cam-dovdd-regulator {
 		startup-delay-us = <3000>;
 	};
 
+	rear_cam_dvdd: rear-cam-dvdd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "rear_cam_dvdd";
+		gpio = <&tlmm 38 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_s3a_1p3>;
+		startup-delay-us = <1000>;
+	};
+
 	hifi_ldo: hifi-ldo-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "hifi_ldo";
@@ -892,6 +901,45 @@ &cci {
 	status = "okay";
 };
 
+/*
+ * Rear camera: Samsung S5K2T8 (ZTE "s5k2t8", 8-bit address 0x5a) on CCI
+ * master 0, CSIPHY0 with 4 lanes, MCLK0 at 24 MHz; reset TLMM 30,
+ * standby TLMM 29, external DVDD LDO enabled by TLMM 38 (fed from S3).
+ * Supplies from ZTE's camera@0: vio LVS1, vana L17 2.9 V, vaf L23 2.8 V.
+ * The AK7371 actuator and EEPROM (0x50) sit on the same bus.
+ */
+&cci_i2c0 {
+	rear_camera: camera@2d {
+		compatible = "samsung,s5k2t8";
+		reg = <0x2d>;
+
+		clocks = <&mmcc CAMSS_MCLK0_CLK>;
+		assigned-clocks = <&mmcc CAMSS_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
+		standby-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
+		vddio-supply = <&vreg_lvs1a_1p8>;
+		vdda-supply = <&vreg_l17a_2p9>;
+		vddd-supply = <&rear_cam_dvdd>;
+		afvdd-supply = <&vreg_l23a_2p8>;
+
+		orientation = <1>;
+		rotation = <90>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&rear_cam_default>;
+
+		port {
+			rear_camera_out: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <834000000 498000000 300000000>;
+				remote-endpoint = <&csiphy0_in>;
+			};
+		};
+	};
+};
+
 &cci_i2c1 {
 	front_camera: camera@36 {
 		compatible = "ovti,ov8856";
@@ -933,6 +981,15 @@ &camss {
 	status = "okay";
 
 	ports {
+		port@0 {
+			reg = <0>;
+
+			csiphy0_in: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&rear_camera_out>;
+			};
+		};
+
 		port@2 {
 			reg = <2>;
 
@@ -1491,6 +1548,22 @@ hifi_pop_default: hifi-pop-default-state {
 	};
 
 	/* front camera: MCLK2, reset, DVDD/IOVDD enables; standby held high */
+	rear_cam_default: rear-cam-default-state {
+		mclk-pins {
+			pins = "gpio13";
+			function = "cam_mclk";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		ctrl-pins {
+			pins = "gpio29", "gpio30", "gpio38";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
 	front_cam_default: front-cam-default-state {
 		mclk-pins {
 			pins = "gpio15";
-- 
