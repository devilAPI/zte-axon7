+			return -EINVAL;
+		*tx_num = min_t(unsigned int, 2, ak->num_tx_ch);
+		for (i = 0; i < *tx_num; i++)
+			tx_slot[i] = ak->tx_ch[i];
+		return 0;
+	}
+	if (!rx_slot || !rx_num)
+		return -EINVAL;
 	*rx_num = min_t(unsigned int, 2, ak->num_rx_ch);
 	for (i = 0; i < *rx_num; i++)
 		rx_slot[i] = ak->rx_ch[i];
@@ -360,6 +493,19 @@ static struct snd_soc_dai_driver ak4961_dais[] = {
 		},
