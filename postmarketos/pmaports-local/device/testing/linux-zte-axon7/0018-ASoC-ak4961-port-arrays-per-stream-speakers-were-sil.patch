 		break;
 	case SNDRV_PCM_TRIGGER_STOP:
 	case SNDRV_PCM_TRIGGER_SUSPEND:
@@ -311,11 +430,16 @@ static int ak4961_set_channel_map(struct snd_soc_dai *dai,
 	struct ak4961_priv *ak = snd_soc_component_get_drvdata(dai->component);
 	unsigned int i;
 
