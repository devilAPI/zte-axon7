From bebe7ae96be1c8e7c678ee3db8f2c2e41ecd94be Mon Sep 17 00:00:00 2001
From: Felix <52862870+devilAPI@users.noreply.github.com>
Date: Tue, 10 Nov 2026 00:29:35 +0100
Subject: [PATCH 21/21] arm64: dts: qcom: msm8996-zte-axon7: front camera
 (OV8856)

OV8856 (ZTE eeprom "common_ov8856") on CCI master 1 at 0x36, CSIPHY2,
four lanes at 360/180 MHz, MCLK2 at 19.2 MHz; reset TLMM 23, standby
TLMM 26 held high, analog supply L29, DVDD/IOVDD through the switches on
TLMM 24/25 (fixed regulators). CAMSS with CAMSS_GDSC as its top domain:
otherwise camss_top_ahb_clk is enabled for the CSIPHY before any VFE
domain is up and stays stuck off (-EBUSY).

Tested: the sensor identifies, and with the CAMSS GDSC held on (CCI
runtime PM on) four 3280x2464 RAW10 frames came through
CSIPHY2 -> CSID0 -> ISPIF0 -> VFE0 RDI0 (dark scene, default exposure).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FVN6i64chehV1XxwjxyaGp
---
 .../arm64/boot/dts/qcom/msm8996-zte-axon7.dts | 112 ++++++++++++++++++
 1 file changed, 112 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts b/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts
index db05d1f44..401a410cf 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996-zte-axon7.dts
@@ -16,6 +16,7 @@
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 #include <dt-bindings/sound/qcom,q6asm.h>
 #include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
+#include <dt-bindings/clock/qcom,mmcc-msm8996.h>
 #include "msm8996.dtsi"
 #include "pm8994.dtsi"
 #include "pmi8994.dtsi"
@@ -125,6 +126,29 @@ divclk4: divclk4 {
 		pinctrl-0 = <&divclk4_pin_a>;
 	};
 
+	/* front camera supply switches (ZTE CAM_DVDD2 / CAM_IOVDD2) */
+	front_cam_dvdd: front-cam-dvdd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "front_cam_dvdd";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		gpio = <&tlmm 24 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_l27a_1p0>;
+		startup-delay-us = <3000>;
+	};
+
+	front_cam_dovdd: front-cam-dovdd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "front_cam_dovdd";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 25 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_lvs1a_1p8>;
+		startup-delay-us = <3000>;
+	};
+
 	hifi_ldo: hifi-ldo-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "hifi_ldo";
@@ -850,6 +874,69 @@ ak4961: codec@2,0 {
 	};
 };
 
+/*
+ * Front camera: OmniVision OV8856 (ZTE eeprom "common_ov8856") on CCI
+ * master 1 at 0x36 (ZTE 8-bit 0x6c), CSIPHY2, MCLK2 at 19.2 MHz; reset
+ * TLMM 23, standby TLMM 26 (held high: not in standby), supplies L29
+ * (analog 2.8 V) and the DVDD/IOVDD switches. The lane count is not
+ * known from ZTE's tree (the sensor setup is in their camera blobs).
+ */
+&cci {
+	status = "okay";
+};
+
+&cci_i2c1 {
+	front_camera: camera@36 {
+		compatible = "ovti,ov8856";
+		reg = <0x36>;
+
+		clocks = <&mmcc CAMSS_MCLK2_CLK>;
+		clock-names = "xvclk";
+		assigned-clocks = <&mmcc CAMSS_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
+		avdd-supply = <&vreg_l29a_2p8>;
+		dvdd-supply = <&front_cam_dvdd>;
+		dovdd-supply = <&front_cam_dovdd>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&front_cam_default>;
+
+		port {
+			front_camera_out: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <360000000 180000000>;
+				remote-endpoint = <&csiphy2_in>;
+			};
+		};
+	};
+};
+
+&camss {
+	/*
+	 * CAMSS_GDSC (parent of both VFE domains) as the top domain, linked
+	 * while CAMSS is active: the CSIPHY clocks (camss_top_ahb) are
+	 * enabled before a VFE domain is up and stayed stuck "off".
+	 */
+	power-domains = <&mmcc VFE0_GDSC>,
+			<&mmcc VFE1_GDSC>,
+			<&mmcc CAMSS_GDSC>;
+	vdda-supply = <&vreg_l2a_1p25>;
+	status = "okay";
+
+	ports {
+		port@2 {
+			reg = <2>;
+
+			csiphy2_in: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&front_camera_out>;
+			};
+		};
+	};
+};
+
 &q6afedai {
 	dai@22 {
 		reg = <QUATERNARY_MI2S_RX>;
@@ -1381,6 +1468,31 @@ hifi_pop_default: hifi-pop-default-state {
 		output-high;
 	};
 
+	/* front camera: MCLK2, reset, DVDD/IOVDD enables; standby held high */
+	front_cam_default: front-cam-default-state {
+		mclk-pins {
+			pins = "gpio15";
+			function = "cam_mclk";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		ctrl-pins {
+			pins = "gpio23", "gpio24", "gpio25";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		standby-pins {
+			pins = "gpio26";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+			output-high;
+		};
+	};
+
 	/* AK4961 control port (BLSP2 QUP3 SPI, ZTE spi_9) */
 	blsp2_spi3_default: blsp2-spi3-default-state {
 		pins = "gpio49", "gpio50", "gpio51", "gpio52";
-- 
