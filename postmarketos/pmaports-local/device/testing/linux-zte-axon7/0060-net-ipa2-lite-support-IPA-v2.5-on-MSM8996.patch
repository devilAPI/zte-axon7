From 7ef3a4237ab0b626f9653f3342d16bded22b0390 Mon Sep 17 00:00:00 2001
From: Felix Seiboldt <52862870+devilAPI@users.noreply.github.com>
Date: Sun, 22 Nov 2026 17:54:24 +0100
Subject: [PATCH 2/4] net: ipa2-lite: support IPA v2.5 on MSM8996

On MSM8996 the IPA BAM is owned by the modem/TrustZone (downstream
qcom,ipa-bam-remote-mode). Resetting its global registers from Linux resets
the SoC; skip them when qcom,bam-remote-mode is set. The v2.5 SRAM layout
has a header processing-context partition that must be zeroed, with
IPA_LOCAL_PKT_PROC_CNTXT_BASE pointing at its offset, as downstream does.

From the Xiaomi Mi MIX mainline tree's kernel/patches/0033.

Co-Authored-By: hy4-flash-free (opencode) <noreply@opencode.ai>
Claude-Session: https://claude.ai/code/session_01FVN6i49UMoL3MhGT7nwMzG
---
 drivers/net/ipa2-lite/ipa.c | 34 ++++++++++++++++++++++++++--------
 1 file changed, 26 insertions(+), 8 deletions(-)

diff --git a/drivers/net/ipa2-lite/ipa.c b/drivers/net/ipa2-lite/ipa.c
index af805e5a0..326be7922 100644
--- a/drivers/net/ipa2-lite/ipa.c
+++ b/drivers/net/ipa2-lite/ipa.c
@@ -82,6 +82,8 @@ struct ipa_ep {
 struct ipa {
 	atomic_t uc_cmd_busy;
 	bool test_mode;
+	/* The BAM is owned by the modem/TZ (qcom,bam-remote-mode, MSM8996) */
+	bool bam_remote;
 	struct clk *clk;
 	struct device *dev;
 	struct ipa_ep ep[EP_NUM];
@@ -173,14 +175,22 @@ static void ipa_reset_hw(struct ipa *ipa)
 	if (ipa->version >= 25)
 		iowrite32(0x1fff7f, ipa->mmio + REG_IPA_BCR_OFST);
 
-	iowrite32(BAM_SW_RST, ipa->mmio + REG_BAM_CTRL);
-	iowrite32(0, ipa->mmio + REG_BAM_CTRL);
-
-	iowrite32(0x10, ipa->mmio + REG_BAM_DESC_CNT_TRSHLD);
-	iowrite32((u32)~BIT(11), ipa->mmio + REG_BAM_CNFG_BITS);
-	rmw32(ipa->mmio + REG_BAM_CTRL, BAM_EN, BAM_EN);
-
-	iowrite32(BAM_ERROR_EN | BAM_HRESP_ERR_EN, ipa->mmio + REG_BAM_IRQ_EN);
+	/*
+	 * In remote mode the modem/TZ initialises the BAM; resetting or
+	 * reconfiguring its global registers from here resets the SoC.
+	 * Only the pipes are ours to set up.
+	 */
+	if (!ipa->bam_remote) {
+		iowrite32(BAM_SW_RST, ipa->mmio + REG_BAM_CTRL);
+		iowrite32(0, ipa->mmio + REG_BAM_CTRL);
+
+		iowrite32(0x10, ipa->mmio + REG_BAM_DESC_CNT_TRSHLD);
+		iowrite32((u32)~BIT(11), ipa->mmio + REG_BAM_CNFG_BITS);
+		rmw32(ipa->mmio + REG_BAM_CTRL, BAM_EN, BAM_EN);
+
+		iowrite32(BAM_ERROR_EN | BAM_HRESP_ERR_EN,
+			  ipa->mmio + REG_BAM_IRQ_EN);
+	}
 	iowrite32(BAM_IRQ, ipa->mmio + REG_BAM_IRQ_SRCS_MSK_EE0);
 }
 
@@ -566,6 +576,7 @@ static int ipa_init_sram_part(struct ipa *ipa, enum ipa_part_id mem_id)
 		ipa_setup_cmd_desc(desc++, IPA_CMD_HDR_LOCAL_INIT, &cmd_args, cmd++);
 
 		fallthrough;
+	case MEM_MDM_HDR_PCTX:	/* IPA v2.5: zeroed like the modem headers */
 	case MEM_MDM_COMP:
 	case MEM_MDM:
 	case MEM_DRV:
@@ -600,6 +611,11 @@ static int ipa_init_sram_part(struct ipa *ipa, enum ipa_part_id mem_id)
 
 	ret = ipa_submit_sync(ep, descs, desc - &descs[0]);
 
+	/* As the downstream IPA v2.5 driver: tell the IPA where the contexts are */
+	if (!ret && mem_id == MEM_MDM_HDR_PCTX)
+		iowrite32(part_offset,
+			  ipa->mmio + REG_IPA_LOCAL_PKT_PROC_CNTXT_BASE_OFST);
+
 free_pld:
 	ipa_dma_free(&pld);
 
@@ -1130,6 +1146,8 @@ static int ipa_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	ipa->version = (long)of_device_get_match_data(dev);
+	ipa->bam_remote = of_property_read_bool(dev->of_node,
+						"qcom,bam-remote-mode");
 	ipa->dev = dev;
 	ipa->ssr_nb.notifier_call = ipa_ssr_notifier;
 	ipa->test_mode = test_mode;
-- 
