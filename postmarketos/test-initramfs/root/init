#!/bin/busybox sh
# Minimal bring-up initramfs for the ZTE Axon 7 mainline kernel.
# Read-only with respect to the phone's storage: it never mounts or writes UFS/SD.
#
# Gives you, over the USB-C cable:
#   - USB network (NCM) 172.16.42.1, DHCP for the host, telnet on port 23
#   - a USB serial console (ACM, /dev/ttyACM0 on the host)

/bin/busybox --install -s /bin
# telnetd/udhcpd come from busybox-extras (musl-linked, /lib/ld-musl-aarch64.so.1)
ln -sf /bin/busybox-extras /bin/telnetd
ln -sf /bin/busybox-extras /bin/udhcpd
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config
mount -t tmpfs tmpfs /run
mkdir -p /sys/fs/pstore
mount -t pstore pstore /sys/fs/pstore 2>/dev/null

log() {
	echo "axon7-test: $*" > /dev/kmsg
	echo "axon7-test: $*" > /dev/tty0 2>/dev/null
}

log "initramfs started, kernel $(uname -r)"

setup_gadget() {
	G=/sys/kernel/config/usb_gadget/g1
	mkdir -p $G || return 1
	echo 0x18D1 > $G/idVendor
	echo 0xD001 > $G/idProduct
	mkdir -p $G/strings/0x409
	echo "ZTE" > $G/strings/0x409/manufacturer
	echo "Axon 7 mainline test" > $G/strings/0x409/product
	echo "axon7-test" > $G/strings/0x409/serialnumber

	mkdir -p $G/functions/ncm.usb0 $G/functions/acm.usb0
	mkdir -p $G/configs/c.1/strings/0x409
	echo "NCM + ACM" > $G/configs/c.1/strings/0x409/configuration
	echo 500 > $G/configs/c.1/MaxPower
	ln -s $G/functions/ncm.usb0 $G/configs/c.1/
	ln -s $G/functions/acm.usb0 $G/configs/c.1/

	# Wait for the dwc3 UDC to show up
	i=0
	while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $i -lt 30 ]; do
		sleep 1
		i=$((i + 1))
	done
	UDC=$(ls /sys/class/udc | head -n1)
	if [ -z "$UDC" ]; then
		log "no UDC found"
		return 1
	fi
	echo "$UDC" > $G/UDC
	log "gadget bound to $UDC"
}

setup_network() {
	IF=$(cat /sys/kernel/config/usb_gadget/g1/functions/ncm.usb0/ifname 2>/dev/null)
	[ -z "$IF" ] && IF=usb0
	ip link set lo up
	ip addr add 172.16.42.1/24 dev "$IF"
	ip link set "$IF" up
	cat > /run/udhcpd.conf <<-EOF
	start 172.16.42.2
	end 172.16.42.2
	interface $IF
	option subnet 255.255.255.0
	lease_file /run/udhcpd.leases
	EOF
	touch /run/udhcpd.leases
	udhcpd /run/udhcpd.conf
	telnetd -b 172.16.42.1:23 -l /bin/sh
	log "network up on $IF: telnet 172.16.42.1"
}

setup_gadget && setup_network

# Shell on the USB serial console
( while true; do
	if [ -c /dev/ttyGS0 ]; then
		setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'
	fi
	sleep 2
done ) &

log "ready. Useful: dmesg, cat /proc/partitions, ls /sys/fs/pstore"
cat /proc/partitions > /dev/tty0 2>/dev/null

# Keep PID 1 alive
while true; do
	sleep 3600
done
